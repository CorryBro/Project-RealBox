      punchWindW = pw * (1 - ex2);   /* v30.1: вес замаха (кулак к подбородку) — для IK-доводки */
      const WNDP = { x: .62, z: -.44, y: .42, f: 2.16 };   /* замах: кулак у подбородка, локоть вниз, скрутка внутрь */
      const EXTP = { x: 1.44, z: -.04, y: .06, f: .06 };   /* удар: рука прямая вперёд (доводит IK по лучу) */
      if (punchSide === 0) {
        Rx = Rx*(1-pw) + WNDP.x*pw;   Rz = Rz*(1-pw) + WNDP.z*pw;   ay = ay*(1-pw) + WNDP.y*pw;   Fx = Fx*(1-pw) + WNDP.f*pw;
        Rx = Rx*(1-ex2) + EXTP.x*ex2; Rz = Rz*(1-ex2) + EXTP.z*ex2; ay = ay*(1-ex2) + EXTP.y*ex2; Fx = Fx*(1-ex2) + EXTP.f*ex2;
        Rx = Rx*(1-ret) + (P.aRx + pf)*ret; Rz = Rz*(1-ret) + P.aRz*ret; ay = ay*(1-ret) + (P.aRy || 0)*ret; Fx = Fx*(1-ret) + P.fRx*ret;
      } else {
        Lx = Lx*(1-pw) + WNDP.x*pw;   Lz = Lz*(1-pw) - WNDP.z*pw;   ayl = ayl*(1-pw) - WNDP.y*pw;   Lf = Lf*(1-pw) + WNDP.f*pw;
        Lx = Lx*(1-ex2) + EXTP.x*ex2; Lz = Lz*(1-ex2) - EXTP.z*ex2; ayl = ayl*(1-ex2) - EXTP.y*ex2; Lf = Lf*(1-ex2) + EXTP.f*ex2;
        Lx = Lx*(1-ret) + (P.aLx + pf)*ret; Lz = Lz*(1-ret) + P.aLz*ret; ayl = ayl*(1-ret) + (P.aLy || 0)*ret; Lf = Lf*(1-ret) + P.fLx*ret;
      }
