      e.s.material.opacity = 1 - k;
      if (k >= 1) { scene.remove(e.s); e.s.material.dispose(); explFX.splice(i, 1); }
    } else if (e.k === 'light') {
      e.L.intensity = e.i0 * (1 - k) * (1 - k);
