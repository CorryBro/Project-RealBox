  for (const ch of chunks) {
    if (ch.far || !ch.hasVox) { ch.mesh.visible = false; continue; }
    const wx = (ch.cx*CSZ + CSZ/2)*S, wz = (ch.cz*CSZ + CSZ/2)*S;
    const dx = wx - _camPos.x, dz = wz - _camPos.z;
    ch.mesh.visible = dx*dx + dz*dz < r2;
  }
  const rr = viewRange + BREG*S;
  for (const b of buckets) {
    if (b.count === 0) { b.mesh.visible = false; continue; }
    const wx = (b.bx*BREG + BREG/2)*S, wz = (b.bz*BREG + BREG/2)*S;
    const dx = wx - _camPos.x, dz = wz - _camPos.z;
    b.mesh.visible = dx*dx + dz*dz < rr*rr;
