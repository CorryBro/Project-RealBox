function edTick(dt){
  if (!edActive || !edR) return;
  const cv = $('edCanvas');
  if (cv.clientWidth > 4 && Math.abs(cv.clientWidth - edR.domElement.width / (edR.getPixelRatio() || 1)) > 1) edResize();
  if (!edModel) return;
  if (!edDrag) edAz += dt * .3;                  /* ленивый поворот, пока не трогают */
  const h = charCfg.heightCm / 100;
  const d = .3 + h * 1.62;
  const cy = h * .5 + Math.sin(edElev) * d;
  const cr2 = Math.cos(edElev) * d;
  edCam.position.set(Math.sin(edAz) * cr2, cy, Math.cos(edAz) * cr2);
  edCam.lookAt(0, h * .5, 0);
  edR.render(edScene, edCam);
}

