let edActive = false, edR = null, edScene = null, edCam = null, edModel = null;
let edAz = Math.PI - .55, edElev = .24, edDrag = false, edLX = 0, edLY = 0;
let icR = null, icScene = null, icCam = null;

function editorInit(){
  if (edR) return;
  const cv = $('edCanvas');
  edR = new THREE.WebGLRenderer({ canvas: cv, antialias: true, alpha: true });
  edR.setPixelRatio(Math.min(devicePixelRatio || 1, 2));
  edR.shadowMap.enabled = true;
  edR.shadowMap.type = THREE.PCFSoftShadowMap;
  edR.setClearColor(0x000000, 0);
  edScene = new THREE.Scene();
  edCam = new THREE.PerspectiveCamera(36, 1, .05, 30);
  edScene.add(new THREE.HemisphereLight(0xeaf3ff, 0x3f4a36, 1.05));
  const dir = new THREE.DirectionalLight(0xfff1d8, 1.9);
  dir.position.set(2.2, 3.6, 1.7);
  dir.castShadow = true;
  dir.shadow.mapSize.set(512, 512);
  const sc = dir.shadow.camera;
  sc.left = -1.5; sc.right = 1.5; sc.top = 1.6; sc.bottom = -1.2; sc.near = .5; sc.far = 10;
  dir.shadow.bias = -0.002;
  edScene.add(dir);
  /* пьедестал: диск-подиум + мягкая тень вокруг */
  const ped = new THREE.Mesh(new THREE.CylinderGeometry(.62, .68, .06, 40),
    new THREE.MeshLambertMaterial({ color: 0x2c3a2c }));
  ped.position.y = -.03; ped.receiveShadow = true; edScene.add(ped);
  const shp = new THREE.Mesh(new THREE.CircleGeometry(1.7, 32), new THREE.ShadowMaterial({ opacity: .26 }));
  shp.rotation.x = -Math.PI/2; shp.receiveShadow = true; edScene.add(shp);
  /* тяни мышкой/пальцем — вращение персонажа */
  cv.addEventListener('pointerdown', e => {
    edDrag = true; edLX = e.clientX; edLY = e.clientY;
    try { cv.setPointerCapture(e.pointerId); } catch(err){}
    e.preventDefault();
  });
  cv.addEventListener('pointermove', e => {
    if (!edDrag) return;
    edAz -= (e.clientX - edLX) * .009;
    edElev = THREE.MathUtils.clamp(edElev + (e.clientY - edLY) * .005, .04, 1.05);
    edLX = e.clientX; edLY = e.clientY;
  });
  const edUp = () => { edDrag = false; };
  cv.addEventListener('pointerup', edUp);
  cv.addEventListener('pointercancel', edUp);
  /* офскрин-рендер иконок причёсок (те же модели, крупный план головы) */
  icR = new THREE.WebGLRenderer({ antialias: true, alpha: true, preserveDrawingBuffer: true });
  icR.setSize(96, 96);
  icR.setClearColor(0x141b28, 1);
  icScene = new THREE.Scene();
  icScene.add(new THREE.HemisphereLight(0xeaf3ff, 0x4a5340, 1.15));
  const idir = new THREE.DirectionalLight(0xfff1d8, 1.6);
  idir.position.set(1.1, 1.9, -1.6);
  icScene.add(idir);
  icCam = new THREE.PerspectiveCamera(34, 1, .05, 10);
  /* ресайз превью — подписываемся здесь, когда edR уже существует */
  window.addEventListener('resize', () => edResize());
}
function edResize(){
  if (!edR) return;
  const cv = $('edCanvas');
  const w = cv.clientWidth, h = cv.clientHeight;
  if (w < 4 || h < 4) return;
  edR.setSize(w, h, false);
  edCam.aspect = w / h;
  edCam.updateProjectionMatrix();
}
function renderHairIcons(){
  if (!icR) return;
  /* v29: иконки причёсок — ПОЛОЖЕННЫЕ (5 мужских / 6 женских), с текущим
     цветом волос (в т.ч. кастомным — иконки перерисовываются при смене цвета) */
  const f = charCfg.gender === 'f';
  const n = f ? 6 : 5;
  const imgs = document.querySelectorAll('#hairRow .hairBtn img');
  for (let s = 0; s < n; s++){
    const m = buildCharModel(f ? { gender: 'f', hairF: s, hair: s } : { gender: 'm', hair: s });
    icScene.add(m);
    const bs = m.userData.bodyScale || 1;
    const hy = 1.71 * bs;                       /* центр головы (как глаза NPC) */
    /* 3/4-ракурс (51° от анфаса): видны и чёлка/пробор спереди, и хвост сзади */
    icCam.position.set(Math.sin(.9)*.68, hy + .12, -Math.cos(.9)*.68);
    icCam.lookAt(0, hy - .02, 0);
    icR.render(icScene, icCam);
    if (imgs[s]) imgs[s].src = icR.domElement.toDataURL('image/png');
    icScene.remove(m);
    disposeModel(m);
  }
}
function edRebuild(withIcons){
