      ay = ay*(1-ws) + .10*ws;
      ay = ay*(1-cv); ay = ay*(1-ck); ay = ay*(1-ex); ay = ay*(1-ov);
      ay = ay*(1-st) + (P.aRy || 0)*st;
      /* v21.1 (vision-ревью «вялый бросок» → «со всей дури»): метатель ВСЕМ
         ТЕЛОМ — зарядка/взвод: скрутка НАЗАД (правое плечо назад, прогиб),
         левая рука ВПЕРЁД (указатель); хлыст: корпус БРОСАЕТСЯ вперёд на 24°
         (−.42), правое плечо ВЕДЁТ, левая — контрвзмах назад-вниз, ГЛУБОКИЙ
         ВЫПАД: переднее колено под весом (.72/−1.15 — таз САДИТСЯ через
         grenLungeW в rootDrop, ступни в земле), задняя далеко сзади прямой.
         Всё гасится через (1-st) на возврате.
         v22: у СИЛЬНОГО броска амплитуда корпуса/выпада РАСТЁТ (g2): скрутка
         назад до −0.56 рад, хлыст вперёд до −0.55, выпад глубже (.89/−1.39,
         задняя −.79), таз садится сильнее — «удар всем телом». */
      const tw = 1 - st;                            /* вес фазы броска (1 в пояс/взвод/хлыст, 0 после возврата) */
      const windW = Math.max(ck, cv*.85);           /* общий вес «замаха» (зарядка или досвод) */
      grenLungeW = ex * tw * (1 + .30*g2);          /* v21.1: таз садится в выпад (rootDrop ниже) — «вложился всем телом»; v22: у сильного глубже */
      ud.torso.rotation.x += (.18*windW - .42*ex) * tw + g2*(.17*windW - .13*ex) * tw;   /* взвод — прогиб НАЗАД (v23: у сильного до .35 — корпус реально отклонён, «замах от души»), хлыст — корпус ВПЕРЁД на 24–31° (минус = вперёд) */
      ud.torso.rotation.y += (-.38*windW + .38*ex) * tw + g2*(-.34*windW + .20*ex) * tw; /* плечи: назад в замахе → хлыст вперёд (v23: у сильного скрутка в замахе до 41° — «спиной к цели», декрут до 33° вперёд — раньше душилось стабилизацией плеч стрелка) */
      ud.legL.rotation.x  += (-.10*windW + .72*ex) * tw + g2*(.17*ex) * tw;  /* v21.1: ВЫПАД — передняя нога сильно вперёд под вес; v22: у сильного ещё +10° */
      ud.shinL.rotation.x += (-.08*windW - 1.15*ex) * tw + g2*(-.24*ex) * tw; /* передняя голень под углом — колено над стопой, классический выпад */
      ud.legR.rotation.x  += ( .08*windW - .60*ex) * tw + g2*(.14*windW - .19*ex) * tw;  /* задняя нога: v23 — в замахе отставлена дальше назад (вес на ней, корпус отклонён), в хлысте — далеко сзади прямая, упор и скольжение */
      ud.shinR.rotation.x += g2 * (-.34*windW*(1-ex)) * tw;   /* v23: колено задней ноги подгружено в ЗАМАХЕ (25°, «сел на опорную») и ВЫПРЯМЛЯЕТСЯ в хлысте — задняя нога в выпаде прямая, как планка (по замечанию vision-ревью) */
      /* левая — прицел/противовес метателя: в замахе вперёд-в сторону, в хлысте — контрвзмах назад-вниз (у сильного — шире, до −.95) */
      const lws = ws*.55, lcv = cv*.75, lex = ex*.75;
      Lx = Lx*(1-lws) + (-.20)*lws;   Lz = Lz*(1-lws) + (-.26)*lws;   Lf = Lf*(1-lws) + .48*lws;
      Lx = Lx*(1-lcv) + (.55 + .13*g2)*lcv;    Lz = Lz*(1-lcv) + (-.40)*lcv;   Lf = Lf*(1-lcv) + .45*lcv;
      Lx = Lx*(1-lex) + (-.78 - .17*g2)*lex;   Lz = Lz*(1-lex) + (-.45 - .10*g2)*lex;   Lf = Lf*(1-lex) + .35*lex;
    }
    /* ---- v30: КУЛАКИ — машина удара (заявка «новое оружие кулаки, прям
