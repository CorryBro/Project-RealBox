  /* моргание (как у NPC: 2.2–6.7с, иногда двойное) */
  if (pBlinkA < 0) { pBlinkT -= dt; if (pBlinkT <= 0) { pBlinkA = 0; pBlinkNext = Math.random() < .14 ? 1 : 0; } }
