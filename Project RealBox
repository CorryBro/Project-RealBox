  /* переноска трупа: гасим угловые скорости ВСЕХ частей каждый кадр — тело висит
     спокойным «мешком», конечности не трепещут (у трупа нет мышц, чтобы дёргаться) */
  if (held.kind === 'rag' && held.npc && held.npc.ragdollBodies) {
    const dampK = Math.max(0, 1 - 9*dt);
    for (const k in held.npc.ragdollBodies) {
      const pb = held.npc.ragdollBodies[k];
      if (!pb) continue;
      try {
        const av = pb.angvel();
        if (Number.isFinite(av.x) && Number.isFinite(av.y) && Number.isFinite(av.z) &&
            (Math.abs(av.x) > 1e-4 || Math.abs(av.y) > 1e-4 || Math.abs(av.z) > 1e-4)) {
          pb.setAngvel({ x: av.x*dampK, y: av.y*dampK, z: av.z*dampK }, true);
        }
      } catch(e){}
    }
    /* ДОВОДКА ВСЕГО ТЕЛА (только ГОРИЗОНТАЛЬНАЯ): каждое тело догоняет ТОЧКУ
       УДЕРЖАНИЯ по XZ. Почему все: скорость, заданная одному торсу, съедается
       суставами — они перераспределяют импульс на волочащиеся конечности, и
       тело ползло на 3/4 скорости игрока (замерено: 2.2 м/с при шаге 3 м/с),
       поводок рвался. Когда все части получают одну и ту же команду, они едут
       как единое целое — суставы не воюют, трение побеждено. В покое команда
       сама спадает в ноль (все под целью = тишина), вертикаль НЕ трогаем:
       тело висит/лежит как висит, под хватом. */
    for (const k in held.npc.ragdollBodies) {
      const pb = held.npc.ragdollBodies[k];
      if (!pb || pb === held.body) continue;
      try {
        const tt = pb.translation(), lv2 = pb.linvel();
        if (Number.isFinite(tt.x) && Number.isFinite(lv2.x) && Number.isFinite(lv2.z)) {
          let dvx2 = (_gtgt.x - tt.x) * 8, dvz2 = (_gtgt.z - tt.z) * 8;
          const sp2 = Math.hypot(dvx2, dvz2);
          if (sp2 > 6.5) { const kk = 6.5/sp2; dvx2 *= kk; dvz2 *= kk; }
          const kb = Math.min(1, 14*dt);
          pb.setLinvel({ x: lv2.x + (dvx2 - lv2.x)*kb, y: lv2.y, z: lv2.z + (dvz2 - lv2.z)*kb }, true);
        }
      } catch(e){}
    }
    /* АНТИГРАВИТАЦИЯ — ровно ×1 (компенсация СОБСТВЕННОГО веса взятой части и
       торса): поводку легче держать точку, тело висит на суставах естественно.
       Конечности остаются при НОРМАЛЬНОЙ гравитации — тянут вниз, рука/нога
       вытягивается, тело висит ПОД хватом (лёгкий провис = «нести за кисть
       тяжелее торса», как просили; раньше ×2 форсаж поднимал тело перед камерой) */
    const antiG = [held.body];
    const torsoB = held.npc.ragdollBodies.torso;
    if (torsoB && held.body !== torsoB) antiG.push(torsoB);
    /* за ТОРС — ×2 как всегда (проверено годами: без второй g вес висящих
       конечностей прижимает торс к земле, трение съедает поводок и он рвётся);
       за КОНЕЧНОСТЬ/ГОЛОВУ — ровно ×1 (тело висит и слегка провисает — «нести
       тяжелее», как просили) */
    const gMul = (held.part === 'torso') ? (1 + ramp) : ramp;
    for (const pb of antiG) {
      if (!pb) continue;
      try {
        const lv3 = pb.linvel();
        if (Number.isFinite(lv3.x) && Number.isFinite(lv3.y) && Number.isFinite(lv3.z)) {
          pb.setLinvel({ x: lv3.x, y: lv3.y + gMul * 9.81 * dt, z: lv3.z }, false);
        }
      } catch(e){}
    }
    /* ПОЛУ-ПОДЪЁМ КОНЕЧНОСТЕЙ (×0.5): трение рук/ног о землю съедало скорость
       перетаскивания — тело ползло на 3/4 скорости игрока и поводок рвался
       (замерено). Половинная компенсация: конечности по-прежнему ВИСЯТ и
       волочатся (не невесомость!), но трение вдвое меньше — тело успевает за
       игроком. Полная компенсация отвергнута ранее: труп превращался в клубок. */
    for (const k in held.npc.ragdollBodies) {
      const pb = held.npc.ragdollBodies[k];
      if (!pb || pb === held.body || pb === torsoB) continue;
      try {
        const lv4 = pb.linvel();
        if (Number.isFinite(lv4.x) && Number.isFinite(lv4.y) && Number.isFinite(lv4.z)) {
          pb.setLinvel({ x: lv4.x, y: lv4.y + .5 * ramp * 9.81 * dt, z: lv4.z }, false);
        }
      } catch(e){}
    }
  }
}
