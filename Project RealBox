/* вычистить динамические объекты старого мира (кластеры, трупы, гранаты…) */
function newVillageCleanup(){
  /* очистить кластеры, debris, фонари, гранаты, трассеры */
  for (const d of [...debris]) killDebris(d);
  for (const c of [...clusters]) killCluster(c);
  for (const L of LAMP_LIGHTS) scene.remove(L.L);
  LAMP_LIGHTS.length = 0; LAMP_POSTS.length = 0;
  for (const g of grenades) { scene.remove(g.mesh); g.mesh.material.dispose(); }
  grenades.length = 0;
  explClear();   /* дым/вспышки/кольца/свет взрывов старого мира */
  tracers.length = 0;
  /* очистить ragdoll-остатки NPC (БАГФИКС УТЕЧКИ: newVillageCleanup очищал npcs
     ДО spawnAllNpcs — его cleanup-цикл disposal больше никого не видел, и ~6
     слитых геометрий на жителя утекали в GPU при каждом цикле меню→игра.
     Теперь dispose прямо здесь) */
  for (const n of [...npcs]) {
    if (n.body) { try { world.removeRigidBody(n.body); } catch(e){} }
    if (n.ragdoll) npcRemoveRagdoll(n);
    scene.remove(n.root);
    n.root.traverse(o => { if (o.isMesh && o.geometry) { try { o.geometry.dispose(); } catch(e){} } });
  }
  npcs.length = 0;
  /* сброс рендера мира в дальний режим (инстансы/детали будут пересобраны) */
  resetWorldRender();
}
function pauseGame(){
  if (state !== 'playing') return;
