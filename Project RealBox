/* ---------- настройки ---------- */
const QUALITY = {
  low:  { dpr: 1,   shadows: false, shadowSize: 512,  debris: 80,  part: .55, farView: .65 },
  med:  { dpr: 1.5, shadows: true,  shadowSize: 1024, debris: 140, part: .8,  farView: .85 },
