    const t = grid[vIdx(x,y,z)]; if (!t) continue;
    if (GLOW[t]) continue;   /* лампы — в глобальном glow-инстансемеше */
    /* затенение как раньше: плотность соседей + джиттер цвета вокселя */
    const nb = (getVox(x+1,y,z)?1:0)+(getVox(x-1,y,z)?1:0)+(getVox(x,y+1,z)?1:0)+(getVox(x,y-1,z)?1:0)+(getVox(x,y,z+1)?1:0)+(getVox(x,y,z-1)?1:0);
