  ud.neckBend.rotation.y = THREE.MathUtils.clamp(dyw - twistSm, -HEAD_MAX, HEAD_MAX) * .35;   /* v17: шея тоже подкручивается за головой — стык без «приклеенной» головы при экстремальном повороте */
