  /* ---- позиция модели: v20 — высота корня по ФАКТИЧЕСКИМ углам ног (присед/
     приземление): опора = более прямая нога, корень опускается ровно на
     укорочение цепочки — ступни стоят на земле, таз не «висит». Обычная
     ходьба (cr=0,land=0) — формула обнуляется, живёт прежний bob. ---- */
  const bobY = (Math.abs(Math.cos(ph)) - .55) * (.05 + .06*runF) * amp;
  /* v21.4 (vision-ревью «при присед-ходьбе таз ВЫПРЯМЛЯЕТСЯ»): высота таза
     в приседе ФИКСИРУЕТСЯ на высоте статичной стаггер-стойки — маховая
     нога, выпрямляясь в переносе, больше НЕ поднимает таз (в хороших
     шутерах тактическая ходьба держит центр тяжести на одном уровне,
     «шаркающий» шаг). Вне приседа (cr=0) — прежний расчёт по фактическим
     углам (приземление/выпад живут как были). */
  const crDrop = .92 - .46*(Math.cos(.92) + Math.cos(.92 - 1.44));   /* стаггер-стойка: переднее бедро .92, голень -1.44 → опорная цепочка .678 → дроп .242 */
  const eL = ud.legL.rotation.x, eR = ud.legR.rotation.x;
  const extL = .46*(Math.cos(eL) + Math.cos(eL + ud.shinL.rotation.x));
  const extR = .46*(Math.cos(eR) + Math.cos(eR + ud.shinR.rotation.x));
  let rootDrop = Math.max(0, Math.min(.45, .92 - Math.max(extL, extR)) * Math.min(1, cr + .9*land + .85*grenLungeW));
  if (cr > 0) rootDrop = Math.max(rootDrop, Math.min(.45, crDrop) * cr);   /* таз не поднимается выше статичного приседа */
  rootDrop *= (bodyRoot.userData.bodyScale || 1);   /* v21.1: +grenLungeW — таз САДИТСЯ в выпад броска (ступни в земле, вес вложен) */
  bodyRoot.position.set(player.pos.x, player.pos.y + bobY*(1 - .85*cr) - rootDrop, player.pos.z);
  bodyRoot.rotation.y = (bodyYaw === null) ? player.yaw : bodyYaw;   /* v17: ленивый доворот тела (turnUpdate) */
  /* v27: прежняя доводка рысканья wpYawFix УДАЛЕНА — ствол/прицел жёстко
     ставятся камерой в weaponLockUpdate (вызывается в цикле ПОСЛЕ
     composeCamera, матрица камеры свежая). */
  /* v26: clipping-плоскость «шеи» едет за головой (боб/присед/прыжок) —
     голова игрока отсечена от основного рендера, тень остаётся полной */
  if (ud.headG) {
    ud.headG.getWorldPosition(_hcW);
    headClipPlane.normal.set(0, -1, 0);
    headClipPlane.constant = _hcW.y - .16 * (ud.bodyScale || 1);   /* ниже нижней точки черепа+причёски, в районе шеи */
  }
  /* ---- v27: МИР-трансформы оружия (оно в СЦЕНЕ, вне масштаба тела).
     Граната — полностью от кисти (замах/бросок машиной рук);
     Глок/M4 — база «в кисти» (её заменит/доведёт weaponLockUpdate). ---- */
  if (handAnchor) {
    bodyRoot.updateMatrixWorld(true);
    handAnchor.getWorldPosition(_wHP);
    handAnchor.getWorldQuaternion(_wHQ);
    if (cur === 1) _wOff.set(0, .012, -.014);        /* v28.1: граната В КУЛАКЕ — шар утоплен в ладонь по экватор, чуть к пальцам: верх шара торчит над кулаком (было: парила НАД кулаком) */
    else if (cur === 0) _wOff.set(0, .012, -.015);    /* глок в кисти */
    else _wOff.set(0, .012, -.01);                    /* M4 в кисти */
    _wP.copy(_wOff).applyQuaternion(_wHQ).add(_wHP);
    _wQ.setFromEuler(_wpBaseE);
    _wQ.premultiply(_wHQ);
    if (cur === 1) { tpGren.position.copy(_wP); tpGren.quaternion.copy(_wQ); }
    else { _wpBaseP.copy(_wP); _wpBaseQ.copy(_wQ); }
  }
}
