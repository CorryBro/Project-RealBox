<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#1d3a2e">
<title>Project RealBox — жизнь (v29: женщины, панель разработчика, кастомные цвета)</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/russo-one@5.0.20/index.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/rubik@5.0.20/index.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/rubik@5.0.20/700.css">
<script src="https://cdn.jsdelivr.net/npm/eruda@3.4.3/eruda.min.js"></script>
<style>
:root{--acc:#7fb069;--bg:#9bc7e8;--panel:rgba(20,28,22,.92);--line:rgba(255,255,255,.12);--warm:#e6c98a}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;overscroll-behavior:none}
body{background:var(--bg);font-family:'Rubik',system-ui,sans-serif;color:#e8ecf4;user-select:none;-webkit-user-select:none;touch-action:none}
canvas#game{position:fixed;inset:0;width:100%;height:100%;display:block;z-index:0}
.screen{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;z-index:30;
  opacity:0;pointer-events:none;transition:opacity .35s ease;
  background:radial-gradient(ellipse at 50% 40%,rgba(15,30,22,.45),rgba(8,16,12,.88) 75%)}
body[data-state="menu"] #menuScreen{opacity:1;pointer-events:auto}
body[data-state="paused"] #pauseScreen{opacity:1;pointer-events:auto}
.screen.open{opacity:1;pointer-events:auto}
.panelBox{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:24px 28px;
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);box-shadow:0 24px 60px rgba(0,0,0,.55);
  width:min(460px,92vw);max-height:86vh;overflow-y:auto}
h1.title{font-family:'Russo One',sans-serif;font-size:clamp(28px,6.5vw,52px);letter-spacing:2px;line-height:1.02;
  background:linear-gradient(180deg,#e8f5d8,#a8d573 55%,#5e8a3b);-webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 4px 0 rgba(0,0,0,.55)) drop-shadow(0 0 26px rgba(140,180,90,.28));text-align:center}
.subtitle{font-size:clamp(10px,2.5vw,13px);color:#a8c0b0;letter-spacing:4px;text-transform:uppercase;text-align:center;margin:8px 0 22px}
.cubesRow{display:flex;gap:10px;justify-content:center;margin-bottom:16px}
.cube{width:15px;height:15px;border-radius:3px;animation:bob 2.4s ease-in-out infinite}
.cube:nth-child(1){background:#7fb069}.cube:nth-child(2){background:#c08a4a;animation-delay:.3s}
.cube:nth-child(3){background:#8b6f47;animation-delay:.6s}.cube:nth-child(4){background:#d8c79c;animation-delay:.9s}
.cube:nth-child(5){background:#3a5a40;animation-delay:1.2s}
@keyframes bob{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-9px) rotate(12deg)}}
.btn{display:block;width:100%;padding:14px 18px;margin:9px 0;border-radius:12px;border:1px solid var(--line);
  background:linear-gradient(180deg,#1d2b22,#131a14);color:#e8ecf4;font-family:'Russo One',sans-serif;font-size:16px;
  letter-spacing:1.5px;cursor:pointer;transition:transform .12s,box-shadow .12s;text-align:center}
.btn:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(0,0,0,.45)}
.btn:active{transform:translateY(1px)}
.btn.primary{background:linear-gradient(180deg,#a8d573,#5e8a3b);border-color:rgba(255,255,255,.25);color:#1a2b14;
  box-shadow:0 6px 22px rgba(120,170,80,.35)}
.btn.small{padding:10px;font-size:13px}
h2.ptitle{font-family:'Russo One',sans-serif;font-size:22px;letter-spacing:2px;margin-bottom:16px;color:#c4e0a0;text-align:center}
.tabs{display:flex;gap:5px;margin-bottom:18px}
.tabs .tab{flex:1;padding:9px 0;border-radius:10px;border:1px solid var(--line);background:#141b28;color:#9fb0c8;
  font-family:'Russo One';font-size:10px;letter-spacing:.6px;cursor:pointer;transition:.15s}
.tabs .tab.on{background:linear-gradient(180deg,#a8d573,#5e8a3b);color:#1a2b14;border-color:transparent;
  box-shadow:0 4px 14px rgba(120,170,80,.3)}
.tabBody{animation:tabIn .2s ease}
@keyframes tabIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.secTitle{font-family:'Russo One';font-size:11px;color:#a8d573;letter-spacing:2px;margin:18px 0 4px}
.secTitle:first-child{margin-top:0}
.setRow{margin:13px 0}
.setLabel{display:flex;justify-content:space-between;font-size:13px;color:#aebbd2;margin-bottom:6px}
.setLabel b{color:#c4e0a0;font-weight:700}
input[type=range]{width:100%;height:24px;appearance:none;-webkit-appearance:none;background:transparent;cursor:pointer}
input[type=range]::-webkit-slider-runnable-track{height:5px;border-radius:3px;background:rgba(255,255,255,.14)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;margin-top:-7.5px;border-radius:5px;
  background:linear-gradient(180deg,#a8d573,#5e8a3b);box-shadow:0 2px 8px rgba(120,170,80,.5);border:1px solid rgba(0,0,0,.4)}
input[type=range]::-moz-range-track{height:5px;border-radius:3px;background:rgba(255,255,255,.14)}
input[type=range]::-moz-range-thumb{width:20px;height:20px;border-radius:5px;background:#7fb069;border:1px solid rgba(0,0,0,.4)}
.seg{display:flex;gap:6px}
.seg button{flex:1;padding:9px 0;border-radius:9px;border:1px solid var(--line);background:#141b28;color:#9fb0c8;
  font-family:'Rubik';font-weight:700;font-size:13px;cursor:pointer;transition:.15s}
.seg button.on{background:linear-gradient(180deg,#a8d573,#5e8a3b);color:#1a2b14;border-color:transparent}
.tglRow{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.05);font-size:14px}
.tgl{position:relative;width:46px;height:24px;cursor:pointer;flex:none}
.tgl input{display:none}
.tgl .tr{position:absolute;inset:0;border-radius:7px;background:#1a2230;border:1px solid var(--line);transition:.2s}
/* v26: квадратик ровно ПО ЦЕНТРУ полоски: трек 46×24 с рамкой 1px → внутренняя
   область 44×22, квадрат 18×18 → зазоры ровно по 2px со всех сторон в обоих
   положениях (было top/left 3px и checked left 25px — смещение на 2px). */
.tgl .kn{position:absolute;top:2px;left:2px;width:18px;height:18px;border-radius:5px;background:#5a677d;transition:.2s}
.tgl input:checked + .tr{background:rgba(127,176,105,.28);border-color:rgba(140,180,90,.6)}
.tgl input:checked + .tr .kn{left:24px;background:linear-gradient(180deg,#a8d573,#5e8a3b)}
.helpList{font-size:13.5px;line-height:1.85;color:#c4cfdf}
.helpList b{color:#c4e0a0}
.helpList h3{font-family:'Russo One';font-size:14px;color:#7fb069;margin:12px 0 4px;letter-spacing:1px}
#hud{position:fixed;inset:0;z-index:12;pointer-events:none;opacity:0;transition:opacity .3s}
body[data-state="playing"] #hud{opacity:1}
#topBar{position:absolute;top:calc(8px + env(safe-area-inset-top));left:10px;right:10px;display:flex;justify-content:space-between;align-items:flex-start;gap:8px;pointer-events:none}
#topBar > *{pointer-events:auto}
#stats{font-size:11px;color:#2a3a22;background:rgba(220,235,200,.78);padding:7px 11px;border-radius:10px;
  border:1px solid rgba(80,110,60,.4);line-height:1.55;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
  box-shadow:0 2px 8px rgba(0,0,0,.18);white-space:nowrap}
#stats b{color:#3a5a25;font-weight:700}
#topRight{display:flex;align-items:center;gap:6px}
#clock{font-family:'Russo One';font-size:13px;color:#2a3a22;background:rgba(220,235,200,.78);padding:7px 11px;border-radius:10px;
  border:1px solid rgba(80,110,60,.4);letter-spacing:1px;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
  box-shadow:0 2px 8px rgba(0,0,0,.18);white-space:nowrap}
#pauseBtn{width:36px;height:36px;border-radius:10px;background:rgba(220,235,200,.78);border:1px solid var(--line);
  color:#3a5a25;font-size:14px;cursor:pointer;display:flex;align-items:center;justify-content:center;
  backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);box-shadow:0 2px 8px rgba(0,0,0,.18)}
#pauseBtn:active{transform:scale(.95)}
#hint{position:absolute;left:50%;bottom:calc(24% + env(safe-area-inset-bottom));transform:translateX(-50%);
  font-size:12.5px;color:#1a2b14;background:rgba(220,235,200,.92);padding:8px 14px;border-radius:10px;
  border:1px solid rgba(80,110,60,.4);opacity:0;transition:opacity .2s;text-align:center;letter-spacing:.5px;
  pointer-events:none;max-width:90vw;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#hint.show{opacity:1}
#toast{position:absolute;left:50%;top:calc(20% + env(safe-area-inset-top));transform:translateX(-50%);
  background:rgba(20,30,22,.88);color:#c4e0a0;padding:9px 18px;border-radius:8px;border:1px solid var(--line);
  font-family:'Russo One';font-size:12.5px;letter-spacing:1px;opacity:0;transition:opacity .25s;pointer-events:none;
  max-width:90vw;text-align:center}
#toast.show{opacity:1}
#cross{position:absolute;left:50%;top:50%;width:0;height:0;transform:translate(-50%,-50%);pointer-events:none;transition:opacity .12s}
#cross.hide{opacity:0}
#cross i{position:absolute;background:rgba(255,255,255,.85);box-shadow:0 0 3px rgba(0,0,0,.85);border-radius:1px}
#cross i:nth-child(1){width:5px;height:5px;left:-2.5px;top:-2.5px;border-radius:50%}
#cross i:nth-child(2){width:2px;height:11px;left:-1px;top:-15px}
#cross i:nth-child(3){width:2px;height:11px;left:-1px;top:5px}
#cross i:nth-child(4){width:11px;height:2px;left:-15px;top:-1px}
#cross i:nth-child(5){width:11px;height:2px;left:5px;top:-1px}
#cross.kick i{transform:scale(1.5);opacity:.5}
/* хотбар со оружием — внизу по центру */
#weapons{position:absolute;bottom:calc(8px + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);
  display:flex;gap:6px;pointer-events:auto;z-index:14}
.wcard{width:62px;padding:5px 4px 4px;border-radius:11px;background:rgba(20,30,22,.72);border:1px solid var(--line);
  text-align:center;cursor:pointer;transition:transform .12s,border-color .12s,background .12s;backdrop-filter:blur(6px);
  -webkit-backdrop-filter:blur(6px);box-shadow:0 2px 8px rgba(0,0,0,.32)}
.wcard .em{font-size:20px;line-height:1.1;filter:drop-shadow(0 1px 2px rgba(0,0,0,.6))}
.wcard .nm{font-size:7.5px;letter-spacing:.4px;color:#a8c0b0;text-transform:uppercase;margin-top:1px;font-family:'Russo One'}
.wcard .am{font-family:'Russo One';font-size:12px;color:#eaf2dd;margin-top:1px;white-space:nowrap}
.wcard.on{border-color:var(--acc);background:rgba(127,176,105,.22);transform:translateY(-4px);box-shadow:0 6px 16px rgba(120,170,80,.3)}
.wcard.on .am{color:#c4e0a0}
.wcard.low .am{color:#ff5e3c}
.wcard.low{border-color:rgba(255,94,60,.5)}
#ammo{position:absolute;left:50%;bottom:calc(72px + env(safe-area-inset-bottom));transform:translateX(-50%);
  font-family:'Russo One';font-size:14px;color:#c4e0a0;background:rgba(20,30,22,.7);padding:4px 12px;border-radius:8px;
  border:1px solid var(--line);letter-spacing:1px;opacity:0;transition:opacity .2s;pointer-events:none;
  backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
#ammo.show{opacity:1}
#touchLayer{position:fixed;inset:0;z-index:11;pointer-events:none;display:none;touch-action:none}
body.touch[data-state="playing"] #touchLayer{display:block;pointer-events:auto}
#joyBase{position:absolute;width:140px;height:140px;border-radius:50%;
  background:radial-gradient(circle at 50% 50%,rgba(255,255,255,.08),rgba(0,0,0,.32) 70%,rgba(0,0,0,.45));
  border:2px solid rgba(255,255,255,.28);transform:translate(-50%,-50%);transition:opacity .18s;opacity:0;display:none;
  box-shadow:0 6px 24px rgba(0,0,0,.45),inset 0 2px 8px rgba(255,255,255,.12)}
#joyBase.show{opacity:1}
#joyBase::before{content:'';position:absolute;inset:14px;border-radius:50%;border:1px dashed rgba(255,255,255,.22)}
#joyKnob{position:absolute;left:50%;top:50%;width:58px;height:58px;border-radius:50%;
  background:radial-gradient(circle at 32% 28%,#f4ffe0,#a8d573 45%,#5e8a3b 85%);
  border:2px solid rgba(255,255,255,.6);transform:translate(-50%,-50%);
  box-shadow:0 4px 14px rgba(0,0,0,.5),inset 0 2px 4px rgba(255,255,255,.4)}
#joyKnob::after{content:'';position:absolute;inset:8px;border-radius:50%;
  background:radial-gradient(circle at 38% 32%,rgba(255,255,255,.55),transparent 60%)}
.actionBtn{position:absolute;width:68px;height:68px;border-radius:50%;border:2px solid rgba(255,255,255,.45);
  color:#fff;font-family:'Russo One';pointer-events:auto;cursor:pointer;display:flex;align-items:center;justify-content:center;
  backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);transition:transform .08s,filter .12s}
.actionBtn:active{transform:scale(.93);filter:brightness(1.18)}
#grabBtn{right:calc(20px + env(safe-area-inset-right));bottom:calc(118px + env(safe-area-inset-bottom));
  background:radial-gradient(circle at 32% 28%,rgba(180,230,140,.95),rgba(95,140,60,.92) 80%);font-size:26px;
  box-shadow:0 4px 16px rgba(80,140,40,.45)}
#grabBtn.hold{background:radial-gradient(circle at 32% 28%,rgba(255,170,120,.95),rgba(180,80,30,.92) 80%)}
#grabBtn.hidden{display:none}
#jumpBtn{right:calc(100px + env(safe-area-inset-right));bottom:calc(28px + env(safe-area-inset-bottom));
  background:radial-gradient(circle at 32% 28%,rgba(180,220,150,.95),rgba(60,100,40,.92) 80%);font-size:24px;
  box-shadow:0 4px 16px rgba(60,100,40,.45)}
#crouchBtn{right:calc(20px + env(safe-area-inset-right));bottom:calc(28px + env(safe-area-inset-bottom));
  background:radial-gradient(circle at 32% 28%,rgba(160,150,110,.95),rgba(50,70,30,.92) 80%);font-size:22px;
  box-shadow:0 4px 16px rgba(50,70,30,.45)}
#crouchBtn.on{background:radial-gradient(circle at 32% 28%,rgba(255,200,140,.95),rgba(160,90,30,.92) 80%)}
#fireBtn{right:calc(100px + env(safe-area-inset-right));bottom:calc(118px + env(safe-area-inset-bottom));
  width:78px;height:78px;font-size:30px;
  background:radial-gradient(circle at 32% 28%,rgba(255,140,80,.95),rgba(190,40,15,.92) 80%);
  border-color:rgba(255,200,140,.65);box-shadow:0 4px 18px rgba(220,80,30,.55),0 0 22px rgba(255,120,40,.25);
  transition:transform .05s,filter .1s,box-shadow .1s}
#fireBtn:active{transform:scale(.93);filter:brightness(1.25);box-shadow:0 2px 10px rgba(220,80,30,.6)}
#fireBtn.held{filter:brightness(1.2);box-shadow:0 0 26px rgba(255,140,60,.55),0 0 40px rgba(255,90,30,.3)}
/* v22: кнопка ПРИЦЕЛИВАНИЕ — слева-сверху от огня, удержание = прицел */
#aimBtn{right:calc(196px + env(safe-area-inset-right));bottom:calc(132px + env(safe-area-inset-bottom));
  width:58px;height:58px;font-size:24px;
  background:radial-gradient(circle at 32% 28%,rgba(150,200,235,.95),rgba(45,80,120,.92) 80%);
  border-color:rgba(190,220,250,.55);box-shadow:0 4px 16px rgba(50,90,140,.45)}
#aimBtn.held{filter:brightness(1.25)}
#aimBtn.on{background:radial-gradient(circle at 32% 28%,rgba(200,235,255,.97),rgba(70,130,190,.95) 80%);
  box-shadow:0 0 22px rgba(140,200,255,.5),0 4px 16px rgba(50,90,140,.5)}
#loadBar{width:min(280px,80vw);height:4px;background:rgba(255,255,255,.15);border-radius:3px;margin:18px auto 14px;overflow:hidden}
#loadBar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#a8d573,#5e8a3b);border-radius:3px;transition:width .3s}
#loading{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;flex-direction:column;
  background:radial-gradient(ellipse at 50% 40%,rgba(15,30,22,.45),rgba(8,16,12,.88) 75%);
  opacity:1;transition:opacity .35s ease}
#loading.hidden{opacity:0;pointer-events:none}
#errBox{position:fixed;inset:0;z-index:60;display:none;align-items:center;justify-content:center;flex-direction:column;
  background:rgba(8,12,10,.92);padding:24px;text-align:center;color:#e8ecf4;font-family:'Rubik',sans-serif}
#errBox.show{display:flex}
#errBox h2{font-family:'Russo One',sans-serif;color:#ff8a6a;font-size:24px;margin-bottom:12px;letter-spacing:1.5px}
#errBox p{font-size:13px;color:#aebbd2;max-width:520px;line-height:1.6;margin-bottom:14px}
#errBox pre{font-family:monospace;background:rgba(0,0,0,.4);padding:10px 14px;border-radius:8px;color:#ffb38a;
  font-size:11px;max-width:560px;overflow-x:auto;white-space:pre-wrap;max-height:200px;overflow-y:auto}
#errBox button{margin-top:14px;padding:10px 22px;border-radius:10px;border:1px solid rgba(255,255,255,.2);
  background:linear-gradient(180deg,#a8d573,#5e8a3b);color:#1a2b14;font-family:'Russo One';cursor:pointer;letter-spacing:1px}

/* ============ РЕДАКТОР ПЕРСОНАЖА (v15) ============ */
.edWrap{display:flex;background:var(--panel);border:1px solid var(--line);border-radius:18px;
  width:min(880px,94vw);max-height:90vh;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.55);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
.edLeft{flex:1.15;position:relative;min-width:0;overflow:hidden;
  background:radial-gradient(ellipse at 50% 26%,rgba(127,176,105,.13),rgba(10,16,12,0) 62%),
             linear-gradient(180deg,#1b2620 0%,#12180f 100%)}
#edCanvas{position:absolute;inset:0;width:100%;height:100%;touch-action:none;cursor:grab;display:block}
#edCanvas:active{cursor:grabbing}
.edFloorHint{position:absolute;bottom:9px;left:0;right:0;text-align:center;font-size:9.5px;color:#7e937a;
  letter-spacing:2px;pointer-events:none;text-transform:uppercase;font-family:'Russo One'}
.edRight{flex:1;min-width:300px;max-width:365px;padding:20px 24px 18px;overflow-y:auto;border-left:1px solid var(--line)}
#edName{width:100%;padding:11px 14px;border-radius:10px;border:1px solid var(--line);background:#141b28;color:#e8ecf4;
  font-family:'Rubik',sans-serif;font-size:15px;outline:none;transition:border-color .15s,box-shadow .15s;margin-top:4px}
#edName:focus{border-color:var(--acc);box-shadow:0 0 0 3px rgba(127,176,105,.15)}
#edName::placeholder{color:#5a6a5e}
.hairRow{display:flex;gap:6px;margin-top:5px}
.hairBtn{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 2px 5px;border-radius:11px;
  border:1px solid var(--line);background:#141b28;cursor:pointer;transition:transform .12s,border-color .12s,background .12s}
.hairBtn:hover{transform:translateY(-2px)}
.hairBtn img{width:42px;height:42px;display:block}
.hairBtn span{font-size:8px;color:#9fb0c8;letter-spacing:.4px;font-family:'Russo One';text-transform:uppercase}
.hairBtn.on{background:linear-gradient(180deg,rgba(168,213,115,.26),rgba(94,138,59,.16));border-color:var(--acc);
  box-shadow:0 4px 14px rgba(120,170,80,.3)}
.hairBtn.on span{color:#c4e0a0}
.colRow{display:flex;gap:9px;margin-top:6px}
.colBtn{flex:1;height:38px;border-radius:11px;border:2px solid rgba(255,255,255,.14);cursor:pointer;position:relative;
  transition:transform .12s,border-color .12s;box-shadow:inset 0 3px 8px rgba(0,0,0,.55),inset 0 -2px 4px rgba(255,255,255,.08)}
.colBtn:hover{transform:translateY(-2px)}
.colBtn.on{border-color:#c4e0a0;transform:translateY(-2px);box-shadow:0 6px 16px rgba(0,0,0,.45),inset 0 3px 8px rgba(0,0,0,.55)}
.colBtn.on::after{content:'';position:absolute;top:4px;right:4px;width:9px;height:9px;border-radius:3px;
  background:linear-gradient(180deg,#a8d573,#5e8a3b);box-shadow:0 1px 4px rgba(0,0,0,.5)}
.edSizeNote{font-size:10.5px;color:#7e937a;margin:2px 0 0;letter-spacing:.4px}
/* v29: кастомный свотч-палитра 🎨 в редакторе + дев-панель */
.customBtn{overflow:hidden}
.customBtn input[type=color]{position:absolute;inset:0;opacity:0;cursor:pointer;border:none;padding:0}
.customBtn .cArt{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
