      ud.armL.rotation.z = ud.armL.rotation.z*(1-lb) + Lz*lb;
      ud.forearmL.rotation.x = ud.forearmL.rotation.x*(1-lb) + Lf*lb;
      /* v27: ладонь левой — на оружии через IK (weaponLockUpdate дотягивает
         обе руки до хвата); здесь только ADS-подкрутка позы.
         v30: aLy — зеркальная скрутка плеча для кулаков (гард к лицу) */
      ud.armL.rotation.y = ((AP && (cur === 0 || cur === 2)) ? AP.aLy*adsW : ayl*lb);
    }
    /* ---- v30.1: IK-ДОТЯЖКА КИСТЕЙ К ТОЧНЫМ ЦЕЛЯМ (кувалды/граната) ----
       Глаз игрока высоко (1.93м), а руки короткие: чисто позовые цели
       оставляли кулаки на 45° ниже горизонта — ВНЕ кадра. Теперь кисти
       доводятся ikArm-ом до ТОЧНЫХ целей в пространстве ТОРСА (как хваты
       оружия в adsArmsIK): ГАРД — кулаки у лица (в кадре, боксёрская
       стойка), ЗАМАХ — кулак к подбородку, ГРАНАТА В ПОКОЕ — кисть у
       верхней груди (граната видна, локоть ПЕРЕД корпусом). В ударе
       кисть уводится на ЛУЧ КАМЕРЫ (punchIK после composeCamera — он
       выполняется ПОЗЖИ и побеждает). Досягаемость зажата сферой руки
       (REACH) — рука не ломается никогда; вес = бленд позы — переходы
       плавные. ---- */
    if (cur === 3) {
      const sw = punchExW, wwind = punchWindW*b;
      _gT.set(.13, .60, -.44);                                          /* правый кулак: гард у подбородка (не у глаз — локти видны, поза боксёрская) */
      if (punchSide === 0) {
        ikArm(ud.armR, ud.forearmR, _gT, b*(1-sw));
        if (wwind > .01) { _gT.set(.22, .70, -.32); ikArm(ud.armR, ud.forearmR, _gT, wwind); }   /* замах: к подбородку */
      } else ikArm(ud.armR, ud.forearmR, _gT, b);
      _gT.set(-.13, .60, -.44);                                         /* левый кулак: гард у подбородка */
      if (punchSide === 1) {
        ikArm(ud.armL, ud.forearmL, _gT, b*(1-sw));
        if (wwind > .01) { _gT.set(-.22, .70, -.32); ikArm(ud.armL, ud.forearmL, _gT, wwind); }
      } else ikArm(ud.armL, ud.forearmL, _gT, b);
    } else if (cur === 1) {
      /* граната в ПОКОЕ — кисть у верхней груди (в кадре); в броске/замахе
         ИК гаснет (grenActW) — работает машина формул */
      const gIK = b * (1 - grenActW);
      if (gIK > .02) { _gT.set(.17, .55, -.48); ikArm(ud.armR, ud.forearmR, _gT, gIK); }   /* кисть у верхней груди, ВЫНЕСЕНА вперёд: сбоку читается «у груди», от первого лица граната В КАДРЕ уже при прямом взгляде (30° ниже горизонта) */
    }
