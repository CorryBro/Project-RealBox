  sound: true, vib: true, shake: true, eruda: false,
  aimMode: 'toggle',   /* v26: прицел ПО НАЖАТИЮ по умолчанию (переключатель); 'hold' — как раньше, удержанием */
  npcCount: 16, viewRange: 160
};
let settings;
/* ---------- СВЕЖИЙ СТАРТ (v10) ----------
   По просьбе игрока: один раз полностью стираем ВСЕ старые данные игры
   (настройки, свою палитру) — страница загружается «как новая». Флаг-версия
   в vd_fresh не даёт стереть данные повторно. */
try {
  if (localStorage.getItem('vd_fresh') !== '10'){
    const kill = [];
    for (let i = 0; i < localStorage.length; i++){
      const k = localStorage.key(i);
      if (k && k.indexOf('vd') === 0 && k !== 'vd_fresh') kill.push(k);
    }
    for (const k of kill) localStorage.removeItem(k);
    localStorage.setItem('vd_fresh', '10');
  }
} catch(e){}
try { settings = Object.assign({}, DEF, JSON.parse(localStorage.getItem('vdset') || '{}')); } catch(e){ settings = {...DEF}; }
if (settings.shadows === null) settings.shadows = QUALITY[settings.quality].shadows;
/* качество теней: независимая настройка, появляется в меню после включения теней */
const SHADOW_QUAL = { low: 1024, med: 2048, high: 4096 };
if (!settings.shadowQual) {
  /* первый запуск / старый сейв: берём разумное по пресету (high→2048, остальные 1024) */
  settings.shadowQual = (settings.quality === 'high') ? 'med' : 'low';
}
/* v26: режим прицеливания — 'toggle' (нажал) или 'hold' (удержание); старые сейвы без поля → 'toggle' */
if (settings.aimMode !== 'toggle' && settings.aimMode !== 'hold') settings.aimMode = 'toggle';
/* мягкая миграция под карту 250×250м: старые ДЕФОЛТЫ (не пользовательские
   выборы) обновляем один раз — видимость дальше и жителей чуть больше */
if (!settings.bigMapV2) {
  settings.bigMapV2 = true;
  if (settings.viewRange === 120) settings.viewRange = 160;
  if (settings.npcCount === 12) settings.npcCount = 16;
  try { localStorage.setItem('vdset', JSON.stringify(settings)); } catch(e){}
}
const saveSet = () => localStorage.setItem('vdset', JSON.stringify(settings));
const Q = () => QUALITY[settings.quality];

/* ---------- ПЕРСОНАЖ ИГРОКА (v15→v29): редактор в меню + тело в игре ----------
   cfg сохраняется в localStorage (vdchar): имя, ПОЛ (v29: 'm'/'f'),
   причёска (м 0..4 / ж 0..5), цвет волос 0..7 (v29: 8 натуральных),
   рост 150–200 (Ж — от 150), футболка/штаны (пулы СВОЕГО пола, 6/4),
   v29: ГРУДЬ 0..4 (только Ж) + КАСТОМНЫЕ ЦВЕТА (custom: любой hex
   для кожи/волос/футболки/штанов — перекрывают пресет). */
const HAIR_NAMES = ['Классика', 'Бокс', 'Горшок', 'Пробор', 'Хвост'];
const HAIR_F_NAMES = ['Каре', 'Хвост', 'Длинные', 'Пучок', 'Кудри', 'Пикси'];   /* v29: женские причёски */
const HAIR_COL_HEX = ['#181310', '#3a281a', '#6b4526', '#4a3826', '#8a6d47', '#c9a56a', '#8a4a24', '#9a9a98'];
const HAIR_COL_NAMES = ['Чёрный', 'Тёмный орех', 'Каштан', 'Тёмно-русый', 'Русый', 'Блондин', 'Рыжий', 'Седой'];
const SHIRT_NAMES  = ['Терракота', 'Синяя', 'Олива', 'Слива', 'Хвоя', 'Охра'];
const SHIRT_HEX    = ['#6b3a2a', '#3a5a8a', '#6a6a3a', '#5a3a5a', '#3d6952', '#86603f'];   /* = CIVIL_SHIRT A..F */
const PANTS_NAMES  = ['Графит', 'Шоколад', 'Серые', 'Стальные'];
const PANTS_HEX    = ['#2a2a3a', '#3a2a1a', '#4a4a4a', '#2f3f4f'];                         /* = CIVIL_PANTS A..D */
const SHIRT_F_NAMES  = ['Роза', 'Шалфей', 'Лаванда', 'Терракота', 'Небесная', 'Крем'];     /* v29: женские топы */
const SHIRT_F_HEX    = ['#b57f85', '#7d9b76', '#9385ad', '#b06a4a', '#6a93b5', '#c9b491'];
const PANTS_F_NAMES  = ['Джинсы', 'Чёрные', 'Бежевые', 'Хаки'];                            /* v29: женские штаны */
const PANTS_F_HEX    = ['#3a4a66', '#26262a', '#a58a63', '#6d6d4e'];
const BREAST_NAMES = ['Плоская', 'Маленькая', 'Средняя', 'Большая', 'Очень большая'];      /* v29: грудь 0..4 */
const DEF_CHAR = { name: '', gender: 'm', hair: 1, hairF: 0, hairCol: 0, heightCm: 182, shirt: 1, shirtF: 0, pants: 0, pantsF: 0, skin: 4, breast: 1, custom: null, rolls: null };
let charCfg;
try { charCfg = Object.assign({}, DEF_CHAR, JSON.parse(localStorage.getItem('vdchar') || '{}')); } catch(e){ charCfg = {...DEF_CHAR}; }
if (!Array.isArray(charCfg.rolls) || charCfg.rolls.length !== 2) charCfg.rolls = [Math.random(), Math.random()];
charCfg.name = String(charCfg.name || '').slice(0, 16);
if (charCfg.gender !== 'f') charCfg.gender = 'm';   /* v29: пол */
charCfg.hair = Math.max(0, Math.min(4, Math.round(charCfg.hair) || 0));
charCfg.hairF = Math.max(0, Math.min(5, Math.round(charCfg.hairF) || 0));
charCfg.hairCol = Math.max(0, Math.min(7, Math.round(charCfg.hairCol) || 0));
charCfg.heightCm = Math.max(charCfg.gender === 'f' ? 150 : 160, Math.min(200, Math.round(charCfg.heightCm) || 182));
charCfg.breast = Math.max(0, Math.min(4, Math.round(charCfg.breast) || 0));
/* v16 миграция: у старых сейвов футболка/штаны были скрытыми roll-ами —
   переносим их в явные поля, чтобы внешний вид не поменялся */
if (!Number.isInteger(charCfg.shirt) || charCfg.shirt < 0 || charCfg.shirt > 5)
  charCfg.shirt = Math.min(5, Math.floor(charCfg.rolls[1] * 6));
if (!Number.isInteger(charCfg.pants) || charCfg.pants < 0 || charCfg.pants > 3)
  charCfg.pants = Math.min(3, Math.floor(charCfg.rolls[0] * 4));
if (!Number.isInteger(charCfg.shirtF) || charCfg.shirtF < 0 || charCfg.shirtF > 5) charCfg.shirtF = 0;
if (!Number.isInteger(charCfg.pantsF) || charCfg.pantsF < 0 || charCfg.pantsF > 3) charCfg.pantsF = 0;
if (!Number.isInteger(charCfg.skin) || charCfg.skin < 0 || charCfg.skin > 8) charCfg.skin = 4;
/* v29: кастомные цвета — sanitise (валидный #hex или null) */
const _hexOk = v => (typeof v === 'string' && /^#[0-9a-fA-F]{6}$/.test(v)) ? v : null;
if (!charCfg.custom || typeof charCfg.custom !== 'object') charCfg.custom = {};
charCfg.custom = {
  hair: _hexOk(charCfg.custom.hair), skin: _hexOk(charCfg.custom.skin),
  shirt: _hexOk(charCfg.custom.shirt), pants: _hexOk(charCfg.custom.pants)
};
const saveChar = () => { try { localStorage.setItem('vdchar', JSON.stringify(charCfg)); } catch(e){} };
/* геометрия игрока от роста: масштаб по высоте как у жителей v14 (плечи не меняются) */
const charScale = () => charCfg.heightCm / 188;
const charStandH = () => charCfg.heightCm / 100;                 /* полная высота капсулы, м */
const charCrouchH = () => charStandH() - .30 * charScale();      /* в приседе — v21: СТАГГЕР-СТОЙКА (левая вперёд/правая назад): таз ниже на .29м, капсула .30 — совпадает с визуалом, обе ступни на земле */
const charEye = () => 1.70 * charScale();                        /* глаза — как у NPC: 1.70×рост/188 */

let erudaActive = false;
function setEruda(on){
  if (on) { if (window.eruda && !erudaActive) { try { eruda.init(); erudaActive = true; } catch(e){} } }
  else if (window.eruda && erudaActive) { try { eruda.destroy(); erudaActive = false; } catch(e){} }
