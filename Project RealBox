/* ---------- МЕНЕДЖЕР БЛИЗОСТИ/ДАЛЬНОСТИ ----------
   Каждые 0.25с: чанк ближе 40м хочет детальность, дальше 48м — жадность.
   Пересборка происходит через общий dirty-очередь с бюджетом на кадр —
   переходы атомарны, рывков нет. */
const LIVE_R2 = 40*40, FAR_R2 = 48*48, TIER_R2 = 44*44;
