/* пересборка грязных чанков: до N БЛИЖАЙШИХ к камере (глаза важнее);
   режим (детально/жадно) решается по фактической дистанции в момент сборки */
function rebuildDirtyChunks(maxPerFrame){
  const cam = activeCam();
  const px = cam.position.x, pz = cam.position.z;
  const pick = [];
  for (const ch of chunks) {
    if (!ch.dirty) continue;
    const wx = (ch.cx*CSZ + CSZ/2)*S, wz = (ch.cz*CSZ + CSZ/2)*S;
    const dx = wx-px, dz = wz-pz, d2 = dx*dx+dz*dz;
    if (pick.length < maxPerFrame) {
      pick.push({ ch, d2 });
      if (pick.length === maxPerFrame) pick.sort((a,b)=>a.d2-b.d2);
    } else if (d2 < pick[pick.length-1].d2) {
      pick[pick.length-1] = { ch, d2 };
      pick.sort((a,b)=>a.d2-b.d2);
    }
  }
  let n = 0;
  for (const p of pick) {
    const ch = p.ch;
    if (p.d2 < TIER_R2) {
      rebuildChunk(ch);          /* детально */
      if (ch.rec) farZero(ch);   /* жадные инстансы гасим ПОСЛЕ готовой детали — без дыр */
      ch.far = false;
    } else {
      rebuildFarGreedy(ch);      /* жадные инстансы готовы… */
      disposeDetailed(ch);       /* …деталь гасим сразу — без двойной отрисовки */
