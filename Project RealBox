/* ---------- ОБЛАКА: мягкие кучевые из «пухов» (полная переделка v2) ----------
   Каждое облако — крона из перекрывающихся сплюснутых сфер-пухов: широкое
   сине-серое основание, клубящиеся ярусы, пышная макушка. Никаких кубов и
   резких граней — мягкий округлый объём, который читается как НАСТОЯЩЕЕ
   кучевое облако, а не конструктор из блоков. У каждого пуха свой случайный
   поворот — силуэты никогда не повторяются.
   Все пухи всех облаков — ОДИН InstancedMesh (1 draw call):
     - светотень запечена в ВЕРТИКАЛЬНОМ ГРАДИЕНТЕ каждой сферы
       (верх тёпло-белый, дно прохладно-синее);
     - живая подсветка: солнечная сторона облака ярче и теплее (dot-product
       по направлению солнца, обновляется каждый кадр);
     - дальние облака холодеют и тают в дымке (атмосферная перспектива);
     - у края поля ветра облако плавно СЖИМАЕТСЯ в точку и рождается с
       другой стороны — обёртка без «хлопка» и без прозрачности. */
const CLOUD_SPAN = 1500;            /* поле облаков вокруг центра карты (м) */
let CLOUD_CX = 0, CLOUD_CZ = 0;     /* центр = центр карты, задаётся ниже (VILLAGE_CENTER) */
const cloudMat2 = new THREE.MeshBasicMaterial({ vertexColors: true, fog: false });
const cloudField = [];              /* облака: {x, z, y, speed, ph, maxR, blocks[]} */
let cloudMesh = null;
const _clUp = new THREE.Vector3(0, 1, 0);   /* ось случайного поворота пухов */
/* единичный «пух» — низкополигональная сфера (икосаэдр detail 2) с запечённым
   ВЕРТИКАЛЬНЫМ ГРАДИЕНТОМ: сине-серое дно → тёплая светлая макушка.
   Мягкий округлый объём без кубических граней — то, чего не хватало кубам */
function makeCloudPuffGeo(){
  const g = new THREE.IcosahedronGeometry(1, 2);
  const pos = g.attributes.position;
  const col = new Float32Array(pos.count * 3);
  for (let i = 0; i < pos.count; i++){
    const t = pos.getY(i) * .5 + .5;        /* 0 = дно, 1 = макушка */
    col[i*3]   = Math.min(1.06, .68 + .40*t);
    col[i*3+1] = Math.min(1.06, .72 + .33*t);
    col[i*3+2] = Math.min(1.06, .84 + .20*t);
  }
  g.setAttribute('color', new THREE.BufferAttribute(col, 3));
  return g;
}
/* одно облако: «кучевое» из перекрывающихся сплюснутых пухов — широкий низ
   с почти плоским основанием, сужающиеся клубящиеся ярусы, пышная корона */
function makeVoxCloud(rnd){
  const R = 24 + rnd()*30;                 /* базовый радиус 24–54 м */
  const blocks = [];
  let maxR = 1;
  const addPuff = (ox, oy, oz, r, sq, sh) => {
    /* sq — сплюснутость по вертикали: облако широкое, а не шарообразное;
       q — случайный поворот вокруг вертикали: силуэт каждый раз уникален */
    blocks.push({ ox, oy, oz, rx: r, ry: r*sq, rz: r*(.75 + rnd()*.35),
                  sh, q: new THREE.Quaternion().setFromAxisAngle(_clUp, rnd()*Math.PI*2) });
    maxR = Math.max(maxR, Math.hypot(ox + r, oz + r));
  };
  /* нижний слой: 4–6 широких подушек — основание облека, почти плоское снизу */
  const base = 4 + (rnd()*3|0);
  for (let k = 0; k < base; k++){
    const a = (k/base)*Math.PI*2 + rnd()*.7, rr = R*(.15 + Math.sqrt(rnd())*.5);
    addPuff(Math.cos(a)*rr, R*.10 + rnd()*R*.05, Math.sin(a)*rr*.9,
            R*(.38 + rnd()*.22), .42 + rnd()*.12, .96 + rnd()*.06);
  }
  /* средний ярус: 3–5 пухов повыше — силуэт сужается и клубится */
  const mid = 3 + (rnd()*3|0);
  for (let k = 0; k < mid; k++){
    const a = rnd()*Math.PI*2, rr = R*Math.sqrt(rnd())*.62;
    addPuff(Math.cos(a)*rr, R*.30 + rnd()*R*.10, Math.sin(a)*rr*.8,
            R*(.26 + rnd()*.18), .46 + rnd()*.14, .99 + rnd()*.05);
  }
  /* корона: 1–3 пышных пуха на макушке — самая светлая часть */
  const crown = 1 + (rnd()*3|0);
  for (let k = 0; k < crown; k++){
    addPuff((rnd()*2-1)*R*.22, R*.52 + rnd()*R*.12, (rnd()*2-1)*R*.2,
            R*(.16 + rnd()*.14), .52 + rnd()*.16, 1.02 + rnd()*.04);
  }
  return { blocks, maxR };
}
{
  const rnd = Math.random;
  const N_CLOUDS = 30;   /* чуть плотнее небо: ~330 пухов, всё ещё 1 draw call */
  let total = 0;
  for (let i = 0; i < N_CLOUDS; i++){
    const c = makeVoxCloud(rnd);
    const ang = rnd()*Math.PI*2;
    const dist = rnd() < .45 ? 40 + rnd()*240 : 200 + Math.sqrt(rnd())*480;   /* 45% — близкий пояс над деревней */
    /* случайный поворот облака вокруг вертикали — каждый силуэт уникален */
    const rot = rnd()*Math.PI*2, cs = Math.cos(rot), sn = Math.sin(rot);
    for (const b of c.blocks){ const bx = b.ox*cs - b.oz*sn, bz = b.ox*sn + b.oz*cs; b.ox = bx; b.oz = bz; }
    cloudField.push({
      x: Math.cos(ang)*dist, z: Math.sin(ang)*dist*.9,
      y: 95 + rnd()*55, speed: 1.1 + rnd()*1.9, ph: rnd()*Math.PI*2,
      maxR: c.maxR, blocks: c.blocks
    });
    total += c.blocks.length;
  }
  cloudMesh = new THREE.InstancedMesh(makeCloudPuffGeo(), cloudMat2, total);
  cloudMesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
  const cInit = new THREE.Color(1, 1, 1);
  for (let i = 0; i < total; i++) cloudMesh.setColorAt(i, cInit);
  cloudMesh.frustumCulled = false;              /* инстансы двигаются каждый кадр */
  cloudMesh.matrixAutoUpdate = false; cloudMesh.updateMatrix();
  cloudMesh.renderOrder = 5;                    /* после неба и светил, до частиц/трассеров */
  cloudMesh.castShadow = cloudMesh.receiveShadow = false;
  scene.add(cloudMesh);
}
/* обновление облаков: дрейф ветром, покачивание, обёртка поля со сжатием
   в точку у края, живая подсветка солнечной стороны и дальняя дымка */
const _clM = new THREE.Matrix4(), _clP = new THREE.Vector3(), _clQ = new THREE.Quaternion(), _clS = new THREE.Vector3();
function updateClouds(dt, cam){
  if (!cloudMesh) return;
  const half = CLOUD_SPAN*.5, fade = 170;
  const sdx = _sunDirV.x, sdy = _sunDirV.y, sdz = _sunDirV.z;
  const sunK = Math.max(0, Math.min(1, (sdy + .10) * 3.4));   /* сила подсветки солнцем */
  const cpx = cam.position.x, cpy = cam.position.y, cpz = cam.position.z;
  const col = cloudMesh.instanceColor.array;
  let i = 0;
  for (const c of cloudField){
    c.x += c.speed * dt;
    if (c.x - c.maxR > half) c.x -= CLOUD_SPAN + c.maxR*2 + 4;   /* ушло за край — с другой стороны */
    const wx = CLOUD_CX + c.x, wz = CLOUD_CZ + c.z;
    /* край поля: облако плавно СЖИМАЕТСЯ в точку (обёртка без «хлопка») */
    let es = (half - Math.abs(wx)) / fade;
    es = es <= 0 ? 0 : (es >= 1 ? 1 : es*es*(3-2*es));
    const wy = c.y + Math.sin(timeNow*.045 + c.ph)*2.4;   /* лёгкое покачивание */
    const dist = Math.hypot(wx-cpx, wy-cpy, wz-cpz);
    let dk = (dist - 380) / 280;                          /* дальняя дымка */
    dk = dk <= 0 ? 0 : (dk >= 1 ? 1 : dk*dk*(3-2*dk));
    const invR = 1/Math.max(14, c.maxR);
    for (const b of c.blocks){
      _clP.set(wx + b.ox, wy + b.oy, wz + b.oz);
      _clQ.copy(b.q);   /* личный поворот пуха: силуэты не повторяются */
      _clS.set(Math.max(.001, b.rx*es), Math.max(.001, b.ry*es), Math.max(.001, b.rz*es));
      _clM.compose(_clP, _clQ, _clS);
      cloudMesh.setMatrixAt(i, _clM);
      /* солнечная сторона теплее/ярче, теневая — прохладнее; дымка дальних
         приглушает и холодит (r гасится сильнее, b слабее — атмосферная перспектива) */
      const lk = (b.ox*sdx + b.oy*.6*sdy + b.oz*sdz) * invR * sunK;
      const dim = 1 - dk*.32;
      col[i*3]   = b.sh * (1 + .12*lk) * (dim + dk*.05);
      col[i*3+1] = b.sh * (1 + .07*lk) * (dim + dk*.12);
      col[i*3+2] = b.sh * (1 - .06*lk) * (dim + dk*.30);
      i++;
    }
  }
  cloudMesh.instanceMatrix.needsUpdate = true;
  cloudMesh.instanceColor.needsUpdate = true;
}

