      Rx = Rx*(1-ws) + (WIND_G.aRx + trem)*ws;
      Rz = Rz*(1-ws) + WIND_G.aRz*ws;
      Fx = Fx*(1-ws) + WIND_G.fRx*ws;
      Rx = Rx*(1-cv) + COCK.aRx*cv;   /* v21: ЗАРЯДКА — рука уходит назад к взводу, пока жмёшь (индикатор силы); v22: чем сильнее заряд — тем ВЫШЕ замах (к COCK_G2) */
      Rz = Rz*(1-cv) + COCK.aRz*cv;
      Fx = Fx*(1-cv) + COCK.fRx*cv;
      Rx = Rx*(1-ck) + COCK.aRx*ck;   /* v21: полный взвод перед хлыстом (быстрый тап — досвод за .09с) */
      Rz = Rz*(1-ck) + COCK.aRz*ck;
      Fx = Fx*(1-ck) + COCK.fRx*ck;
