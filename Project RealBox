      e.m.material.opacity = .58 * (1 - k);
      if (k >= 1) { scene.remove(e.m); e.m.material.dispose(); explFX.splice(i, 1); }
    } else if (e.k === 'core') {
      e.m.scale.setScalar(e.sc0 * (1 + .8*k));
      e.m.material.opacity = 1 - k;
      if (k >= 1) { scene.remove(e.m); e.m.material.dispose(); explFX.splice(i, 1); }
    } else if (e.k === 'clod') {
      e.vy -= (e.gr || 22)*dt;
