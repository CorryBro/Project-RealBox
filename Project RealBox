      const cg = ex2*(1-ret)*.6;
      if (cg > .003) {
        if (punchSide === 0) { Lx = Lx*(1-cg) + (P.aLx + .18)*cg; Lf = Lf*(1-cg) + (P.fLx + .22)*cg; }
        else                 { Rx = Rx*(1-cg) + (P.aRx + .18)*cg; Fx = Fx*(1-cg) + (P.fRx + .22)*cg; }
      }
      /* корпус вкладывается в удар: скрутка плеч + выпад (таз садится) — «вложился всем телом» */
      const twp = ex2*(1-ret);
      ud.torso.rotation.y += (punchSide === 0 ? .34 : -.34)*twp;
      ud.torso.rotation.x += -.15*twp;
