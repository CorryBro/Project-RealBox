/* v17: ПОВОРОТ «ГОЛОВОЙ ОТДЕЛЬНО ОТ ТЕЛА» (заявка игрока): камера крутится —
   голова следит за взглядом до анатомического предела («тот же градус», что
   у NPC: взгляд в лицо до 57°), ТЕЛО СТОИТ; дальше — тело плавно доворачивается
   (на месте неторопливо, на ходу живее, при выстреле/броске — быстро, чтобы
   ствол сразу в цель). Торс подкручивается на 40% остатка — плечи/оружие
   тянутся за взглядом, как у живого стрелка. При возврате камеры в центр
   тело так же плавно раскручивается обратно (не остаётся боком). */
let bodyYaw = null, twistSm = 0, bodySnapT = 0, legYawSm = 0, grenLungeW = 0, grenTwistW = 0;   /* legYawSm — v21: доворот БЁДЕР к движению; grenLungeW — вес выпада броска (таз садится в rootDrop); grenTwistW — v23: сила броска 0..1 — ослабляет «стабилизацию плеч стрелка» для СИЛЬНОГО броска (скрутка корпуса работает в полную амплитуду) */
const HEAD_MAX = 1.02;   /* 58° — «тот же градус», что у NPC */
function wrapAng(a){ while (a > Math.PI) a -= Math.PI*2; while (a < -Math.PI) a += Math.PI*2; return a; }
function turnReset(){ bodyYaw = null; twistSm = 0; bodySnapT = 0; }
function turnUpdate(dt){
  if (bodyYaw === null) bodyYaw = player.yaw;
  let dyw = wrapAng(player.yaw - bodyYaw);
  const a = Math.abs(dyw);
  /* СТОЯ: тело не крутится вообще, пока голова достаёт (до ~55°) — заявка
     игрока («тело не поворачивается само»). За пределом — догоняет.
     НА ХОДУ (v19, заявка «тело и ноги поворачиваются куда стреляешь»):
     мёртвой зоны нет вообще — тело ВСЕГДА идёт за взглядом, ходим с прямо
     поставленной головой, ствол подтягивается к цели.
     ВЫСТРЕЛ/БРОСОК: быстрый доворот ствола к цели.
     v19-ФИКС «ПРИ ВЫСТРЕЛЕ ОРУЖИЕ ЖЁСТКО ТРЯСЁТСЯ»: прежняя логика была
     bang-bang — за зоной тело гналось вперёд (до 8 рад/с), у кромки резко
     рвалось НАЗАД константой (3 рад/с). На краю зоны скорость прыгала на
     11 рад/с → ПРЕДЕЛЬНЫЙ ЦИКЛ: тело (и оружие в руках) дрожало всё время
     bodySnapT после выстрела. Теперь скорость НЕПРЕРЫВНА и пропорциональна
     (a-dz): сходимость монотонная, без рывков и перебросов. */
  /* СТОЯ (v20, заявка «прицел всегда туда — корпус/руки/голова поворачиваются
     по факту»): мёртвая зона 55°→17° — в пределах ~17° вертим только голову
     (шея), дальше СРАЗУ подключается корпус (kk 8, до 6 рад/с) — плечи и
     оружие разворачиваются за прицелом почти мгновенно, ноги остаются на
     месте до сильного увода. НА ХОДУ — без зоны (v19), быстрее.
     ВЫСТРЕЛ/БРОСОК — снап ещё резче.
     (Формула непрерывная P-контроль — без bang-bang, без тряски на кромке.) */
  let dz, kk, cap;
  if (bodySnapT > 0)          { dz = .05; kk = 13;  cap = 6.5; }  /* выстрел: снап к цели */
  else if (player.speed > .55){ dz = .03; kk = 11;  cap = 9.5; }  /* v21: на ходу — тело ВСЕГДА и РЕЗКО за взглядом (180° за ~0.33с; было cap 4.6 — висело боком, «скользило»). После остановки bodyYaw ОСТАЁТСЯ (не раскручивается) — заявка «прошёл и стою туда, пока сам не повернусь» */
  else                        { dz = .12; kk = 10;  cap = 8.0; }  /* v27: стоим — голова ведёт лишь ~7°, дальше СРАЗУ корпус (оружие жёстко на камере — тело шустрее догоняет, руки IK не тянутся через грудь) */
  /* v21.2-ФИКС «после остановки тело ОТКАТЫВАЕТСЯ на 17° назад» (заявка «после
     окончания бега/ходьбы тело ОСТАЁТСЯ там, пока не повернёшься»): прежний
     clamp(-rret..cap) при |dyw|<dz гнал bodyYaw НАЗАД (развёртка к границе
     мёртвой зоны) — после остановки корпус заметно «сползал» боком. Теперь
     шаг неотрицательный: тело только ДОВОРАЧИВАЕТСЯ к взгляду и замирает
     ровно там, где шло; назад не откатывается никогда. Возврат камеры
     (dyw меняет знак) по-прежнему работает: sign(dyw)*step — поворот ЗА
     взглядом в любую сторону. */
  const step = THREE.MathUtils.clamp((a - dz)*kk, 0, cap);
  if (step) { bodyYaw = wrapAng(bodyYaw + Math.sign(dyw)*step*dt); dyw = wrapAng(player.yaw - bodyYaw); }
  twistSm += (THREE.MathUtils.clamp(dyw, -HEAD_MAX, HEAD_MAX)*.58 - twistSm) * Math.min(1, 10*dt);   /* v20: торс-скрутка 45%→58% — плечи/ствол заметнее тянутся за прицелом */
  return dyw;
}

/* модель персонажа по cfg (over — точечные переопределения для иконок).
   v29: полностью ЯВНЫЕ опции (никакого «подкрученного» rng — порядок
   вызовов больше не критичен): пол, грудь, пулы одежды своего пола,
   кастомные цвета (важнее индексов), свой стиль причёски и рост */
function buildCharModel(over){
  const cfg = over ? Object.assign({}, charCfg, over) : charCfg;
  const f = cfg.gender === 'f';
  return buildVillagerModel(null, {
    female: f,
    breast: f ? (Number.isInteger(cfg.breast) ? cfg.breast : 1) : 0,
    skinIdx: Number.isInteger(cfg.skin) ? cfg.skin : 4,
    skinHex: (cfg.custom && cfg.custom.skin) || null,
    pantsIdx: f ? cfg.pantsF : cfg.pants,
    pantsHex: (cfg.custom && cfg.custom.pants) || null,
    shirtIdx: f ? cfg.shirtF : cfg.shirt,
    shirtHex: (cfg.custom && cfg.custom.shirt) || null,
    hairColIdx: Number.isInteger(cfg.hairCol) ? cfg.hairCol : 0,
    hairHex: (cfg.custom && cfg.custom.hair) || null,
    hairStyle: f ? cfg.hairF : cfg.hair,
    heightCm: cfg.heightCm
  });
}
function disposeModel(m){ m.traverse(o => { if (o.isMesh && o.geometry) { try { o.geometry.dispose(); } catch(e){} } }); }

/* --- тело в игре --- */
let handAnchor = null;   /* v16: центр правой КИСТИ — сюда крепится оружие */
function wpDetach(){
