/* ============================================================
   ИГРОВОЙ ЦИКЛ
   ============================================================ */
let timeNow = 0;
let lastT = performance.now(), fpsFrames = 0, fpsTime = 0;
let dayPhase = 0.32;   /* старт утром ~07:40 — солнце уже на востоке, длинные мягкие тени */
let astarBudget = 2;   /* бюджет A* на кадр (анти-спайк толпы жителей) */

let lastErrMsg = '', lastErrT = -9;
function reportError(tag, err){
  console.error('[' + tag + ']', err);
  const msg = (err && err.message) || String(err);
  if (msg === lastErrMsg && timeNow - lastErrT < 2) return;
  lastErrMsg = msg; lastErrT = timeNow;
  toast('⚠ [' + tag + '] ' + msg.slice(0, 50));
}

function loop(t){
  requestAnimationFrame(loop);
  const dt = Math.min((t - lastT) / 1000, .05); lastT = t; timeNow += dt;
  fpsFrames++; fpsTime += dt;
  if (fpsTime >= .5) { fpsEl.textContent = Math.round(fpsFrames / fpsTime); fpsFrames = 0; fpsTime = 0; }
  if (state === 'playing') {
    astarBudget = 2;   /* сброс бюджета A* на кадр */
    const sys = (tag, fn) => { try { fn(); } catch(err){ reportError(tag, err); } };
    /* v29: ВРЕМЯ МИРА — заморозка/скорость действуют на МИР, НЕ на игрока:
       NPC, физика, обломки, гранаты, взрывы, облака и день/ночь едут по wdt;
       игрок, оружие, камера и прицеливание — по dt (реальное время).
       Пули — hitscan (мгновенно всегда), трассеры-визуал замедляются вместе
       с миром. При заморозке частицы/взрывы доигрывают (реакция на выстрел),
       граната висит в воздухе — как в «заморозке времени» больших игр. */
    const wdt = dev.freeze ? 0 : dt * dev.timeScale;
    sys('player', () => playerUpdate(dt));
    sys('grab', () => grabUpdate(dt));
    sys('grabUI', () => { grabTargetTimer -= dt; if (grabTargetTimer <= 0) { grabTargetTimer = .12; updateGrabTarget(); } });
    sys('weapon', () => updateWeapon(dt));
    sys('grenades', () => { if (wdt > 0) updateGrenades(wdt); });
    sys('npcs', () => { if (wdt > 0) for (const n of npcs) npcUpdate(n, wdt); });
    sys('npcImpacts', () => { if (!dev.freeze) npcCheckImpacts(); });
    sys('dynBlocked', () => { if (wdt > 0) updateDynBlocked(wdt); });
    sys('physRefresh', () => physRefreshIfNeeded(player.pos.x, player.pos.z));
    sys('phys', () => { if (!dev.freeze) { world.timestep = Math.min(dt, 1/30) * dev.timeScale; world.step(); } });
    sys('debris', () => { if (wdt > 0) updateDebris(wdt); });
    sys('clusters', () => { if (wdt > 0) updateClusters(wdt); });
    sys('tracers', () => updateTracers(dev.freeze ? dt : wdt));   /* пули живут даже в заморозке */
    sys('collapse', () => {
      /* обрушение срабатывает не только от разрушений, но и когда игрок подходит
         к новому месту — «висящие в воздухе» куски падают при подходе */
      const pcx = Math.floor(player.pos.x/S), pcz = Math.floor(player.pos.z/S);
      if (Math.abs(pcx-collapseCenterX) > 10 || Math.abs(pcz-collapseCenterZ) > 10) collapseDirty = true;
      if (collapseDirty && wdt > 0) { collapseTimer -= wdt; if (collapseTimer <= 0) { collapseTimer = .15; collapsePass(); } }
    });
    sys('fx', () => { updateParticles(dev.freeze ? dt : wdt); });
    sys('explfx', () => updateExplFX(dev.freeze ? dt : wdt));
    sys('chunks', () => {
      /* менеджер близости: детальные чанки — только вокруг игрока */
      chunkTierUpdate(dt);
      /* видимость чанков/бакетов по дистанции */
      updateChunkVisibility(camera.position, settings.viewRange);
      /* пересобрать грязные чанки — лимит на кадр */
      rebuildDirtyChunks(3);
      if (glowDirtyFlag) glowRebuild();
    });
    composeCamera(dt);
    if (!dev.freeCam) weaponLockUpdate(dt);
    else {   /* v30: свободная камера — оружие ОСТАЁТСЯ В КИСТИ игрока (база «в кисти», без лока на улетающую камеру) */
      const tpF = (cur === 0) ? tpPistol : (cur === 2) ? tpM4 : null;
      if (tpF) { tpF.position.copy(_wpBaseP); tpF.quaternion.copy(_wpBaseQ); }
    }
    if (cur === 3 && punchExW > 0 && !dev.freeCam) punchIK();   /* v30: кулаки — кисть бьющей руки дотягивается IK НА ЛУЧ КАМЕРЫ (свежая после composeCamera) */
    if (muzFlash.visible) { tpPistol.updateWorldMatrix(true, true); muzFlash.lookAt(camera.position); }
    if (muzFlashM.visible) { tpM4.updateWorldMatrix(true, true); muzFlashM.lookAt(camera.position); }
    /* v22: прицеливание — доводка оружия к камере (после установки камеры, матрица свежая) */
    /* умные тени: перерисовать карту только если что-то движется */
    shadowTick(dt);
    /* день/ночь + облака + небо следует за камерой (v29: заморозка/слоумо) */
    if (!dev.freeze) dayPhase = (dayPhase + dt * .005 * dev.timeScale) % 1;
    camera.updateMatrixWorld();
    updateClouds(dev.freeze ? 0 : dt * dev.timeScale, camera);
    skyDome.position.copy(camera.position); skyDome.updateMatrix();
    updateCelestial();
    /* статистика HUD: DOM пишем ТОЛЬКО при изменении (каждый кадр писать
       textContent = принудительный layout — один из источников проседаний) */
    {
      let alive = 0; for (const n of npcs) if (n.alive) alive++;
      if (alive !== hudAlive) { hudAlive = alive; $('villagers').textContent = alive; }
    }
  } else if (state === 'menu' || state === 'loading') {
    const a = timeNow * .12;
    menuCam.position.set(Wm/2 + Math.cos(a)*8.5, 5.4 + Math.sin(timeNow*.3)*.6, Dm/2 + Math.sin(a)*8.5);
    menuCam.lookAt(Wm/2, 1.4, Dm/2);
    if (world) {
      try { world.step(); updateDebris(dt); updateClusters(dt); updateParticles(dt); updateExplFX(dt); } catch(err){ reportError('menu', err); }
      /* за меню-камерой деревня ЖИВЁТ: жители ходят, стоят, дышат, моргают */
      try { astarBudget = 2; for (const n of npcs) npcUpdate(n, dt); } catch(err){ reportError('menuNpc', err); }
    }
    chunkTierUpdate(dt);
    rebuildDirtyChunks(4);   /* в меню детализируем центр ускоренно (фоном) */
    updateChunkVisibility(menuCam.position, settings.viewRange);
    if (glowDirtyFlag) glowRebuild();
    menuCam.updateMatrixWorld();
    updateClouds(dt, menuCam);
    skyDome.position.copy(menuCam.position); skyDome.updateMatrix();
    updateCelestial();
    /* в меню мир может досыпать (кластеры) — тени обновляем как раньше, меню не экономим */
    if (renderer.shadowMap.enabled && (sun.castShadow || moon.castShadow)) renderer.shadowMap.needsUpdate = true;
  }
  renderer.render(scene, (state === 'menu' || state === 'loading') ? menuCam : camera);
  /* v15: редактор персонажа — свой рендер поверх (деревня живёт фоном) */
  if (edActive) { try { edTick(dt); } catch(err){ reportError('editor', err); } }
}

/* ---------- СВЕТИЛА И ВРЕМЯ СУТОК ----------
   Единая модель: dayPhase 0..1 = часы 00:00..24:00.
   Солнце: встаёт 06:00 (восток, +X), зенит 12:00, садится 18:00 (запад, -X).
   Луна — зеркально (ночное светило). Всё синхронно с часами в HUD.
   Здесь же: цвета неба (градиент + закатные тона), свечение у солнца, звёзды,
   туман в цвет горизонта, окраска облаков, диски светил, фонари. */
const _skyDayTop = new THREE.Color(0x4a86d4), _skyDayMid = new THREE.Color(0x89b8e8), _skyDayBot = new THREE.Color(0xc6ddff);
/* ВАЖНО про ночные цвета: кастомный шейдер неба выводит ЛИНЕЙНЫЕ значения без
   sRGB-конверсии, поэтому пиксель = dec(hex). Чтобы ночь ВЫГЛЯДЕЛА как задумано
   (видимый лунный синий, а не чернота), hex-ы ниже — заранее «проинвертированы»:
   0x425a80 рисуется как (14,26,55) и т.д. Днём палитра не тронута — какой вид
   нравится юзеру, такой и остаётся. */
const _skyNightTop = new THREE.Color(0x425a80), _skyNightMid = new THREE.Color(0x5a739a), _skyNightBot = new THREE.Color(0x788faf);
const _fogNight = new THREE.Color(0x293449);   /* туман ночи темнее неба (пиксельно ~30,44,74) */
const _duskMid = new THREE.Color(0xe8925c), _duskBot = new THREE.Color(0xf7b06e);
const _sunHigh = new THREE.Color(0xfff3d9), _sunLow = new THREE.Color(0xff8f3d);
const _cloudDay = new THREE.Color(0xffffff), _cloudNight2 = new THREE.Color(0x333e58), _cloudDusk = new THREE.Color(0xffb789);
const _hemiSkyD = new THREE.Color(0xc6ddff), _hemiSkyN = new THREE.Color(0x55679a);
const _hemiGndD = new THREE.Color(0x5b4a32), _hemiGndN = new THREE.Color(0x191627);
const _sunDirV = new THREE.Vector3(), _moonDirV = new THREE.Vector3(), _discPos = new THREE.Vector3();
/* орбиты светил: БЕЗ наклона — круг солнца проходит ровно через зенит КОЛОДЦА
   (центр карты): восход точно на востоке за деревней, полдень — прямо над
   колодцем, закат точно на западе. Радиус DISC_R не меняли (не приближали к
   карте) — только само положение круга, как просил пользователь. */
const SUN_TILT = 0, MOON_TILT = 0, DISC_R = 160;
const _vCenter = new THREE.Vector3(VILLAGE_CENTER.x, 0, VILLAGE_CENTER.z);
let hudAlive = -1, hudClockTxt = '';
function updateCelestial(){
  const a = (dayPhase - 0.25) * Math.PI * 2;      /* 06:00 → 0, 12:00 → π/2 */
  const elev = Math.sin(a);                        /* высота солнца (-1..1) */
  const horiz = Math.cos(a);                       /* восток(+1) → запад(-1) */
  const ss = (x, lo, hi) => THREE.MathUtils.smoothstep(x, lo, hi);
  const dayness = ss(elev, -0.12, 0.25);           /* 0=ночь, 1=день */
  const duskK = 1 - Math.min(1, Math.abs(elev) / 0.26);   /* близость к горизонту */
  /* направления светил */
  _sunDirV.set(horiz, elev, SUN_TILT).normalize();
  _moonDirV.set(-horiz, -elev, MOON_TILT).normalize();
  /* небо: базовый градиент день/ночь + закатные тона у горизонта */
  const U = skyMat.uniforms;
  U.top.value.copy(_skyNightTop).lerp(_skyDayTop, dayness);
  U.mid.value.copy(_skyNightMid).lerp(_skyDayMid, dayness).lerp(_duskMid, duskK * .55);
  U.bottom.value.copy(_skyNightBot).lerp(_skyDayBot, dayness).lerp(_duskBot, duskK * .7);
  U.uSunDir.value.copy(_sunDirV);
  U.uGlowCol.value.set(0xffd9a0).lerp(_sunLow, duskK);
  U.uGlowK.value = .22 + duskK * 1.05;
  U.uNightK.value = 1 - dayness;
  /* туман и фон — в цвет горизонта днём, ночью туман темнее неба (земля темнее
     светящегося неба — как в реальную лунную ночь), чтобы не было яркой полосы тумана */
  scene.fog.color.copy(U.bottom.value).lerp(_fogNight, (1 - dayness) * .85);
  scene.background.copy(U.bottom.value);
  /* солнце: цвет и сила (у горизонта — тёплое и слабое) */
  const sunI = ss(elev, -0.045, 0.10) * 1.75;
  sun.intensity = sunI;
  sun.color.copy(_sunHigh).lerp(_sunLow, duskK);
  /* луна (заметно ярче — ночь playable: видно рельеф, лунные тени, дома) */
  const moonI = ss(-elev, -0.045, 0.10) * .80;
  moon.intensity = moonI;
  /* высота светила для ТЕНЕЙ не ниже ~8°: у самого горизонта тени вытянулись
     бы в бесконечность и вылезли артефакты; рассветное свечение неба это
     полностью маскирует (света в этот момент почти нет) */
  const shE = Math.max(elev, 0.14);
  /* ТЕНЕВОЙ ЯКОРЬ — следует за игроком (карта 250×250м: от центра не накрыть).
     Снап 2м выровнен на тексель карты теней любого качества — тени не плывут.
     Диски светил по-прежнему кружат вокруг КОЛОДЦА — свет (тени) согласован
     с диском по НАПРАВЛЕНИЮ, а позиция источника ездит за игроком. */
  const acam = (state === 'menu' || state === 'loading') ? menuCam : camera;
  const ax = Math.round(acam.position.x / 2) * 2, az = Math.round(acam.position.z / 2) * 2;
  sun.position.set(ax + horiz * 123, shE * 123 * 1.15, az);
  sun.target.position.set(ax, 0, az);
  sun.castShadow = settings.shadows && sunI > 0.004;
  const mhE = Math.max(-elev, 0.18);
  moon.position.set(ax - horiz * 123, mhE * 123, az);
  moon.target.position.set(ax, 0, az);
  moon.castShadow = settings.shadows && sunI <= 0.004 && moonI > 0.004;
  /* полусфера и подсветка (ночь — светлая лунная, не чернота) */
  hemi.intensity = .42 + dayness * .52;
  hemi.color.copy(_hemiSkyN).lerp(_hemiSkyD, dayness);
  hemi.groundColor.copy(_hemiGndN).lerp(_hemiGndD, dayness);
  fill.intensity = .13 + dayness * .13;
  /* видимые диски солнца и луны — кружат вокруг ЦЕНТРА КАРТЫ (радиус DISC_R):
     с любого угла карты видно, что светило ходит «вокруг середины», восход — за
     восточным краем деревни, закат — за западным */
  const cam = (state === 'menu' || state === 'loading') ? menuCam : camera;
  const sunVis = elev > -0.12;
  sunDisc.visible = sunVis;
  if (sunVis) {
    _discPos.copy(_vCenter).addScaledVector(_sunDirV, DISC_R);
    sunDisc.position.copy(_discPos);
    sunDisc.material.opacity = ss(elev, -0.12, -0.01);
    sunDisc.material.color.copy(_sunHigh).lerp(_sunLow, duskK * .8);
    const sc = 42 + duskK * 12;                    /* у горизонта чуть крупнее (атмосфера) */
    sunDisc.scale.set(sc, sc, 1);
  }
  const moonVis = -elev > -0.10;
  moonDisc.visible = moonVis;
  if (moonVis) {
    _discPos.copy(_vCenter).addScaledVector(_moonDirV, DISC_R);
    moonDisc.position.copy(_discPos);
    moonDisc.material.opacity = ss(-elev, -0.10, 0.0) * .96;
  }
  /* облака: окраска по времени суток (движение — в updateClouds) */
  cloudMat2.color.copy(_cloudNight2).lerp(_cloudDay, dayness).lerp(_cloudDusk, duskK * .8);
  /* часы HUD: пишем в DOM только при смене минуты */
  const hours = Math.floor(dayPhase * 24);
  const mins = Math.floor((dayPhase * 24 - hours) * 60);
  const txt = String(hours).padStart(2, '0') + ':' + String(mins).padStart(2, '0');
  if (txt !== hudClockTxt) { hudClockTxt = txt; $('clock').textContent = txt; }
  /* фонари горят ночью. ОПТИМИЗАЦИЯ двойная:
     (1) днём все фонари visible=false — Lambert не перечисляет их в шейдере;
     (2) ночью ФИЗИЧЕСКИ светят только 10 БЛИЖАЙШИХ к камере фонарей (радиус
         лампы 12м — дальше всё равно не видно), число видимых лайтов
         СТАБИЛЬНОЕ → шейдер не перекомпилируется при ходьбе. Оба варианта
         прогреты в prewarmLampShaders(). */
  const nightK = (1 - dayness) * 4;
  const lampsOn = nightK > .05;
  if (timeNow - lampCullT > .5) {
    lampCullT = timeNow;
    lampActive.length = 0;
    if (lampsOn) {
      const cx2 = acam.position.x, cz2 = acam.position.z;
      for (let i = 0; i < LAMP_LIGHTS.length; i++) {
        const L = LAMP_LIGHTS[i];
        const dx = L.x - cx2, dz = L.z - cz2, d2 = dx*dx + dz*dz;
        if (d2 > 55*55) continue;                      /* дальше 55м свет заведомо не виден */
        if (lampActive.length < LAMP_LIGHTS_MAX) {
          lampActive.push(i);
          if (lampActive.length === LAMP_LIGHTS_MAX) {
            lampActive.sort((p, q) => {
              const A = LAMP_LIGHTS[p], B = LAMP_LIGHTS[q];
              return (A.x-cx2)**2+(A.z-cz2)**2 - ((B.x-cx2)**2+(B.z-cz2)**2);
            });
          }
        } else {
          const worst = lampActive[lampActive.length-1];
          const W = LAMP_LIGHTS[worst];
          if (d2 < (W.x-cx2)**2 + (W.z-cz2)**2) lampActive[lampActive.length-1] = i;
        }
      }
      lampActive.sort((p, q) => {
        const A = LAMP_LIGHTS[p], B = LAMP_LIGHTS[q];
        return (A.x-cx2)**2+(A.z-cz2)**2 - ((B.x-cx2)**2+(B.z-cz2)**2);
      });
    }
  }
  for (let i = 0; i < LAMP_LIGHTS.length; i++) {
    const L = LAMP_LIGHTS[i];
    const on = lampsOn && lampActive.includes(i);
    L.L.visible = on;
    if (on) L.L.intensity = nightK;
  }
}
const LAMP_LIGHTS_MAX = 10;
let lampCullT = -9;
const lampActive = [];
/* прогрев ОБЕИХ вариантов шейдеров (фонари вкл/выкл): два реальных рендера
   кадра — так программы компилируются и кэшируются точно так же, как в игре.
   Вызывается ДО скрытия меню — пользователь ничего не видит. (renderer.compile()
   здесь НЕ подходит: в three r170 он ломает стек состояния рендера — на живом
   цикле после него GPU-процесс падал.) */
function prewarmLampShaders(){
  try {
    const cam = camera;
    updateCelestial();   /* выставить фонари по правилу «10 ближайших» */
    /* вариант «фонари ВКЛ»: ровно столько лайтов, сколько будет в игре ночью
       (стартуем утром — на живом кадре этого варианта шейдера не видно,
       иначе был бы фриз на первом закате) */
    const saved = LAMP_LIGHTS.map(l => l.L.visible);
    const act = [];
    for (let i = 0; i < LAMP_LIGHTS.length && act.length < LAMP_LIGHTS_MAX; i++) act.push(i);
    for (let i = 0; i < LAMP_LIGHTS.length; i++) LAMP_LIGHTS[i].L.visible = act.includes(i);
    renderer.render(scene, cam);
    for (const l of LAMP_LIGHTS) l.L.visible = false;
    renderer.render(scene, cam);          /* программы «фонари ВЫКЛ» */
    LAMP_LIGHTS.forEach((l, i) => { l.L.visible = saved[i]; });
  } catch(e){ console.warn('prewarm failed', e); }
}

