    if (cur === 0) _wpBaseE.set(-(Rx + Fx) + pf + .04 + (.34 + .12*runF*amp)*cr + recoil*.34*(1 - .45*adsW), 0, 0);
    else if (cur === 2) _wpBaseE.set(-(Rx + Fx) + pf + .04 + (.34 + .12*runF*amp)*cr + recoil*.27*(1 - .45*adsW), 0, 0);
    else _wpBaseE.set(-(Rx + Fx)*.88 + .08, 0, 0);   /* v28: граната — лёгкий естественный наклон ЗА КИСТЬЮ (было: жёсткий горизонт) */
    /* стрелок держит плечи ровнее — глушим противовращение/крен торса
       (v19, заявка «оружие всё равно дёргается на ходу»):
       противовращение плеч на частоте шагов качало руки вбок-вбок.
       Плечи стрелка почти неподвижны — качают бёдра и голова.
       v23: СИЛЬНЫЙ бросок гранаты — исключение: стабилизацию снимаем
       (grenTwistW), иначе скрутка корпуса метателя гасилась на 78% и
       замах читался вялым. У оружия и слабого броска — как было. */
    ud.torso.rotation.y *= 1 - (.78 - .55*grenTwistW)*b;
    ud.torso.rotation.z *= 1 - .6*b;
