    /* стартовая сборка дальнего слоя всей карты — с прогресс-баром, слайсами по ~14мс */
    await buildFarWorldProgress();
    $('loadText').textContent = 'Заселение жителей…';
    document.querySelector('#loadBar i').style.width = '97%';
    await new Promise(r => setTimeout(r, 10));
    spawnAllNpcs(settings.npcCount);
    $('loadText').textContent = 'Готово!';
    document.querySelector('#loadBar i').style.width = '100%';
