  setState('playing');
  updateGrabTarget();
  if (!isTouch) {
    canvas.requestPointerLock();
    setTimeout(() => toast('Shift — бег · ЛКМ — огонь · ПКМ/🎯 — прицел · граната: ЗАЖМИ (замах) → ОТПУСТИ (бросок) · E — взять · R — перезарядка'), 900);
  } else {
