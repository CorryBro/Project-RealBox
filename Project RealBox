  for (let dz=-gr; dz<=gr; dz++) {
    if (((dz+gr) & 3) !== mySlice) continue;
    for (let dx=-gr; dx<=gr; dx++) {
      if (dx*dx+dz*dz > gr*gr) continue;
      const gx = cx+dx, gz = cz+dz;
      if (gx<0||gz<0||gx>=VW||gz>=VD) continue;
      for (let y=1; y<VH; y++) {
        const i = vIdx(gx,y,gz); if (!grid[i]) continue;
        if (voxCols.has(i)) continue;
        const nb = (getVox(gx+1,y,gz)?1:0)+(getVox(gx-1,y,gz)?1:0)+(getVox(gx,y+1,gz)?1:0)+(getVox(gx,y-1,gz)?1:0)+(getVox(gx,y,gz+1)?1:0)+(getVox(gx,y,gz-1)?1:0);
