    c.sleepSynced = false; c.asleep = false; gAwakeClusters++;
    const t = c.body.translation(), r = c.body.rotation();
    c.tx = t.x; c.ty = t.y; c.tz = t.z;   /* кэш для npcCheckImpacts (0 wasm-вызовов там) */
