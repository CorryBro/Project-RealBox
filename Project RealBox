    const ip = world.integrationParameters;
    if (ip && 'numSolverIterations' in ip) ip.numSolverIterations = 10;
  } catch(e){ console.warn('integrationParameters setup failed', e); }
  /* большая плоскость земли, верх на уровне воксельного пола (y=S) */
  world.createCollider(RAPIER.ColliderDesc.cuboid(GROUND_SIZE/2, .5, GROUND_SIZE/2).setTranslation(0, S-.5, 0).setFriction(.9));
  voxBody = world.createRigidBody(RAPIER.RigidBodyDesc.fixed());
}
const VOX_PHYS_RADIUS = 16;     /* радиус вокруг игрока (м), в котором создаются коллайдеры */
