/* ---------- луч по цилиндру NPC (для hitscan) ---------- */
function rayHitNPC(origin, dir, maxD){
  let bestN = null, bestT = Infinity, bestPoint = null, bestHead = false;
  /* v14: капсула попаданий — ВЫСОТА по росту NPC (160–200 см), РАДИУС
     постоянный .32: тело в ширину у всех одинаковое (см. РОСТ v14) —
     по низкому стреляем точно, по высокому тоже, обманных промахов
     из-за «толстого» хитбокса нет */
  for (const n of npcs) {
    if (!n.alive || n.ragdoll || !n.body) continue;
    const s = n.bodyScale || 1;
    const R = .32, HH = .925*s - .32;   /* радиус постоянен, полувысота = рост NPC (капсула 0..1.85*s от ног) */
    const t = n.body.translation();
    const cx = t.x, cy = t.y, cz = t.z;
    const ox = origin.x - cx, oy = origin.y - cy, oz = origin.z - cz;
    const dx = dir.x, dy = dir.y, dz = dir.z;
    let bestT2 = Infinity;
    /* цилиндр */
    const a = dx*dx + dz*dz;
    if (a > 1e-8) {
      const b = 2*(ox*dx + oz*dz), c = ox*ox + oz*oz - R*R;
      const disc = b*b - 4*a*c;
      if (disc >= 0) {
        const sq = Math.sqrt(disc);
        const t1 = (-b - sq) / (2*a), t2 = (-b + sq) / (2*a);
        for (const tt of [t1, t2]) {
          if (tt > 0 && tt < maxD) {
            const yAt = oy + dy*tt;
            if (Math.abs(yAt) <= HH) { if (tt < bestT2) bestT2 = tt; }
          }
        }
      }
    }
    /* торцевые сферы */
    const sphere = (sy) => {
      const bx = ox, by = oy - sy, bz = oz;
      const b = 2*(bx*dx + by*dy + bz*dz), c = bx*bx + by*by + bz*bz - R*R;
      const disc = b*b - 4*c;
      if (disc < 0) return Infinity;
      const tt = (-b - Math.sqrt(disc)) / 2;
      return (tt > 0 && tt < maxD) ? tt : Infinity;
    };
    const ts = Math.min(sphere(HH), sphere(-HH));
    if (ts < bestT2) bestT2 = ts;
    if (bestT2 < Infinity && bestT2 < bestT) {
      /* проверка LOS — нет ли стены на пути */
      const point = origin.clone().addScaledVector(dir, bestT2);
      const wall = rayVoxels(origin, dir, bestT2 - .05);
      if (wall) continue;
      bestT = bestT2; bestN = n; bestPoint = point;
      /* v28: ХЕДШОТ-детект — верхняя полусфера капсулы (голова+шея):
         точка попадания выше оси верхней сферы минус 2см */
      bestHead = (oy + dy*bestT2) > HH - .02;
    }
  }
  if (!bestN) return null;
  return { npc: bestN, point: bestPoint, dist: bestT, head: bestHead };
}

