        const fvy = cl(Math.max(2.5, dy/dist * power * .9 * k + power * .6 * k), -12, 34);
        const fvz = cl(dz/dist * power * 1.6 * k, -34, 34);
        const flyVel = { x: fvx, y: fvy, z: fvz };
        damageNPC(n, dmg, new THREE.Vector3(t.x, t.y, t.z), flyVel);
      }
    }
  }
  /* толчок игрока */
  if (!playerDead) {
    const pd = player.pos.clone().setY(player.pos.y + .8).sub(pos);
    const pdl = pd.length();
    if (pdl < radius * 2) {
      const k = 1 - pdl/(radius * 2);
      player.vel.addScaledVector(pd.normalize(), power * k * .8);
      player.vel.y += power * k * .4;
      player.onGround = false;
      damagePlayer(Math.round(k * 12));
      addShake((opts.shake || .25) * Math.max(.3, k));
    }
  }
}

/* ---------- урон по NPC + flee AI ---------- */
function damageNPC(n, dmg, hitPos, flyVel, isHead){
  if (!n.alive) return;
  if (isHead) dmg = 999;   /* v28: голова — насмерть с одной пули (защита от будущих вызовов) */
  n.hp -= dmg; sfx.npcHurt();
  if (hitPos) dust(hitPos, 0xc0392b, 3);
  /* помечаем «испуган» — flee AI сработает в npcUpdate */
  n.alertT = 5 + Math.random()*3;
  n.fleeT = 4 + Math.random()*2.5;
  n.lastPlayerPos = player.pos.clone();
  n.fleeJit = (Math.random()-.5)*.6;   /* личный угол отклонения при бегстве (мягче) */
  if (n.hp <= 0) {
    n.hp = 0; n.alive = false; n.dieT = 0;
    const impactVel = flyVel || { x: 0, y: 0, z: 0 };
    /* перейти в ragdoll с реальной скоростью (отлетает) */
    npcRagdollize(n, impactVel, hitPos || new THREE.Vector3(n.pos.x, n.pos.y + .9*(n.bodyScale || 1), n.pos.z));
    sfx.death();
  } else {
    /* жив — но в панике убегает (flee AI в npcUpdate) */
  }
}

/* ---------- урон по игроку ---------- */
let playerHP = 100, playerDead = false;
function damagePlayer(dmg){
  if (playerDead) return;
  if (dev.god) return;   /* v29: бессмертие — урон не проходит */
  playerHP = Math.max(0, playerHP - dmg);
  sfx.hurt(); vib(20);
  addShake(.18 + dmg * .012);
  if (playerHP <= 0) {
    playerDead = true;
    sfx.death(); vib(80);
    toast('Вы погибли. Пауза…');
    setTimeout(() => pauseGame(), 800);
  }
}

/* ---------- fire dispatcher ---------- */
let fireHeldWeapon = false;
let fireDbgWhy = '';   /* v30: тест-хук — почему tryFire отказал (пусто = выстрелил) */
function tryFire(){
  if (state !== 'playing' || playerDead) { fireDbgWhy = 'state/dead'; return; }
  if (dev.freeCam) { fireDbgWhy = 'freeCam'; return; }   /* v29: в свободной камере огонь выключен */
  const w = weapons[cur]; if (w.cdT > 0 || switchT > 0) { fireDbgWhy = 'cdT=' + w.cdT.toFixed(3) + ' switchT=' + switchT.toFixed(3); return; }
  if (cur === 0 || cur === 2) {
    if (reloadT > 0) return;
    if (w.mag <= 0) { sfx.empty(); startReload(); return; }
    if (!dev.infAmmo) w.mag--;   /* v29: ∞ патроны — не тратим */
    w.cdT = w.cd;
    bodySnapT = Math.max(bodySnapT, .4);   /* v17: при выстреле тело быстро доворачивается к цели */
    if (cur === 0) firePistol(); else fireM4();
    updateAmmoUI();
    if (w.mag === 0) setTimeout(() => { if (state === 'playing' && (cur === 0 || cur === 2) && weapons[cur].mag === 0 && reloadT <= 0) startReload(); }, 350);
  } else if (cur === 1) {
    /* v17: нажал — ЗАМАХ, отпустил — БРОСОК (полёт в updateWeapon/throwGrenadeLaunch) */
    w.cdT = 0;
    bodySnapT = Math.max(bodySnapT, .35);
    grenHoldBegin();
  } else if (cur === 3) {
    /* v30: КУЛАКИ — удар чередует руки (правый → левый); ЛКМ можно ДЕРЖАТЬ —
       удары цепляются сами (автоцеп в updateWeapon) */
    if (punchT > 0 || switchT > 0) { fireDbgWhy = 'punchT=' + punchT.toFixed(3) + ' switchT=' + switchT.toFixed(3); return; }
    w.cdT = w.cd;
    punchT = PUNCH_T; punchSide ^= 1; punchHitDone = false;
    bodySnapT = Math.max(bodySnapT, .25);
    sfx.whoosh();
  }
}

/* ---------- update weapon (cooldown, reload, anim ствола в руке) ---------- */
function updateWeapon(dt){
  for (const w of weapons) if (w.cdT > 0) w.cdT -= dt;
  if (switchT > 0) switchT -= dt;
  /* v17: машина броска гранаты — замах (hold) → отрыв в середине взмаха → возврат */
  if (grenHold) grenWindT = Math.min(grenWindT + dt, 10);
  else if (grenThrowT <= 0) grenWindT = Math.max(0, grenWindT - dt*3.2);   /* отмена — рука плавно возвращается */
  if (grenThrowT > 0) {
    const prevT = grenThrowT;
    if (grenDbgTt < 0) grenThrowT = Math.max(0, grenThrowT - dt);   /* v20: тест-заморозка фазы не двигает таймер */
    if (!grenLaunched && grenThrowT <= GREN_SWING*.60 && prevT > GREN_SWING*.60) {
      /* v21: отрыв на tt=.40 — конец ХЛЫСТА ВПЕРЁД: рука вытянута, локоть
         прямой, кисть на высоте плеча ВПЕРЕДИ — граната срывается ПО
         ГОРИЗОНТАЛИ вперёд «со всей дури», скорость = заряду grenWsRel. */
      grenLaunched = true; grenWindT = 0;   /* v18-фикс: иначе после броска рука СНАПОМ возвращается в замах (ws от несунувшегося ветра) и медленно разматывается — теперь сразу к ношению */
      throwGrenadeLaunch();
    }
  }
  tpGren.visible = (cur === 1) && !(grenLaunched && grenThrowT > 0);   /* в кисти — «следующая» граната (v30: и в свободной камере — игрок с оружием) */
  /* v30: КУЛАКИ — таймер удара + попадание на tt=.40 (рука почти вытянута).
  Заморозка punchDbgTt не двигает таймер (скриншоты фаз). */
  if (punchT > 0) {
    const prevTt = (punchDbgTt >= 0) ? punchDbgTt : 1 - punchT/PUNCH_T;
    if (punchDbgTt < 0) punchT = Math.max(0, punchT - dt);
    const tt = (punchDbgTt >= 0) ? punchDbgTt : 1 - punchT/PUNCH_T;
    if (!punchHitDone && prevTt < PUNCH_HIT_TT && tt >= PUNCH_HIT_TT) { punchHitDone = true; punchImpact(); }
  }
  if (fireHeldWeapon && cur === 3 && state === 'playing' && !playerDead && weapons[3].cdT <= 0 && punchT <= 0) tryFire();   /* v30: зажатая ЛКМ — серия ударов */
  if (bodySnapT > 0) bodySnapT = Math.max(0, bodySnapT - dt);
  if (reloadT > 0) { reloadT -= dt; if (reloadT <= 0) { weapons[cur].mag = weapons[cur].magSize; reloadT = 0; refreshHUD(); } }
  if (muzT > 0) { muzT -= dt; if (muzT <= 0) { muzFlash.visible = false; muzFlashM.visible = false; } }
  /* slide animation глока — теперь на стволе в руке */
  if (pistolSlideT > 0) {
    pistolSlideT -= dt * 5;
    if (pistolSlideT < 0) pistolSlideT = 0;
  }
  const slideGrp = tpPistol.children[1];
  if (slideGrp) slideGrp.position.z = -.075 - pistolSlideT * .045;
  recoil *= Math.exp(-7*dt);
  /* automatic fire for M4 (если зажат ЛКМ) */
  if (fireHeldWeapon && cur === 2 && state === 'playing' && !playerDead) {
    if (weapons[2].cdT <= 0 && weapons[2].mag > 0 && reloadT <= 0 && switchT <= 0) tryFire();
  }
  /* auto-reload prompt */
  updateAmmoUI();
}

