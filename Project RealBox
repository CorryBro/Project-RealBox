        else if (tt < .44) { pw = 1; ex2 = Math.pow(smc2((tt-.16)/.28), 2.2); }   /* удар: разгон — взрыв в конце */
        else if (tt < .58) { pw = 1; ex2 = 1; }                     /* фиксация: рука вытянута */
