   Реально стек заливки не превышает числа ЖИВЫХ вокселей, поэтому теперь это
   обычный растущий массив: работает так же (colStack[sp++] / colStack[--sp]),
   но занимает килобайты, а не сотни МБ. Типизированный вариант при выходе за
   размер молча терял бы клетки (порченная заливка) — массив растёт сам. */
const colStack = [];
const colStack2 = [];
const COL_RADIUS = 30;     /* радиус обследования обрушения вокруг каждой точки интереса (вокселей) */
const collapseFocus = [];  /* точки интереса: места разрушений — обрушение считается и там, а не только вокруг игрока */
let collapseCenterX = -999, collapseCenterZ = -999;   /* центр последнего прохода — «обрушение при подходе игрока» */
function addCollapseFocus(wx, wz){
  collapseFocus.push({ gx: wx/S, gz: wz/S, t: performance.now() });
  if (collapseFocus.length > 10) collapseFocus.shift();
}
/* новый штамп эпохи с защитой от переполнения int32 (штампы растут на каждую
   заливку — раз в ~месяцы непрерывной игры один раз очищаем массив, 2-5мс) */
function nextEpoch(){
  if (colEpoch > 1073741824) { colStamp.fill(0); colEpoch = 0; }
  return (colEpoch += 2);
}

/* стартовая разметка: всё, что связано с опорным слоем y=1 — «стоит».
   Вызывается один раз после генерации деревни (в момент загрузки). */
function markAllGrounded(){
  colG.fill(0);
  /* colStamp НЕ очищаем и эпохи НЕ сбрасываем: штампы монотонно растут,
     старые значения всегда < текущих — ложных совпадений не бывает
     (защита от переполнения int32 осталась в nextEpoch). На большой карте
     fill(0) по 48М клеток комитил бы ~190МБ памяти разом. */
  const AREA = VW*VD;
  let sp = 0;
  for (let z = 0; z < VD; z++) for (let x = 0; x < VW; x++) {
    const i = vIdx(x, 1, z);
    if (grid[i] && !colG[i]) { colG[i] = 1; colStack[sp++] = i; }
  }
  while (sp > 0) {
    const j = colStack[--sp];
    const jy = (j/AREA)|0, jr = j - jy*AREA, jz = (jr/VW)|0, jx = jr - jz*VW;
    if (jx>0)        { const k=j-1;    if (grid[k] && !colG[k]) { colG[k]=1; colStack[sp++]=k; } }
    if (jx<VW-1)     { const k=j+1;    if (grid[k] && !colG[k]) { colG[k]=1; colStack[sp++]=k; } }
    if (jz>0)        { const k=j-VW;   if (grid[k] && !colG[k]) { colG[k]=1; colStack[sp++]=k; } }
    if (jz<VD-1)     { const k=j+VW;   if (grid[k] && !colG[k]) { colG[k]=1; colStack[sp++]=k; } }
    if (jy>1)        { const k=j-AREA; if (grid[k] && !colG[k]) { colG[k]=1; colStack[sp++]=k; } }
    if (jy<VH-1)     { const k=j+AREA; if (grid[k] && !colG[k]) { colG[k]=1; colStack[sp++]=k; } }
  }
}

/* ТОЧНАЯ инвалидация после удаления клеток из grid: компонент(ы), содержавшие
   соседей удалённых клеток, могли потерять путь к земле — полностью очищаем их
   метки colG (заливкой по стоящим клеткам, независимо от старых меток).
   Компонент, у которого нашлась связь с y=1 прямо в этой заливке, остаётся/
   становится «стоит» (бесплатная перепроверка). Вызывается из destroySphere
   СРАЗУ после обнуления клеток — обрушение затем решает обычный проход
   (батчинг нескольких выстрелов в один проход сохранён). */
function invalidateGrounded(cells){
  const AREA = VW*VD;
  const ep = nextEpoch();          /* штамп этой инвалидации */
  for (let ci = 0; ci < cells.length; ci++) {
    const [x, y, z] = cells[ci];
    for (const [dx, dy, dz] of DIRS) {
      const nx = x+dx, ny = y+dy, nz = z+dz;
      if (nx<0 || nz<0 || nx>=VW || nz>=VD || ny<1 || ny>=VH) continue;
      const n = vIdx(nx, ny, nz);
      /* стартуем только с ПОМЕЧЕННОГО соседа: непомеченный и так кандидат на
         проверку в проходе (повторная заливка на каждый выстрел не нужна —
         серия выстрелов по дому больше не обходит компонент сотни раз) */
      if (!grid[n] || colG[n] !== 1 || colStamp[n] === ep) continue;
      /* заливка компонента от соседа: если дойдём до y=1 — стоит (метки живы),
         иначе — компонент мог потерять опору: снимаем метки, проход решит судьбу */
      let sp = 0, grounded = false;
      const fl = ep + 1;
      colStack2.length = 0;
      const push = k => {
        if (!grid[k]) return;
        const s = colStamp[k];
        if (s === ep) return;
        const ky = (k/AREA)|0;
        if (ky === 1) { grounded = true; return; }
        if (s === fl) return;
        colStamp[k] = fl; colStack[sp++] = k; colStack2.push(k);
      };
      colStack[sp++] = n; colStamp[n] = fl; colStack2.push(n);
      const ny2 = (n/AREA)|0;
      if (ny2 === 1) grounded = true;
      while (sp > 0 && !grounded) {
        const j = colStack[--sp];
        const jy = (j/AREA)|0, jr = j - jy*AREA, jz = (jr/VW)|0, jx = jr - jz*VW;
        if (jx>0) push(j-1); if (jx<VW-1) push(j+1);
        if (jz>0) push(j-VW); if (jz<VD-1) push(j+VW);
        if (jy>1) push(j-AREA); if (jy<VH-1) push(j+AREA);
      }
      if (grounded) {
        /* стоит: все посещённые — валидные метки */
        for (let k2 = 0; k2 < colStack2.length; k2++) { colG[colStack2[k2]] = 1; colStamp[colStack2[k2]] = ep; }
      } else {
        /* мог потерять опору: снимаем метки (кандидаты на обрушение) */
        for (let k2 = 0; k2 < colStack2.length; k2++) { colG[colStack2[k2]] = 0; colStamp[colStack2[k2]] = ep; }
      }
    }
  }
}

function collapsePass(){
  const now = performance.now();
  while (collapseFocus.length && now - collapseFocus[0].t > 20000) collapseFocus.shift();
  /* боксы обследования: вокруг игрока (всегда) + вокруг недавних разрушений */
  const cx0 = Math.floor(player.pos.x/S), cz0 = Math.floor(player.pos.z/S);
  const boxes = [{ gx: cx0, gz: cz0 }];
  for (const f of collapseFocus) {
    if (Math.abs(f.gx-cx0) < COL_RADIUS && Math.abs(f.gz-cz0) < COL_RADIUS) continue;   /* уже покрыто боксом игрока */
    boxes.push({ gx: Math.floor(f.gx), gz: Math.floor(f.gz) });
  }
  for (const b of boxes) {
    b.x0 = Math.max(0, b.gx-COL_RADIUS); b.x1 = Math.min(VW-1, b.gx+COL_RADIUS);
    b.z0 = Math.max(0, b.gz-COL_RADIUS); b.z1 = Math.min(VD-1, b.gz+COL_RADIUS);
  }
  /* ОПТИМИЗАЦИЯ «ПАМЯТЬ ОПОРЫ»: кандидат на проверку — только клетка БЕЗ метки
     colG. Нетронутые структуры заливкой не обходятся ВООБЩЕ (раньше каждый
     проход при ходьбе перезаливал все структуры в боксе игрока — это и были
     проседания при ходьбе). Семантика прежняя (см. markAllGrounded): заливка
     от кандидента не ограничена боксом, ранний выход на y=1 или метку. */
  const AREA = VW*VD;
  let fallen = 0;
  for (const b of boxes) {
    for (let y=2; y<VH; y++) for (let z=b.z0; z<=b.z1; z++) for (let x=b.x0; x<=b.x1; x++) {
    const i = vIdx(x,y,z);
    if (!grid[i] || colG[i]) continue;         /* стоит (проверено ранее) — НЕ трогаем */
    /* локальная заливка компонента от кандидата */
    let sp = 0, grounded = false;
    const fl = nextEpoch() + 1;   /* метка «в заливке» (уникальна на каждую заливку) */
    const push = k => {
      if (!grid[k]) return;
      if (colG[k] === 1) { grounded = true; return; }   /* сосед УЖЕ проверен как grounded → и мы стоим */
      if (colStamp[k] === fl) return;                   /* уже в этой заливке */
      const ky = (k/AREA)|0;
      if (ky === 1) { grounded = true; return; }        /* коснулись опорного слоя — СТОИТ */
      colStamp[k] = fl; colStack[sp++] = k; colStack2.push(k);
    };
    colStack[sp++] = i; colStamp[i] = fl; colStack2.length = 0; colStack2.push(i);
    while (sp > 0 && !grounded) {
      const j = colStack[--sp];
      const jy = (j/AREA)|0, jr = j - jy*AREA, jz = (jr/VW)|0, jx = jr - jz*VW;
      if (jx>0) push(j-1); if (jx<VW-1) push(j+1);
      if (jz>0) push(j-VW); if (jz<VD-1) push(j+VW);
      if (jy>1) push(j-AREA); if (jy<VH-1) push(j+AREA);
    }
    if (grounded) {
      /* все посещённые клетки связаны со стартом, старт — с опорой → grounded.
         Метка ПЕРСИСТЕНТНАЯ: следующий проход эти клетки даже не посмотрит. */
      for (let ci = 0; ci < colStack2.length; ci++) colG[colStack2[ci]] = 1;
      continue;
    }
    /* плавающий компонент: ВСЕ клетки colStack2 — одно тело, без разбиений */
    const cells = [];
    for (let ci = 0; ci < colStack2.length; ci++) {
      const j = colStack2[ci];
      const jy = (j/AREA)|0, jr = j - jy*AREA, jz = (jr/VW)|0, jx = jr - jz*VW;
      cells.push([jx, jy, jz, grid[j]]);
    }
    for (const [cx2,cy2,cz2] of cells) grid[vIdx(cx2,cy2,cz2)] = 0;
    fallen += cells.length;
    afterRemove(cells);
    for (const [cx2,cy2,cz2] of cells) markDirtyAround(cx2,cy2,cz2);
    spawnCluster(cells);   /* ЛЮБОЙ размер одним кластером: даже весь дом — один гигант */
  }
  }
  if (fallen > 0) {
    if (fallen > 2) { sfx.rumble(); addShake(Math.min(.35, fallen*.03)); }
  }
  /* ОПТИМИЗАЦИЯ: фокус-точки обслуживания выполнены — все их боксы просмотрены
     в ЭТОМ проходе (глобальный посев + заливка + скан боксов). Держать их 20с
     и пересканировать каждые 0.15с бессмысленно: новое разрушение ВСЕГДА
     добавляет новую фокус-точку (destroySphere), а живое обрушение само
     пометит dirty. На слабом железе до 10 лишних боксов×165к клеток скана
     каждые 0.15с — это и были рывки при стрельбе по большим обломкам. */
  collapseFocus.length = 0;
  collapseDirty = false;
  collapseCenterX = cx0; collapseCenterZ = cz0;
}

/* ============================================================
   ЧАСТИЦЫ (пыль, искры, кровь-куски)
   ============================================================ */
function makeGlowTex(){
  const c = document.createElement('canvas'); c.width = c.height = 64;
  const g = c.getContext('2d');
  const gr = g.createRadialGradient(32,32,0,32,32,32);
  gr.addColorStop(0, 'rgba(255,255,255,1)');
  gr.addColorStop(.35, 'rgba(255,255,255,.7)');
  gr.addColorStop(1, 'rgba(255,255,255,0)');
  g.fillStyle = gr; g.fillRect(0, 0, 64, 64);
  return new THREE.CanvasTexture(c);
}
const glowTex = makeGlowTex();
const PCAP = 900;
const pGeo = new THREE.BufferGeometry();
const pPos = new Float32Array(PCAP*3), pCol = new Float32Array(PCAP*3);
pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
pGeo.setAttribute('color', new THREE.BufferAttribute(pCol, 3));
const points = new THREE.Points(pGeo, new THREE.PointsMaterial({ size:.14, map:glowTex, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending, vertexColors:true }));
points.frustumCulled = false; scene.add(points);
points.renderOrder = 30;   /* поверх облаков (частицы ближе камеры) */
points.matrixAutoUpdate = false; points.updateMatrix();
const pVel = new Float32Array(PCAP*3), pLife = new Float32Array(PCAP), pGrav = new Float32Array(PCAP), pFree = [];
for (let i = PCAP-1; i >= 0; i--) { pFree.push(i); pPos[i*3+1] = -999; }
function spawnPart(px, py, pz, vx, vy, vz, color, life, grav){
  if (!pFree.length) return;
  const i = pFree.pop(), i3 = i*3;
  pPos[i3] = px; pPos[i3+1] = py; pPos[i3+2] = pz;
  pVel[i3] = vx; pVel[i3+1] = vy; pVel[i3+2] = vz;
  pLife[i] = life; pGrav[i] = grav;
  _col.set(color); pCol[i3] = _col.r; pCol[i3+1] = _col.g; pCol[i3+2] = _col.b;
}
let pAnyActive = false;   /* был ли кадр с живыми частицами — для финальной загрузки «пустого» буфера */
function updateParticles(dt){
  let active = 0;
  for (let i = 0; i < PCAP; i++) {
    if (pLife[i] <= 0) continue;
    active++;
    const i3 = i*3;
    pLife[i] -= dt;
    if (pLife[i] <= 0) { pFree.push(i); pPos[i3+1] = -999; pCol[i3] = pCol[i3+1] = pCol[i3+2] = 0; continue; }
    pVel[i3+1] -= pGrav[i]*dt;
    pPos[i3] += pVel[i3]*dt; pPos[i3+1] += pVel[i3+1]*dt; pPos[i3+2] += pVel[i3+2]*dt;
    pCol[i3] *= (1 - dt*2.2); pCol[i3+1] *= (1 - dt*2.6); pCol[i3+2] *= (1 - dt*3);
  }
  /* ОПТИМИЗАЦИЯ: буферы в GPU грузятся ТОЛЬКО когда частицы есть (или только что
     кончились — один финальный кадр). Пустой кадр = ноль аплоадов и ноль draw call. */
  if (active > 0 || pAnyActive) {
    pGeo.attributes.position.needsUpdate = true; pGeo.attributes.color.needsUpdate = true;
  }
  pAnyActive = active > 0;
  points.visible = active > 0;
}
function dust(pos, color, n){
  const k = Q().part;
  for (let i=0; i<n*k; i++)
    spawnPart(pos.x, pos.y, pos.z, (Math.random()-.5)*3, Math.random()*2.5, (Math.random()-.5)*3, color, .4+Math.random()*.3, 7);
}
function sparks(pos, n){
  for (let i=0; i<n; i++)
    spawnPart(pos.x, pos.y, pos.z, (Math.random()-.5)*6, Math.random()*4+1, (Math.random()-.5)*6, 0xffa64d, .12+Math.random()*.15, 10);
}
let shakeMag = 0;
let fovKick = 0;   /* мгновенный «толчок» FOV от взрыва (гаснет ~0.5с) */
function addShake(v){ if (settings.shake) shakeMag = Math.min(.9, shakeMag + v); }

const LAMP_POSTS = [];   /* {x,y,z} (world coords) */
const LAMP_LIGHTS = [];
function buildVillage(){
  /* ЧИСТАЯ ПЛОЩАДКА: плоская трава визуально — ВИРТУАЛЬНЫЙ ПОЛ (v10, одна
     плоскость с текстурой вместо 774 400 вокселей — см. makeFloor), никакой
     генерации зданий/мебели/фонарей/колодца. Механика переноса построек из
     другой игры (текст 📋) УДАЛЕНА по просьбе игрока — это была заглушка. */
  grid.fill(0);
  for (const L of LAMP_LIGHTS) scene.remove(L.L);
  LAMP_LIGHTS.length = 0;
  LAMP_POSTS.length = 0;
  markAllGrounded();               /* «ПАМЯТЬ ОПОРЫ»: стартовая разметка стоящих структур */
  markAllDirty();
}

/* ============================================================
   НАВИГАЦИЯ — A* по воксельной сетке (без Recast, лёгкая и
   работает напрямую с динамическим миром)
   ============================================================ */
function walkableCell(x, y, z){
  if (!getVox(x,y,z) && !getVox(x,y+1,z) && (getVox(x,y-1,z) || y === 1)) {   /* y===1 — виртуальный пол-трава (v10) */
    /* также проверяем: не занята ли ячейка динамическим телом (обломком, кластером) */
    const i = vIdx(x,y,z);
    if (dynBlocked.has(i)) return false;
    return true;
  }
  return false;
}
/* множество вокселей, занятых динамическими телами — обновляем периодически */
const dynBlocked = new Set();
let dynBlockedT = 0;
function updateDynBlocked(dt){
  dynBlockedT -= dt;
  if (dynBlockedT > 0) return;
  dynBlockedT = .25;   /* ↑ было .5 — теперь чаще, чтобы NPC быстрее реагировали на свежие обломки */
  dynBlocked.clear();
  /* debris: пометить воксель где тело */
  for (const d of debris) {
    if (d.grabbed || d.removed) continue;
    const t = d.body.translation();
    if (!Number.isFinite(t.x) || !Number.isFinite(t.y) || !Number.isFinite(t.z)) continue;
    const gx = Math.floor(t.x / S), gy = Math.floor(t.y / S), gz = Math.floor(t.z / S);
    for (let dy = 0; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++) for (let dz = -1; dz <= 1; dz++) {
      const x = gx + dx, y = gy + dy, z = gz + dz;
      if (x>=0 && y>=1 && y<VH-1 && z>=0 && x<VW && z<VD) dynBlocked.add(vIdx(x,y,z));
    }
  }
  /* кластеры: пометить воксели всех коллайдеров (упрощённо — центр тела) */
  for (const c of clusters) {
    if (c.dead || c.held) continue;
    const t = c.body.translation();
    if (!Number.isFinite(t.x) || !Number.isFinite(t.y) || !Number.isFinite(t.z)) continue;
    const gx = Math.floor(t.x / S), gy = Math.floor(t.y / S), gz = Math.floor(t.z / S);
    const ex = Math.ceil(c.ex / S), ey = Math.ceil(c.ey / S), ez = Math.ceil(c.ez / S);
    for (let dy = -ey; dy <= ey; dy++) for (let dx = -ex; dx <= ex; dx++) for (let dz = -ez; dz <= ez; dz++) {
      const x = gx + dx, y = gy + dy, z = gz + dz;
      if (x>=0 && y>=1 && y<VH-1 && z>=0 && x<VW && z<VD) dynBlocked.add(vIdx(x,y,z));
    }
  }
  /* ragdoll-части (трупы): тоже пометить, чтобы NPC обходили трупы а не шли сквозь них */
  for (const n of npcs) {
    if (!n.ragdoll || !n.ragdollBodies) continue;
    for (const k in n.ragdollBodies) {
      const b = n.ragdollBodies[k];
      if (!b) continue;
      let t;
      try { t = b.translation(); } catch(e){ continue; }
      if (!Number.isFinite(t.x) || !Number.isFinite(t.y) || !Number.isFinite(t.z)) continue;
      const gx = Math.floor(t.x / S), gy = Math.floor(t.y / S), gz = Math.floor(t.z / S);
      for (let dy = 0; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++) for (let dz = -1; dz <= 1; dz++) {
        const x = gx + dx, y = gy + dy, z = gz + dz;
        if (x>=0 && y>=1 && y<VH-1 && z>=0 && x<VW && z<VD) dynBlocked.add(vIdx(x,y,z));
      }
    }
  }
}
/* ОПТИМИЗАЦИЯ GC: типизированные массивы вместо {item,pri}-объектов.
   Раньше каждый A* (12 жителей ~6 раз/сек) аллоцировал тысячи маленьких
   объектов в куче — это регулярные minor-GC и те самые «проседания на месте». */
class MinHeap {
  constructor(){ this.items = new Int32Array(1024); this.pris = new Float64Array(1024); this.n = 0; }
  get size(){ return this.n; }
  _grow(){
    const ni = new Int32Array(this.items.length*2), np = new Float64Array(this.pris.length*2);
    ni.set(this.items); np.set(this.pris); this.items = ni; this.pris = np;
  }
  push(item, pri){
    if (this.n >= this.items.length) this._grow();
    let i = this.n++;
    this.items[i] = item; this.pris[i] = pri;
    while (i > 0) {
      const p = (i-1)>>1;
      if (this.pris[i] < this.pris[p]) {
        const ti = this.items[i]; this.items[i] = this.items[p]; this.items[p] = ti;
        const tp = this.pris[i]; this.pris[i] = this.pris[p]; this.pris[p] = tp;
        i = p;
      } else break;
    }
  }
  pop(){
    if (!this.n) return null;
    const top = this.items[0];
    const last = --this.n;
    if (this.n) {
