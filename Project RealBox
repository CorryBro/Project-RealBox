    } else { punchExW = 0; punchWindW = 0; }
    ud.armR.rotation.x  = ud.armR.rotation.x*(1-b)  + Rx*b;
    ud.armR.rotation.z  = ud.armR.rotation.z*(1-b)  + Rz*b;
    ud.armR.rotation.y  = (AP && (cur === 0 || cur === 2)) ? AP.aRy*adsW : ay*b;   /* v30: aRy — скрутка плеча (граната/кулаки) */
    ud.forearmR.rotation.x = ud.forearmR.rotation.x*(1-b) + Fx*b;
    const lb = (cur === 1 || cur === 3) ? b : b * P.wl;   /* граната/кулаки: левая тоже под управлением */
    if (lb > .004) {
