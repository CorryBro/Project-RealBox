function applyQuality(){
  const q = Q();
  renderer.setPixelRatio(Math.min(devicePixelRatio, q.dpr));
  renderer.shadowMap.enabled = settings.shadows;
  /* качество теней: размер карты подбирается под разрешение — normalBias
     масштабируется под тексель (мелкая карта = крупнее тексель = нужен больший
     сдвиг по нормали, иначе «акне» поверхностей) */
  const sq = SHADOW_QUAL[settings.shadowQual] || 2048;
  sun.shadow.mapSize.set(sq, sq);
  const texel = 128 / sq;   /* фруст ±64м */
  sun.shadow.normalBias = Math.min(.09, Math.max(.025, texel * 1.4));
  if (sun.shadow.map) { sun.shadow.map.dispose(); sun.shadow.map = null; }
  scene.traverse(o => { if (o.material) o.material.needsUpdate = true; });
  applySize();
  updateCelestial();   /* мгновенно применить castShadow под текущее время суток */
