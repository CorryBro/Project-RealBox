/* полный сброс рендера мира (перегенерация деревни): всё в дальний режим */
function resetWorldRender(){
  for (const ch of chunks) {
    ch.rec = null;              /* диапазоны обнулит compact ниже */
    ch.glowCells = null;
    disposeDetailed(ch);
    ch.dirty = false;
  }
  for (const b of buckets) bucketCompact(b);   /* rec у всех null → бакеты пустеют */
  glowDirtyFlag = true;
}
/* стартовая сборка ВСЕГО дальнего слоя с прогресс-баром (для загрузки) */
async function buildFarWorldProgress(){
  const cW = VW/2, cD = VD/2;
  const order = chunks.slice().sort((a,b) => {
    const da = (a.cx*CSZ+CSZ/2-cW)**2 + (a.cz*CSZ+CSZ/2-cD)**2;
    const db = (b.cx*CSZ+CSZ/2-cW)**2 + (b.cz*CSZ+CSZ/2-cD)**2;
    return da - db;
  });
  let done = 0;
  const t0 = performance.now();
  while (done < order.length) {
    const tStart = performance.now();
    while (done < order.length && performance.now() - tStart < 14) {
      const ch = order[done++];
      if (ch.far) rebuildFarGreedy(ch);
      ch.dirty = false;
    }
    try {
      $('loadText').textContent = 'Построение мира… ' + Math.round(done/order.length*100) + '%';
      document.querySelector('#loadBar i').style.width = (50 + 45*done/order.length) + '%';
    } catch(e){}
    await new Promise(r => setTimeout(r, 0));
  }
  return performance.now() - t0;
}

/* ============================================================
   ВИДОКУБ-ФИЗИКА — только коллайдеры рядом с игроком
   ============================================================ */
let world = null, voxBody = null;
const voxCols = new Map();
let lastPhysX = -999, lastPhysZ = -999;
function physInit(){
  world = new RAPIER.World({ x:0, y:-22, z:0 });
  world.timestep = 1/60;
