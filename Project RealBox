/* ОПТИМИЗАЦИЯ РЕНДЕРА ТЕЛ: раньше каждая часть тела = 3-4 отдельных меша
   (бедро+голень+ботинок...) со своими материалами — 19 draw calls на жителя
   и столько же в теневом проходе, плюс свой материал на глаза каждому NPC.
   Теперь все боксы ЖЁСТКОЙ части слиты в ОДИН меш с цветом в вершинах,
   материал один общий (BODY_MAT): 6 draw calls на живого, 10 на труп,
   переключений материала ноль. Геометрия/размеры/цвета — 1-в-1 как было. */
const BODY_MAT = new THREE.MeshLambertMaterial({ vertexColors: true });
const EYE_COLOR = new THREE.Color(0x222222);
/* boxes: [{w,h,d,x,y,z,c:THREE.Color}] → ОДИН Mesh (1 draw call) */
function makeBodyMesh(boxes){
  const nb = boxes.length;
  const pos = new Float32Array(nb*72), nrm = new Float32Array(nb*72), col = new Float32Array(nb*72);
  const idx = new Uint32Array(nb*36);
  let v = 0, fi = 0;
  for (let bi=0; bi<nb; bi++){
    const b = boxes[bi];
    const x0=b.x-b.w/2, x1=b.x+b.w/2, y0=b.y-b.h/2, y1=b.y+b.h/2, z0=b.z-b.d/2, z1=b.z+b.d/2;
    const r=b.c.r, g2=b.c.g, bl=b.c.b;
    for (let f=0; f<6; f++){
      const D = BOX_FACES[f], C = D[3];
      for (let c=0; c<4; c++){
        const P = C[c], v3 = v*3;
        pos[v3]   = P[0] ? x1 : x0;
        pos[v3+1] = P[1] ? y1 : y0;
        pos[v3+2] = P[2] ? z1 : z0;
        nrm[v3] = D[0]; nrm[v3+1] = D[1]; nrm[v3+2] = D[2];
        col[v3] = r; col[v3+1] = g2; col[v3+2] = bl;
        v++;
      }
      idx[fi]=v-4; idx[fi+1]=v-3; idx[fi+2]=v-2;
      idx[fi+3]=v-4; idx[fi+4]=v-2; idx[fi+5]=v-1;
      fi += 6;
    }
  }
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(pos,3));
  geo.setAttribute('normal', new THREE.BufferAttribute(nrm,3));
  geo.setAttribute('color', new THREE.BufferAttribute(col,3));
  geo.setIndex(new THREE.BufferAttribute(idx,1));
  geo.computeBoundingSphere();
  const m = new THREE.Mesh(geo, BODY_MAT);
  m.castShadow = true;
  return m;
}

/* v29: ЖЕНСКИЕ ЖИТЕЛИ + КАСТОМНЫЕ ЦВЕТА. Сигнатура расширена:
   buildVillagerModel(rng, o) — o (опционально) = ПОЛНЫЙ явный конфиг
   игрока из редактора; без o — случайный житель (М/Ж 50/50).
   o = { skinIdx 0..8, skinHex '#..', female true/false, breast 0..4,
         pantsIdx/shirtIdx (индексы в пуле СВОЕГО пола), pantsHex/shirtHex,
         hairColIdx 0..7, hairHex, hairStyle (индекс в пуле своего пола),
         heightCm }. Кастомный hex всегда важнее индекса. */
const _tmpCol = new THREE.Color();
function buildVillagerModel(rng, o){
  o = o || {};
  const root = new THREE.Group();
  /* ---- цвет кожи: кастом > явный индекс > случайный ---- */
  const skinC = (typeof o.skinHex === 'string' && /^#[0-9a-fA-F]{6}$/.test(o.skinHex))
    ? _tmpCol.set(o.skinHex).clone()
    : (Number.isInteger(o.skinIdx) && o.skinIdx >= 0 && o.skinIdx <= 8)
      ? SKIN_COLS[o.skinIdx]
      : SKIN_COLS[Math.floor(rng()*SKIN_COLS.length)];
  /* ---- пол: житель — 50/50; игрок — явный выбор ---- */
  const female = (typeof o.female === 'boolean') ? o.female : (rng() < .5);
  /* ---- грудь 0..4 (только Ж) ---- */
  const breast = female
    ? (Number.isInteger(o.breast) ? Math.max(0, Math.min(4, o.breast)) : Math.floor(rng()*5))
    : 0;
  /* ---- одежда: пул СВОЕГО пола; кастом важнее индекса ---- */
  const pantsArr = female ? CIVIL_PANTS_F : CIVIL_PANTS;
  const shirtArr = female ? CIVIL_SHIRT_F : CIVIL_SHIRT;
  const pantsMat = (typeof o.pantsHex === 'string' && /^#[0-9a-fA-F]{6}$/.test(o.pantsHex))
    ? { color: _tmpCol.set(o.pantsHex).clone() }
    : (Number.isInteger(o.pantsIdx) && o.pantsIdx >= 0 && o.pantsIdx < pantsArr.length)
      ? pantsArr[o.pantsIdx]
      : pantsArr[Math.floor(rng()*pantsArr.length)];
  const shirtMat = (typeof o.shirtHex === 'string' && /^#[0-9a-fA-F]{6}$/.test(o.shirtHex))
    ? { color: _tmpCol.set(o.shirtHex).clone() }
    : (Number.isInteger(o.shirtIdx) && o.shirtIdx >= 0 && o.shirtIdx < shirtArr.length)
      ? shirtArr[o.shirtIdx]
      : shirtArr[Math.floor(rng()*shirtArr.length)];
  /* ---- волосы: кастом > индекс > взвешенный рандом ---- */
  const hairMat = (typeof o.hairHex === 'string' && /^#[0-9a-fA-F]{6}$/.test(o.hairHex))
    ? { color: _tmpCol.set(o.hairHex).clone() }
    : (Number.isInteger(o.hairColIdx) && o.hairColIdx >= 0 && o.hairColIdx < CIVIL_HAIR.length)
      ? CIVIL_HAIR[o.hairColIdx]
      : pickHairMat(rng);
  const pC = pantsMat.color, sC = shirtMat.color, hC = hairMat.color;
  /* ноги — pivot на бедре (y=0.92); БЕДРО и ГОЛЕНЬ — отдельные группы:
     колено СГИБАЕТСЯ в фазе переноса ноги (анимация в npcUpdate).
     СУСТАВЫ-«ГНЁЗДА» (v9): верх бедра заходит В ремень/корпус (+.09),
     низ бедра — на .10 НИЖЕ оси колена, верх голени — на .05 ВЫШЕ оси:
     при любом махе (±45°) и сгибе (до 80°) вращающаяся часть остаётся
     ВНУТРИ гнезда — щели в суставах при ходьбе/беге исключены.
     v29: у женщин бедро/голень ТОНЬШЕ (.14/.115 против .16/.13). */
  const legL = new THREE.Group(), legR = new THREE.Group();
  legL.position.set(-.115, .92, 0); legR.position.set(.115, .92, 0);
  const thigh = { w:female ? .14 : .16, h:.64, d:female ? .15 : .17, x:0, y:-.24, z:0, c:pC };
  legL.add(makeBodyMesh([thigh])); legR.add(makeBodyMesh([{ ...thigh }]));
  /* голень+ботинок: pivot в КОЛЕНЕ (y=-.46 от бедра); голень — ОДИН блок
     (внутри одного бокса щелей не бывает), ботинок — внахлёст на него,
     подошва ровно в y=0 — стопы на земле */
  const shinL = new THREE.Group(), shinR = new THREE.Group();
  shinL.position.set(0, -.46, 0); shinR.position.set(0, -.46, 0);
  const shinBoxes = [
    { w:female ? .115 : .13, h:.40, d:female ? .115 : .13, x:0, y:-.15, z:0, c:pC }  /* голень: верх .05 над осью колена — ВНУТРИ бедра при любом сгибе */
  ];
  shinL.add(makeBodyMesh(shinBoxes)); shinR.add(makeBodyMesh(shinBoxes.map(b => ({ ...b }))));
  /* v21.3: ГОЛЕНОСТОП — ботинок отдельной группой с осью В ЛОДЫЖКЕ (верх
     ботинка, y=-.35 голени; в ботинке центр -.0525 → подошва на .11 ниже
     оси, внахлёст .005 на голень — как раньше). Анимация игрока доворачивает
     стопу ПРОТИВ наклона голени — подошва встаёт параллельно земле в
     опорных позах (присед/приземление/выпад). По умолчанию rotation 0 —
     ботинок «прибит» к голени, как раньше: NPC/редактор/иконки не меняются. */
  const bootL = new THREE.Group(), bootR = new THREE.Group();
  bootL.position.set(0, -.35, 0); bootR.position.set(0, -.35, 0);
  const bootBox = { w:female ? .15 : .16, h:.115, d:female ? .27 : .28, x:0, y:-.0525, z:-.045, c:SHOES.color };
  bootL.add(makeBodyMesh([bootBox])); bootR.add(makeBodyMesh([{ ...bootBox }]));
  shinL.add(bootL); shinR.add(bootR);
  legL.add(shinL); legR.add(shinR);
  root.add(legL); root.add(legR);
  /* ТОРС v9 — «простая но красивая» модель: ОДИН цельный корпус
     (классический чистый воксель-силуэт), БЕЗ накладных плеч и лишнего
     декора. Плечевая линия = сама рука (см. ниже). Детали минимальные:
     ремень с латунной пряжкой и таз, закрывающий просвет между бёдрами.
     Все стыки «внахлёст». v14: воротник УДАЛЁН по заявке игрока —
     рубашка кончается кромкой, дальше чистая шея (см. neckBend).
     v29 ЖЕНСКИЙ СИЛУЭТ: вместо прямого корпуса — «песочные часы»:
     ГРУДЬ .38 шире + ТАЛИЯ .34 уже (перепад 4см читается сразу),
     тонкий пояс-пояс БЕЗ пряжки, таз чуть шире.
     v30 ГРУДЬ 0–4 (заявка «2–4 заметно больше, диапазон шире, форма
     лучше, расположение правильнее; 1 — как было»): ТОЧНАЯ ТАБЛИЦА
     размеров вместо слабой линейной шкалы — каждый шаг читается сразу
     (разброс глубины 2.8см → 12.4см). ФОРМА: каждая грудь — ДВА бокса:
     основа + меньшая «крышка» сверху, чуть позади передней грани —
     скруглённый верх «каплей» вместо плоской плиты. РАСПОЛОЖЕНИЕ:
     с ростом размера раздвигаются в стороны (не сливаются в монолит),
     большие сидят чуть ниже (естественная посадка), задняя грань
     всегда внахлёст с передом грудной клетки. Стык груди/талии
     перекрыт поясом. */
  const BUCKLE_C = new THREE.Color(0xcfae62);      /* латунная пряжка */
  const torso = new THREE.Group(); torso.position.y = .92;
  const breastBoxes = [];
  if (female) {
    const BR = [
      { w:.105, h:.10,  d:.028, x:.079, y:.400 },   /* 0: плоская — лёгкий рельеф */
      { w:.115, h:.115, d:.042, x:.082, y:.400 },   /* 1: маленькая — как было (одобрено) */
      { w:.140, h:.150, d:.072, x:.087, y:.399 },   /* 2: средняя */
      { w:.164, h:.175, d:.098, x:.091, y:.396 },   /* 3: большая */
      { w:.188, h:.200, d:.124, x:.095, y:.393 },   /* 4: очень большая */
    ][breast];
    const bz = -(.12 + BR.d/2 - .018);              /* задняя грань внахлёст .018 с передом груди (-.12) */
    breastBoxes.push({ w:BR.w, h:BR.h, d:BR.d, x:-BR.x, y:BR.y, z:bz, c:sC });
    breastBoxes.push({ w:BR.w, h:BR.h, d:BR.d, x: BR.x, y:BR.y, z:bz, c:sC });
    if (breast >= 2) {
      /* скруглённый верх «каплей»: крышка ТОЙ ЖЕ ширины (фронт — чистая масса,
         без «полос»), но меньшей глубины и выше — профиль сбоку двухступенчатый,
         самая полная точка ниже середины; силуэт читается округлым */
      const cw = BR.w*.94, ch = BR.h*.36, cd = BR.d*.60;
      const cz = -(.12 + cd/2 - .020);
      breastBoxes.push({ w:cw, h:ch, d:cd, x:-BR.x, y:BR.y + BR.h*.44, z:cz, c:sC });
      breastBoxes.push({ w:cw, h:ch, d:cd, x: BR.x, y:BR.y + BR.h*.44, z:cz, c:sC });
    }
    torso.add(makeBodyMesh([
      { w:.38, h:.30, d:.24, x:0, y:.44, z:0, c:sC },            /* грудь (шире) */
      { w:.315, h:.30, d:.23, x:0, y:.145, z:0, c:sC },          /* талия (заметно уже) — «песочные часы» */
      { w:.365, h:.055, d:.245, x:0, y:.03, z:0, c:PANTS_C.color },/* тонкий пояс — ступень силуэта */
      { w:.14, h:.09, d:.22, x:0, y:-.04, z:0, c:pC },            /* таз/бёдра чуть шире талии */
      ...breastBoxes
    ]));
  } else {
    torso.add(makeBodyMesh([
      { w:.40, h:.58,  d:.26, x:0, y:.315,  z:0,     c:sC },          /* корпус: цельный, низ в ремне */
      { w:.43, h:.06,  d:.30, x:0, y:0,     z:0,     c:PANTS_C.color },/* ремень: внахлёст на корпус и бёдра */
      { w:.07, h:.04,  d:.03, x:0, y:0,     z:-.145, c:BUCKLE_C },    /* пряжка ремня: на 10 мм перед ремнём */
      { w:.12, h:.085, d:.24, x:0, y:-.0375, z:0,    c:pC }           /* таз: закрывает просвет между бёдрами */
    ]));
  }
  /* ШЕЯ v14 («чистая шея БЕЗ воротника», заявка игрока): никакого
     воротника вообще — рубашка кончается кромкой, дальше только кожа.
     Две ступени сужения (маскулинно, без «женственной» лебединой шеи):
     низ .15×.15 (60% ширины головы) → верх .125×.13. Низ заходит .02
     ПОД кромку рубашки — при любом наклоне внизу запечатано; верх
     уходит .115 В череп (глубже, чем было в v12) — при полном наклоне
     головы вниз/вверх стык не открывается. Спереди видно ~5 см живой
     шеи. Группа neckBend по-прежнему гнётся на 45% наклона (v12),
     голова добавляет 55% — «шея гнётся, а не торчит» */
  const neckBend = new THREE.Group(); neckBend.position.y = .605;
  neckBend.add(makeBodyMesh(female ? [
    { w:.135, h:.11, d:.135, x:0, y:.035, z:0, c:skinC },   /* низ шеи — чуть тоньше мужской */
    { w:.11,  h:.10, d:.115, x:0, y:.115, z:0, c:skinC }    /* верх шеи — изящное сужение к черепу */
  ] : [
    { w:.15,  h:.11, d:.15, x:0, y:.035, z:0, c:skinC },   /* низ шеи: 1.505–1.615, внахлёст .02 на торс, у плеч шире */
    { w:.125, h:.10, d:.13, x:0, y:.115, z:0, c:skinC }    /* верх шеи: 1.59–1.69, сужение к черепу, верх глубоко в голове */
  ]));
  torso.add(neckBend);
  /* руки v9 — pivot на плече (y=.52 — плечо «сидит» ВНУТРИ корпуса,
     а не на самой кромке). Внутренняя грань руки на .005 внутри корпуса,
     а верх руки заходит +.05 НАД осью плеча: при махе (±37°) и
     разведении верх остаётся ВНУТРИ корпуса — плечо не отлипает.
     Рукав длинный: локоть спрятан в рукаве (низ -.10 ниже оси локтя),
     предплечье выходит из-под рукава; верх предплечья +.05 над осью —
     внутри рукава при любом сгибе (до ~95°). Плечо = сама рука (.13).
     v29 ЖЕНЩИНЫ: рука ТОНЬШЕ (.115) и рукав КОРОТКИЙ — топ: рукав до
     середины плеча, дальше голая рука (кожа) — силуэт топика. */
  const armL = new THREE.Group(), armR = new THREE.Group();
  armL.position.set(-.26, .52, 0); armR.position.set(.26, .52, 0);
  if (female) {
    const upF = [
      { w:.115, h:.17, d:.135, x:0, y:-.085, z:0, c:sC },     /* короткий рукав топа: до середины плеча */
      { w:.105, h:.27, d:.125, x:0, y:-.295, z:0, c:skinC }     /* голое плечо: от рукава до локтя (-.02) */
    ];
    armL.add(makeBodyMesh(upF)); armR.add(makeBodyMesh(upF.map(b => ({ ...b }))));
  } else {
    const upper = { w:.13, h:.40, d:.15, x:0, y:-.16, z:0, c:sC };
    armL.add(makeBodyMesh([upper])); armR.add(makeBodyMesh([{ ...upper }]));
  }
  /* предплечье+кисть: pivot в ЛОКТЕ (y=-.26 от плеча), стыки внахлёст */
  const forearmL = new THREE.Group(), forearmR = new THREE.Group();
  forearmL.position.set(0, -.26, 0); forearmR.position.set(0, -.26, 0);
  const foreBoxes = [
    { w:female ? .10 : .115, h:.29, d:female ? .115 : .12, x:0, y:-.105, z:0, c:skinC },   /* предплечье: верх .04 над осью локтя — ВНУТРИ рукава при любом сгибе */
    { w:female ? .09 : .105, h:.09, d:female ? .11 : .125, x:0, y:-.27, z:0, c:skinC }    /* кисть: внахлёст на предплечье, без coplanar */
  ];
  forearmL.add(makeBodyMesh(foreBoxes)); forearmR.add(makeBodyMesh(foreBoxes.map(b => ({ ...b }))));
  armL.add(forearmL); armR.add(forearmR);
  torso.add(armL); torso.add(armR);
  /* ГОЛОВА: на лице — ТОЛЬКО ГЛАЗА (чистый воксельный стиль, никаких
     ртов/бровей/носов). ПРИЧЁСКИ v10 — ровно 5 разных, все СИММЕТРИЧНЫЕ
     и «единые»: «шапка» на макушке + чёлка + боковины + затылок СШИТЫ в
     одну оболочку — верхний торец каждого слоя заходит ВНУТРЬ шапки
     (y .134 > .125 низа шапки → слои не «висят», щелей между слоями нет;
     верх слоя НЕ в плоскости макушки .135 — coplanar исключён).
     Снаружи волосы выступают всего на 3–5 мм — обтекают голову, не
     выпирают (по заявке игрока). Тот же стиль переезжает в труп
     (ud.hairBoxes).
     v29 ЖЕНЩИНЫ: + РЕСНИЦЫ — тонкая тёмная полоска НАД каждым глазом
     (на 3мм выше глаза, у самой кожи): читается вблизи, «не чересчур». */
  const headG = new THREE.Group(); headG.position.y = .185;   /* в neckBend (1.525) → мировая ось 1.71 — та же, что была */
  const hsR = (typeof rng === 'function') ? rng() : 0;   /* v29: явный конфиг игрока — rng не нужен */
  /* общий каркас (все 5 стилей), v10.1: «шапка» — ВПРИТУЛ к черепу:
     голова .25 → шапка .254 (по 2 мм на сторону), а была .29 — торчала
     «шляпой» (заявка игрока). Низ шапки .125, заходит в череп на .01;
     высота .042 (была .06) — макушка не «высокая шапка», а короткая
     стрижка. Вертикальные слои с нижней кромкой B поднимаются до y .134 —
     верх ВНУТРИ шапки (низа .125) → каждый слой СШИТ с волосами на макушке;
     слои утоплены в череп (наружу торчит 3 мм) — без coplanar-граней */
  const HAIR_CAP = { w:.254, h:.042, d:.254, x:0, y:.146, z:0, c:hC };
  const hFr = B => ({ w:.256, h:.134-B, d:.05, x:0, y:(.134+B)/2, z:-.103, c:hC });        /* чёлка/перед */
  const hBk = B => ({ w:.256, h:.134-B, d:.05, x:0, y:(.134+B)/2, z:.103, c:hC });          /* затылок */
  const hSd = (B, sx) => ({ w:.05, h:.134-B, d:.22, x:.103*sx, y:(.134+B)/2, z:0, c:hC }); /* боковины */
  const hPf = (B, sx) => ({ w:.11, h:.134-B, d:.05, x:.0725*sx, y:(.134+B)/2, z:-.103, c:hC }); /* полочка с пробором */
  /* v29: ЖЕНСКИЕ ПРИЧЁСКИ — 6 уникальных, из той же «сшитой» грамматики:
     каждый длинный слой ВЕРХОМ заходит под шапку (верх ≥ .125) — швов нет.
     0 КАРЕ: ровная чёлка + длинные до подбородка боковины/затылок.
     1 ХВОСТ: высокий хвост — резинка на макушке, хвост вниз по затылку.
     2 ДЛИННЫЕ: чёлка + длинные пряди до груди (боковины + затылок).
     3 ПУЧОК: пробор + маленький пучок-шар на затылке сверху.
     4 КУДРИ: «облако» — широкие пухлые боковины/затылок до плеч.
     5 ПИКСИ: короткая с косой чёлкой и открытым затылком. */
  const F_LASH = female ? [
    { w:.058, h:.011, d:.014, x:-.065, y:.031, z:-.126, c:EYE_COLOR },   /* ресница над левым глазом */
    { w:.058, h:.011, d:.014, x: .065, y:.031, z:-.126, c:EYE_COLOR }    /* ресница над правым глазом */
  ] : [];
  let hairBoxes;
  if (female) {
    const fid = Number.isInteger(o.hairStyle) ? Math.max(0, Math.min(5, o.hairStyle)) : Math.floor(rng()*6);
    hairBoxes =
      fid === 0 ? [ HAIR_CAP, hFr(.045),
        { w:.058, h:.155, d:.235, x:-.104, y:.052, z:0, c:hC }, { w:.058, h:.155, d:.235, x:.104, y:.052, z:0, c:hC },
        { w:.258, h:.165, d:.058, x:0, y:.048, z:.104, c:hC } ]                     /* 0: каре */
    : fid === 1 ? [ HAIR_CAP, hFr(.05), hSd(.02,-1), hSd(.02,1), hBk(-.02),
        { w:.10, h:.028, d:.08, x:0, y:.128, z:.115, c:hC },                        /* резинка */
        { w:.085, h:.30, d:.065, x:0, y:-.03, z:.128, c:hC } ]                      /* 1: хвост */
    : fid === 2 ? [ HAIR_CAP, hFr(.03),
        { w:.056, h:.42, d:.23, x:-.103, y:-.09, z:0, c:hC }, { w:.056, h:.42, d:.23, x:.103, y:-.09, z:0, c:hC },
        { w:.26, h:.44, d:.056, x:0, y:-.10, z:.103, c:hC } ]                      /* 2: длинные до груди */
    : fid === 3 ? [ HAIR_CAP, hPf(.02,-1), hPf(.02,1), hBk(-.03), hSd(.0,-1), hSd(.0,1),
        { w:.11, h:.026, d:.11, x:0, y:.148, z:.078, c:hC },                        /* основание пучка */
        { w:.105, h:.085, d:.105, x:0, y:.19, z:.078, c:hC } ]                     /* 3: пучок-шар */
    : fid === 4 ? [ HAIR_CAP, hFr(.02),
        { w:.075, h:.16, d:.24, x:-.112, y:.045, z:0, c:hC }, { w:.075, h:.16, d:.24, x:.112, y:.045, z:0, c:hC },
        { w:.262, h:.17, d:.075, x:0, y:.04, z:.107, c:hC },
        { w:.22, h:.07, d:.06, x:0, y:-.055, z:.105, c:hC } ]                       /* 4: кудри до плеч */
    : [ HAIR_CAP, hPf(.015,-1), hFr(.07), hSd(-.03,-1), hSd(-.03,1), hBk(-.04),
        { w:.258, h:.05, d:.05, x:0, y:-.028, z:.10, c:hC } ];                      /* 5: пикси с затылком */
    hairBoxes.styleId = 10 + fid;   /* теги женских стилей: 10..15 */
  } else {
    const hairId = Number.isInteger(o.hairStyle)
      ? Math.max(0, Math.min(4, o.hairStyle))
      : (hsR < .20 ? 0 : hsR < .40 ? 1 : hsR < .60 ? 2 : hsR < .80 ? 3 : 4);
    hairBoxes =
      hairId === 0 ? [ HAIR_CAP, hFr(.05), hBk(-.03), hSd(.03,-1), hSd(.03,1) ]       /* 0: классическая с ровной чёлкой */
    : hairId === 1 ? [ HAIR_CAP, hFr(.09), hBk(-.05), hSd(.01,-1), hSd(.01,1) ]      /* 1: бокс — коротко, лоб открыт */
    : hairId === 2 ? [ HAIR_CAP, hFr(.025), hBk(-.07), hSd(-.05,-1), hSd(-.05,1) ]  /* 2: шапка-«горшок» — чёлка почти до бровей */
    : hairId === 3 ? [ HAIR_CAP, hPf(.03,-1), hPf(.03,1), hBk(-.03), hSd(.02,-1), hSd(.02,1) ] /* 3: с пробором по центру */
    : [ HAIR_CAP, hFr(.05), hBk(-.06),                                                        /* 4: длинная сзади — хвост до воротника */
        { w:.256, h:.13, d:.05, x:0, y:-.115, z:.105, c:hC }, hSd(-.03,-1), hSd(-.03,1) ];
    hairBoxes.styleId = hairId;   /* тег стиля для автотестов (в труп не переезжает) */
  }
  headG.add(makeBodyMesh([
    { w:.25, h:.27, d:.25, x:0, y:0, z:0, c:skinC },
    ...F_LASH,
    ...hairBoxes
  ]));
  const eyes = new THREE.Group();
  const eyeMesh = makeBodyMesh([
    { w:.048, h:.048, d:.02, x:-.065, y:0, z:-.13, c:EYE_COLOR },
    { w:.048, h:.048, d:.02, x:.065,  y:0, z:-.13, c:EYE_COLOR }
  ]);
  eyeMesh.castShadow = false;
  eyes.add(eyeMesh);
  headG.add(eyes);
  neckBend.add(headG);
  root.add(torso);
  /* РОСТ v14: у каждого жителя свой рост — М 160–200 см, Ж 150–180 см.
     ГЛАВНОЕ (заявка игрока): меняется ТОЛЬКО ВЫСОТА — scale.set(1, s, 1):
     все ШИРИНЫ и ГЛУБИНЫ у жителей ОДИНАКОВЫ, вытягиваются
     только вертикали. Хитбокс/физика — так же:
     радиус капсулы постоянный, полувысота по росту (npcCreate/rayHitNPC).
     Глаза NPC: 1.70×рост/188 */
  const heightCm = Number.isInteger(o.heightCm)
    ? o.heightCm
    : (female ? 150 + Math.floor(rng()*31) : 160 + Math.floor(rng()*41));
  const bodyScale = heightCm / 188;                /* база модели — 188 см */
  root.scale.set(1, bodyScale, 1);
  root.userData = { legL, legR, armL, armR, torso, headG, neckBend, eyes,
    shinL, shinR, forearmL, forearmR, hairBoxes, bodyScale, heightCm,
    bootL, bootR, skinC,
    female, breast, breastBoxes,
    mats: { shirt: shirtMat, pants: pantsMat, hair: hairMat } };
  return root;
}

/* ---------- выбор POI для жителя ---------- */
function pickVillagerSpawn(){
  /* 85% — в ядре деревни (радиус ~100м от колодца), иначе — любое место карты:
     на большой карте жители не должны теряться по диким углам */
  for (let tries = 0; tries < 80; tries++) {
    let gx, gz;
    if (Math.random() < .85) {
      const a = Math.random()*Math.PI*2, r = Math.random()*400;
      gx = Math.max(4, Math.min(VW-5, Math.round(VW/2 + Math.cos(a)*r)));
      gz = Math.max(4, Math.min(VD-5, Math.round(VD/2 + Math.sin(a)*r)));
    } else {
      gx = 4 + Math.floor(Math.random() * (VW - 8));
      gz = 4 + Math.floor(Math.random() * (VD - 8));
    }
    for (let y = 1; y <= 4; y++) {
      if (walkableCell(gx, y, gz)) return { x: (gx+.5)*S, y: y*S+.05, z: (gz+.5)*S };
    }
  }
  /* fallback: любая высота */
  for (let tries = 0; tries < 30; tries++) {
    const gx = 4 + Math.floor(Math.random() * (VW - 8));
    const gz = 4 + Math.floor(Math.random() * (VD - 8));
    for (let y = 1; y < VH; y++) {
      if (walkableCell(gx, y, gz)) return { x: (gx+.5)*S, y: y*S+.05, z: (gz+.5)*S };
    }
  }
  return { x: Wm/2, y: S+.05, z: Dm/2 };
}
function pickPoi(near){
  /* пустая площадка: гуляем куда глаза глядят — случайная проходимая точка
     в радиусе 8–45 м (обходят постройки игрока через A*) */
  for (let tries = 0; tries < 12; tries++){
    const a = Math.random()*Math.PI*2, r = 8 + Math.random()*37;
    const x = near.x + Math.cos(a)*r, z = near.z + Math.sin(a)*r;
    const gx = Math.floor(x/S), gz = Math.floor(z/S);
    if (gx < 4 || gz < 4 || gx >= VW-4 || gz >= VD-4) continue;
    if (walkableCell(gx, 1, gz)) return { x, z };
  }
  return { x: near.x + (Math.random()-.5)*12, z: near.z + (Math.random()-.5)*12 };
}

/* ---------- проверка: точка достижима (грубо) ---------- */
function jumpProbe(n, mx, mz){
  if (!n.onGround || n.jumpCd > 0) return false;
  const spd = Math.hypot(n.moveVel.x, n.moveVel.z);
  if (spd < 1.5) return false;
  const gy = Math.floor(n.pos.y / S);
  const ox = n.pos.x + mx*1.0, oz = n.pos.z + mz*1.0;
  const gx = Math.floor(ox/S), gz = Math.floor(oz/S);
  if (gx<0 || gz<0 || gx>=VW || gz>=VD) return false;
  const hasWall = getVox(gx, gy, gz) || getVox(gx, gy+1, gz);
  if (hasWall) {
    let h = 0; for (let i=gy; i<gy+4; i++) { if (getVox(gx, i, gz)) h++; else break; }
    if (h <= 3) {
      if (getVox(gx, gy+3, gz) || getVox(gx, gy+4, gz)) return false;
      const bx = Math.floor((n.pos.x + mx*2.6)/S), bz = Math.floor((n.pos.z + mz*2.6)/S);
      if (bx>=0 && bz>=0 && bx<VW && bz<VD) {
        if (getVox(bx, gy+3, bz) || getVox(bx, gy+4, bz)) return false;
        for (let dy=-2; dy<=2; dy++) if (walkableCell(bx, gy+dy, bz)) return true;
      }
    }
  }
  return false;
}

/* ---------- создание одного жителя ---------- */
function npcCreate(spawn){
  const rng = Math.random;
  const root = buildVillagerModel(rng);   /* v29: пол 50/50 внутри модели */
  scene.add(root);
  const bs = root.userData.bodyScale || 1;   /* v14: рост NPC — высота капсулы по росту */
  const female = !!root.userData.female;
  const body = world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased()
    .setTranslation(spawn.x, spawn.y + .925*bs, spawn.z));
  /* v14: радиус ПОСТОЯННЫЙ NPC_R (тело в ширину не меняется — только
     высота), полувысота под рост: капсула накрывает ровно 0..1.85*bs
     от ног, как и раньше — низ/верх не сдвинулись ни на сантиметр */
  const col = world.createCollider(RAPIER.ColliderDesc.capsule(NPC_H*bs/2 - NPC_R, NPC_R).setFriction(0), body);
  const ctl = world.createCharacterController(.02);
  const safe = fn => { try { fn(); } catch(e){} };
  safe(() => ctl.setUp({x:0, y:1, z:0}));
  safe(() => ctl.setMaxSlopeClimbAngle(50 * Math.PI/180));
  safe(() => ctl.setMinSlopeSlideAngle(60 * Math.PI/180));
  safe(() => ctl.setApplyImpulsesToDynamicBodies(true));
  safe(() => ctl.setCharacterMass(65 * bs));   /* v14: ширина тела постоянна → масса ∝ росту: 55–69 кг, как люди одного телосложения */
  safe(() => ctl.enableAutostep(S*1.35, false, false));   /* как у игрока: пороги/ковры/обломки */
  safe(() => ctl.enableSnapToGround(.18));   /* было .5: резкий дотяг на 50см = видимые провалы у ступенек */
  const n = {
    id: ++npcIdSeq,
    root, body, col, ctl,
    female,
    hp: 100, alive: true,
    bodyScale: bs, heightCm: root.userData.heightCm,
    pos: new THREE.Vector3(spawn.x, spawn.y, spawn.z),
    vel: new THREE.Vector3(),
    moveVel: new THREE.Vector3(),
    yaw: Math.random() * Math.PI * 2,
    onGround: false,
    path: null, pathI: 0, repathT: 0,
    thinkT: 0, stuckT: 0, jumpCd: 0, fellT: 0,
    walkPh: Math.random() * Math.PI * 2,   /* рассинхрон: толпа не марширует строем */
    idleT: 0,          /* сколько ещё ПРОСТОИТ на месте (осматривается) */
    visY: spawn.y,     /* сглаженный визуальный Y (фильтр микропровалов KCC) */
    dipHold: 0,        /* счётчик кадров «удержания» при микропровале */
    animAmp: 0,        /* плавный разгон/остановка шага */
    airPose: 0,        /* плавный вход/выход из позы полёта */
    headYaw: 0,        /* плавный текущий поворот головы */
    headPitch: 0,      /* плавный наклон головы (осмотр вверх/вниз) */
    animSeed: Math.random() * 10,   /* личная фаза дыхания/покачивания */
    blinkT: 1.5 + Math.random() * 4,   /* время до следующего моргания */
    blinkA: -1,        /* прогресс моргания 0..1; -1 = не моргает */
    blinkNext: 0,      /* очередь двойного моргания */
    lastGoal: null,
    posHistory: [],
    ragdoll: false, ragdollBodies: null, ragdollJoints: null, ragdollMuscles: null, dieT: 0,
    alertT: 0, fleeT: 0, lastPlayerPos: null,   /* flee AI — бегство от игрока */
    fleeJit: 0, fleeWallT: 0,                   /* личный угол бегства + таймер упора в стену */
    runF: 0, idleLookT: 0, idleYawOff: 0, idlePitchOff: 0,   /* слой бега + осматривание головой на месте */
    headYawV: 0, headPitchV: 0,           /* скорость поворота головы (пружина) */
    gazing: false, gazeDelay: 0,          /* взгляд на игрока при подходе в простое */
    lod: 1  /* 0=близко, 1=далеко, 2=очень далеко */
  };
  npcs.push(n);
  root.position.copy(n.pos);
  root.rotation.y = n.yaw;
  return n;
}

/* ---------- RAGDOLL (динамические тела с суставами) ----------
   Анатомия как у живого человека:
   - колени и локти — ШАРНИРЫ (revolute) с жёсткими лимитами: сгибаются ТОЛЬКО в свою сторону,
     как настоящие кости (колено назад не гнётся, локоть наружу не гнётся);
   - плечи, бёдра, шея — шаровые суставы + «связки/мышцы» (ragdollMuscles): каждый кадр
     PD-контроллер держит угол конусом вокруг анатомического покоя + пассивный тонус —
     конечности не наматываются на тело и не складываются в «коробку»;
   - весь рэгдолл спавнится ПОВЁРНУТЫМ на yaw — труп падает лицом туда, куда смотрел NPC;
   - на голове те же глаза, что у живого (+волосы), на ногах ботинки, на руках кисти. */
function makeRagdoll(pos, vel, root, yaw){
  yaw = yaw || 0;
  /* v14: труп — ТОЛЬКО ВЫСОТА под рост NPC (160–200 см): вертикали
     (офсеты по Y, длины костей, суставы) масштабируются по росту,
     ГОРИЗОНТАЛИ (ширина плеч ±.34, толщина конечностей) — постоянны,
     как у живого (см. РОСТ v14). Падает человек именно того роста и
     того же телосложения, каким жил */
  const bs = (root.userData && root.userData.bodyScale) || 1;
  const qYaw = { x: 0, y: Math.sin(yaw/2), z: 0, w: Math.cos(yaw/2) };
  /* лёгкий наклон всего тела — мёртвое тело не может стоять идеально сбалансированным
     манекеном: оно сразу выходит из равновесия и оседает. Наклон направлен ВПЕРЁД по
     оси взгляда NPC (70% вперёд / 30% назад) с небольшим случайным уводом вбок —
     труп падает туда, куда смотрел. Наклон применяется И к офсетам, И к повороту тел —
     якоря суставов остаются совмещёнными. */
  const cyw = Math.cos(yaw), syw = Math.sin(yaw);
  const latX = cyw, latZ = -syw;            /* латеральная ось тела (вправо) */
  const faceX = -syw, faceZ = -cyw;         /* куда смотрит NPC */
  const side = (Math.random()-.5)*.6;       /* лёгкий случайный увод вбок */
  let ax = latX + faceX*side, az = latZ + faceZ*side;
  const al = Math.hypot(ax, az) || 1; ax /= al; az /= al;
  const fwd = Math.random() < .7 ? -1 : 1;  /* 70% — падение вперёд (по взгляду) */
  const lAng = .12 + Math.random()*.10;
  const ls = Math.sin(lAng/2) * fwd;
  const qLean = { x: ax*ls, y: 0, z: az*ls, w: Math.cos(lAng/2) };
  const qmul = (a, b) => ({
    x: a.w*b.x + a.x*b.w + a.y*b.z - a.z*b.y,
    y: a.w*b.y - a.x*b.z + a.y*b.w + a.z*b.x,
    z: a.w*b.z + a.x*b.y - a.y*b.x + a.z*b.w,
    w: a.w*b.w - a.x*b.x - a.y*b.y - a.z*b.z
  });
  const qBody = qmul(qLean, qYaw);   /* сначала yaw (взгляд NPC), затем наклон */
  const rotV = (q, v) => {           /* поворот вектора кватернионом: v + 2q×(q×v+w v) */
    const tx = 2*(q.y*v.z - q.z*v.y), ty = 2*(q.z*v.x - q.x*v.z), tz = 2*(q.x*v.y - q.y*v.x);
    return {
      x: v.x + q.w*tx + (q.y*tz - q.z*ty),
      y: v.y + q.w*ty + (q.z*tx - q.x*tz),
      z: v.z + q.w*tz + (q.x*ty - q.y*tx)
    };
  };
  const parts = {};
  const dynDesc = (offset, hx, hy, hz, capR) => {
    /* офсет поворачивается qBody (yaw + наклон) — тело ложится по направлению взгляда NPC;
       v14: Y-офсеты ×bs (рост), X/Z — постоянны (телосложение не меняется) */
    const o = rotV(qBody, { x: offset.x, y: offset.y*bs, z: offset.z });
    const b = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic()
      .setTranslation(pos.x + o.x, pos.y + o.y, pos.z + o.z)
      .setRotation(qBody)
      .setLinearDamping(.18).setAngularDamping(1.0));  /* лин. низкий — труп ЛЕТИТ от взрыва; угл. выше — конечности успокаиваются */
    /* capR>0 — КАПСУЛА вместо бокса (бёдра): скруглённый верх позволяет вращаться
       вокруг тазобедренного анкора БЕЗ проникновения в торс при ЛЮБОМ угле —
       контакты бедро↔торс включены, нога не заходит в торс никогда */
    const cd = capR ? RAPIER.ColliderDesc.capsule((hy - capR)*bs, capR) : RAPIER.ColliderDesc.cuboid(hx, hy*bs, hz);
    /* collision groups: membership 0x0002 (рэгдолл), filter 0x0003 (мир 0x0001 + рэгдолл 0x0002) —
       части рэгдолла сталкиваются с МИРОМ и ДРУГ С ДРУГОМ: рука не проходит сквозь торс,
       голову и ноги, нога не проходит сквозь ногу и т.д. Контакты между СОСЕДНИМИ частями
       (соединёнными суставом) отключаются у самого сустава через setContactsEnabled(false) —
       solver не воюет со связкой. ИСКЛЮЧЕНИЯ — ШЕЯ и БЁДРА (keepContacts): контакты
       с торсом ВКЛЮЧЕНЫ, но формы (зазор шеи + капсулы бёдер) не конфликтуют в покое.
       Плотность 2.0: части-«пёрышки» усиливали любую ошибку солвера (дрожь). */
    world.createCollider(cd.setFriction(.7).setRestitution(.05).setDensity(2.0)
      .setCollisionGroups(0x00020003), b);
    return b;
  };
  /* позиции частей тела подобраны так, чтобы суставы (anchor1 на теле A и anchor2 на теле B)
     совпадали в мировых координатах изначально — иначе solver «стягивает» тела и они разлетаются. */
  parts.torso = dynDesc({x:0, y:1.22, z:0}, .27, .29, .15);      /* верх торса: y=1.51 */
  /* ШЕЯ = РЕАЛЬНЫЙ ЗАЗОР 0.07 (низ головы 1.58, верх торса 1.51): голова — маятник
     на суставе, свободно качается/клевет во все стороны; при сильном наклоне (~24°)
     ложится краем на торс/плечи через контакт — как настоящая голова на плечах.
     Раньше зазора НЕ было (низ головы ровно на торсе): любой наклон = проникновение
     угла = контакт мгновенно возвращал голову — она выглядела ПРИВАРЕННОЙ. */
  parts.head = dynDesc({x:0, y:1.71, z:0}, .12, .13, .12);
  parts.armU_L = dynDesc({x:-.34, y:1.27, z:0}, .08, .13, .09);  /* верх: y=1.40 */
  parts.armU_R = dynDesc({x:.34, y:1.27, z:0}, .08, .13, .09);
  parts.armL_L = dynDesc({x:-.34, y:1.01, z:0}, .07, .13, .08);  /* верх: y=1.14 = низ upper arm */
  parts.armL_R = dynDesc({x:.34, y:1.01, z:0}, .07, .13, .08);
  /* БЁДРА — КАПСУЛЫ (радиус .085, цилиндр .31): вершина капсулы (y=0.92) всегда
     НИЖЕ низа торса (y=0.93) при любом угле вращения вокруг тазобедренного анкора —
     бедро машет свободно, но в торс зайти не может (контакты ВКЛЮЧЕНЫ) */
  parts.legU_L = dynDesc({x:-.13, y:0.68, z:0}, .085, .24, .085, .085);
  parts.legU_R = dynDesc({x:.13, y:0.68, z:0}, .085, .24, .085, .085);
  parts.legL_L = dynDesc({x:-.13, y:0.24, z:0}, .08, .2, .1);    /* верх: y=0.44 = низ upper leg */
  parts.legL_R = dynDesc({x:.13, y:0.24, z:0}, .08, .2, .1);
  /* скорость от удара + КУВЫРОК: всем частям ОДИНАКОВАЯ угловая скорость —
     тело вращается монолитом (суставы не сопротивляются), выглядит как настоящее
     кувыркание человека в полёте */
  if (vel) {
    const clampv = v => Math.max(-38, Math.min(38, v || 0));
    const safeV = { x: clampv(vel.x), y: clampv(vel.y), z: clampv(vel.z) };
    const spd = Math.hypot(safeV.x, safeV.y, safeV.z);
    let tum = null;
    if (spd > 6) {
      /* ось кувырка ⊥ скорости: cross(v, up) */
      const tax = -safeV.z, taz = safeV.x, tal = Math.hypot(tax, taz);
      if (tal > .01) {
        const w = (2.5 + Math.random()*3.5) * Math.min(1, spd/20);
        tum = { x: tax/tal*w, y: (Math.random()-.5)*1.2, z: taz/tal*w };
      }
    }
    for (const k in parts) {
      const b = parts[k];
      if (!b) continue;
      /* базовая скорость + лёгкий ШУМ по частям: конечности хлещут в полёте —
         тело выглядит как живой человек, отброшенный взрывом, а не летящая доска */
      b.setLinvel({
        x: safeV.x + (Math.random()-.5)*2.4,
        y: safeV.y + (Math.random()-.5)*1.8,
        z: safeV.z + (Math.random()-.5)*2.4
      }, true);
      if (tum) b.setAngvel({
        x: tum.x + (Math.random()-.5)*5,
        y: tum.y + (Math.random()-.5)*5,
        z: tum.z + (Math.random()-.5)*5
      }, true);
    }
  } else {
    /* смерть БЕЗ сильного удара: наклон задаёт направление, инерция торса в сторону
       падения делает коллапс решительным — тело оседает туда, куда смотрело NPC
       (как реальное тело с «подломившимися» коленями), а не случайным образом */
    const drift = .55 + Math.random()*.55;      /* смещение по инерции, м/с */
    const spin = .9 + Math.random()*.9;         /* вращение при падении, рад/с */
    const dirSign = -fwd;                       /* fwd=-1 (вперёд) → дрейф по взгляду */
    if (parts.torso) {
      parts.torso.setLinvel({ x: faceX*drift*dirSign, y: 0, z: faceZ*drift*dirSign }, true);
      parts.torso.setAngvel({ x: latX*spin*fwd, y: 0, z: latZ*spin*fwd }, true);
    }
  }
  /* суставы */
  const ballDesc = (a, b, anchorA, anchorB, keepContacts) => {
    try {
      /* ВАЖНО: в Rapier сигнатура spherical(anchor1, anchor2) — ДВА отдельных вектора.
         v14: анкеры — локальные координаты тел; Y ×bs (рост), X/Z постоянны
         (ширина скелета не меняется). Совпадение якорей A_off+A_anc = B_off+B_anc
         сохраняется: компонентное масштабирование (1,bs,1) не ломает равенство */
      const A = { x: anchorA.x, y: anchorA.y*bs, z: anchorA.z };
      const B = { x: anchorB.x, y: anchorB.y*bs, z: anchorB.z };
      const jd = RAPIER.JointData.spherical(A, B);
      const j = world.createImpulseJoint(jd, a, b, true);
      /* соседние части (соединённые ЭТИМ суставом) не сталкиваются между собой —
        иначе solver расталкивает их и тело «взрывается». Все ПРОЧИЕ пары частей
        сталкиваются (группа 0x0003) — это и есть «плоть»: рука бьётся о торс, нога о ногу.
        ИСКЛЮЧЕНИЕ — ШЕЯ (keepContacts): контакты голова↔торс ВКЛЮЧЕНЫ — голова
        физически ЛЕЖИТ на торсе/плечах и не может провалиться сквозь грудь
        (позвоночник и рёбра не пускают — это и есть анатомия). Конфликта с суставом
        нет: в покое низ головы ровно на верхе торса (проникновение = 0), контакт
        вступает в работу только когда голова НАКЛОНИЛАСЬ — и кладёт её корпус
        плеча, как настоящую. */
      if (!keepContacts) { try { j.setContactsEnabled(false); } catch(e){} }
      return j;
    } catch(e){ console.error('[ragdoll] JOINT FAILED — тело разлетится!', e); return null; }
  };
  /* ШАРНИР с лимитами (колено/локоть): ось X — латеральная ось тела.
     Rapier сам жёстко держит лимиты — это «кости»: колено не гнётся назад, локоть не гнётся наружу. */
  const hingeDesc = (a, b, anchorA, anchorB, min, max) => {
    try {
      /* v14: Y ×bs (рост), X/Z постоянны — как у шаровых суставов */
      const A = { x: anchorA.x, y: anchorA.y*bs, z: anchorA.z };
      const B = { x: anchorB.x, y: anchorB.y*bs, z: anchorB.z };
      const jd = RAPIER.JointData.revolute(A, B, {x:1, y:0, z:0});
      const j = world.createImpulseJoint(jd, a, b, true);
      try { j.setLimits(min, max); } catch(e){ console.error('[ragdoll] HINGE LIMITS FAILED', e); }
      /* как и у шаровых: соединённые части игнорируют друг друга */
      try { j.setContactsEnabled(false); } catch(e){}
      return j;
    } catch(e){ console.error('[ragdoll] HINGE FAILED', e); return null; }
  };
  const J = [];
  const MUSC = [];   /* «связки/мышцы» шаровых суставов — обрабатываются в ragdollMuscles() каждый кадр */
  /* шея: шаровой + контакты с торсом ВКЛЮЧЕНЫ (см. ballDesc) + зазор шеи 0.07 —
     анкор на голове ниже центра на 0.20 (1.71-0.20 = верх торса 1.51 ✓);
     СВЯЗКА tilt≤0.9 (52°) меряет ТОЛЬКО наклон (поворот влево/вправо свободен).
     Голова качается свободно (маятник на анкоре), на сильном наклоне ЛЕЖИТ на
     плечах через контакт — сквозь торс не провалится никогда. */
  J.push(ballDesc(parts.torso, parts.head, {x:0, y:.29, z:0}, {x:0, y:-.20, z:0}, true));
  /* гейны МЯГКИЕ, момент ограничен инерцией части (≤1.2 рад/с за кадр) и
     «анти-overshoot» трения — жёсткие гейны и трение без клампа давали дрожь.
     km=0: тонуса у трупа нет (у мертвеца нет мышц) — тонус вечно подпитывал
     микроколебания и не давал телу уснуть */
  MUSC.push({ name:'neck', a:parts.torso, b:parts.head, tilt:true, max:.9, kp:2.2, kd:.6, km:0, kd2:.07, tmax:2.2 });
  /* плечи: конус полного размаха ≤2.9 (166°) — рука над головой легальна;
     сквозь торс не даст пройти самоколлизия, «коробка» исключена */
  J.push(ballDesc(parts.torso, parts.armU_L, {x:-.27, y:.18, z:0}, {x:.07, y:.13, z:0}));
  MUSC.push({ name:'shoulderL', a:parts.torso, b:parts.armU_L, max:2.9, kp:1.0, kd:.45, km:0, kd2:.06, tmax:2.2 });
  J.push(ballDesc(parts.torso, parts.armU_R, {x:.27, y:.18, z:0}, {x:-.07, y:.13, z:0}));
  MUSC.push({ name:'shoulderR', a:parts.torso, b:parts.armU_R, max:2.9, kp:1.0, kd:.45, km:0, kd2:.06, tmax:2.2 });
  /* локти: ШАРНИР, сгиб только вперёд 0..150° (ось +X, положительный угол = конечность вперёд) */
  J.push(hingeDesc(parts.armU_L, parts.armL_L, {x:0, y:-.13, z:0}, {x:0, y:.13, z:0}, -.06, 2.62));
  J.push(hingeDesc(parts.armU_R, parts.armL_R, {x:0, y:-.13, z:0}, {x:0, y:.13, z:0}, -.06, 2.62));
  /* бёдра: конус полного размаха ≤2.1 (120° — реальное сгибание бедра вперёд);
     контакты с торсом ВКЛЮЧЕНЫ (капсулы не конфликтуют в покое — см. dynDesc):
     бедро не может быть вдавлено в торс (напр., при падении на колени/сжатии) */
  J.push(ballDesc(parts.torso, parts.legU_L, {x:-.13, y:-.29, z:0}, {x:0, y:.25, z:0}, true));
  MUSC.push({ name:'hipL', a:parts.torso, b:parts.legU_L, max:2.1, kp:1.5, kd:.55, km:0, kd2:.07, tmax:3 });
  J.push(ballDesc(parts.torso, parts.legU_R, {x:.13, y:-.29, z:0}, {x:0, y:.25, z:0}, true));
  MUSC.push({ name:'hipR', a:parts.torso, b:parts.legU_R, max:2.1, kp:1.5, kd:.55, km:0, kd2:.07, tmax:3 });
  /* колени: ШАРНИР, сгиб только назад 0..166° */
  J.push(hingeDesc(parts.legU_L, parts.legL_L, {x:0, y:-.24, z:0}, {x:0, y:.2, z:0}, -2.9, .05));
  J.push(hingeDesc(parts.legU_R, parts.legL_R, {x:0, y:-.24, z:0}, {x:0, y:.2, z:0}, -2.9, .05));
  /* визуальная модель — слитые меши частей (цвет в вершинах, BODY_MAT общий):
     10 мешей на труп вместо ~19, геометрия и размеры 1-в-1 как раньше */
  const visualParts = {};
  const ud = root.userData;
  const sC = ud.mats.shirt.color, hC = ud.mats.hair.color, pC = ud.mats.pants.color;
  const skinC = ud.skinC || SKIN.color;   /* v22: тон кожи переезжает в труп из живой модели */
  const mk = (boxes) => { const m = makeBodyMesh(boxes); if (bs !== 1) m.scale.set(1, bs, 1); scene.add(m); return m; };
  /* torso + ШЕЯ-заполнитель (закрывает физзазор 0.07 между торсом и головой) */
  /* торс-трапеция как у живого (физика-бокс не меняется, только визуал):
     грудь шире, талия уже, плечи-дельтоиды, ремень с пряжкой.
     v14: воротника НЕТ — шея-заполнитель зеркально живому (две ступени
     сужения .15 → .125), масштаб меша (1,bs,1) — только высота */
  const sC2 = sC.clone().multiplyScalar(.78);
  const BUCKLE_C = new THREE.Color(0xcfae62);
  /* v29: ЖЕНСКИЙ ТРУП — силуэт как у живой (грудь шире/талия уже/грудь
     0–4/тонкий пояс), координаты пересчитаны из торса живой модели
     (localRag = localLive − .30 — компенсация разницы центров физ-тел) */
  const isF = !!ud.female;
  visualParts.torso = mk(isF ? [
    { w:.38,  h:.30,  d:.24,  x:0, y:.14,   z:0, c:sC },             /* грудь */
    { w:.315, h:.30,  d:.23,  x:0, y:-.155, z:0, c:sC },             /* талия */
    { w:.365, h:.055, d:.245, x:0, y:-.27,  z:0, c:PANTS_C.color },   /* тонкий пояс */
    { w:.14,  h:.09,  d:.22,  x:0, y:-.34,  z:0, c:ud.mats.pants.color }, /* таз */
    ...((ud.breastBoxes || []).map(b => ({ ...b, y: b.y - .30 }))),  /* грудь 0–4 — переезжает в труп */
    { w:.135, h:.10,  d:.135, x:0, y:.35,   z:0, c:skinC },          /* шея (тоньше мужской) */
    { w:.11,  h:.09,  d:.115, x:0, y:.41,   z:0, c:skinC }
  ] : [
    { w:.40, h:.58, d:.26, x:0, y:.02,  z:0,      c:sC },            /* корпус: 0.95–1.53, 1-в-1 с живым */
    { w:.43, h:.06, d:.27, x:0, y:-.30, z:0,      c:PANTS_C.color }, /* ремень */
    { w:.07, h:.04, d:.03, x:0, y:-.30, z:-.135,  c:BUCKLE_C },      /* пряжка */
    { w:.15,  h:.10, d:.15, x:0, y:.35,  z:0,     c:skinC },     /* шея v14: низ (у плеч шире) — зеркально живому */
    { w:.125, h:.09, d:.13, x:0, y:.41,  z:0,     c:skinC }      /* шея v14: верх с сужением, верх .455 — глубоко в черепе */
  ]);
  parts.torso._mesh = visualParts.torso;
  /* голова + волосы; глаза НАВСЕГДА ЗАКРЫТЫ — узкая тёмная полоска
     (мёртвые не моргают и не смотрят), лицом вперёд −Z */
  visualParts.head = mk([
    { w:.25, h:.27, d:.25, x:0, y:0, z:0, c:skinC },
    ...((ud.hairBoxes ?? [{ w:.254, h:.042, d:.254, x:0, y:.146, z:0, c:hC }]).map(b => ({ ...b })))
  ]);
  const deadEyes = makeBodyMesh([
    { w:.05, h:.013, d:.02, x:-.065, y:.005, z:-.13, c:EYE_COLOR },
    { w:.05, h:.013, d:.02, x:.065,  y:.005, z:-.13, c:EYE_COLOR }
  ]);
  deadEyes.castShadow = false;
  visualParts.head.add(deadEyes);   /* ребёнок головы: едет вместе с ней */
  parts.head._mesh = visualParts.head;
  /* руки (+кисти) */
  /* руки: физ-тела остаются на ±.34 (настройки рэгдолла НЕ трогаем),
     визуал сдвинут к корпусу на ±.26 — силуэт 1-в-1 с живым NPC.
     v29: женские — тоньше + короткий рукав топа (плечо голое) */
  visualParts.armUL = mk(isF ? [
    { w:.115, h:.17,  d:.135, x:.08,  y:.185, z:0, c:sC },
    { w:.105, h:.12,  d:.125, x:.08,  y:.05,  z:0, c:skinC }
  ] : [{ w:.13, h:.26, d:.15, x:.08,  y:.12, z:0, c:sC }]); parts.armU_L._mesh = visualParts.armUL;
  visualParts.armUR = mk(isF ? [
    { w:.115, h:.17,  d:.135, x:-.08, y:.185, z:0, c:sC },
    { w:.105, h:.12,  d:.125, x:-.08, y:.05,  z:0, c:skinC }
  ] : [{ w:.13, h:.26, d:.15, x:-.08, y:.12, z:0, c:sC }]); parts.armU_R._mesh = visualParts.armUR;
  const armLBoxes = (sx) => [
    { w:isF ? .10 : .12,  h:.05, d:isF ? .13 : .14,  x:sx, y:.23,  z:0, c:isF ? skinC : sC2 },   /* манжета/стык у локтя (у Ж — кожа) */
    { w:isF ? .10 : .115, h:.25, d:isF ? .115 : .135, x:sx, y:.085, z:0, c:skinC },        /* предплечье */
    { w:isF ? .09 : .105, h:.09, d:isF ? .11 : .13,  x:sx, y:-.08, z:0, c:skinC }         /* кисть */
  ];
  visualParts.armLL = mk(armLBoxes(.08));  parts.armL_L._mesh = visualParts.armLL;
  visualParts.armLR = mk(armLBoxes(-.08)); parts.armL_R._mesh = visualParts.armLR;
  /* ноги (+ботинки): бёдра — БОКСЫ .18×.48×.22, как у живого NPC (юзер просил
     вернуть «как было»; физика бедра остаётся капсулой с контактами к торсу —
     «ноги не заходят в торс» сохранено). v29: женские — тоньше (.14/.115) */
  visualParts.legUL = mk([{ w:isF ? .14 : .16, h:.46, d:isF ? .19 : .20, x:0, y:.01, z:0, c:pC }]); parts.legU_L._mesh = visualParts.legUL;
  visualParts.legUR = mk([{ w:isF ? .14 : .16, h:.46, d:isF ? .19 : .20, x:0, y:.01, z:0, c:pC }]); parts.legU_R._mesh = visualParts.legUR;
  const legLBoxes = [
    { w:isF ? .115 : .14, h:.35, d:isF ? .155 : .17, x:0, y:.04,   z:0,     c:pC },           /* голень: верх заходит под бедро */
    { w:isF ? .15 : .16, h:.10, d:isF ? .27 : .28, x:0, y:-.155, z:-.045, c:SHOES.color }   /* ботинок внахлёст, носок вперёд */
  ];
  visualParts.legLL = mk(legLBoxes); parts.legL_L._mesh = visualParts.legLL;
  visualParts.legLR = mk(legLBoxes.map(b => ({ ...b }))); parts.legL_R._mesh = visualParts.legLR;
  return { parts, joints: J, visuals: visualParts, muscles: MUSC };
}

/* ---------- «МЫШЦЫ И СВЯЗКИ» рэгдолла ----------
   Каждый кадр для каждого шарового сустава (плечи/бёдра/шея):
   - измеряем отклонение B от A относительно анатомического покоя (identity);
   - угол > max → жёсткий PD-момент (натянулась связка — держит, как настоящий сустав);
   - внутри лимита → мягкий тонус (пассивные мышцы) + угловое трение в суставе.
   Именно это не даёт телу складываться в «коробку» и наматывать конечности на торс. */
const _rmQa = new THREE.Quaternion(), _rmQb = new THREE.Quaternion(), _rmQr = new THREE.Quaternion();
const _rmU = new THREE.Vector3(), _rmU2 = new THREE.Vector3();
function ragdollMuscles(n, dt){
  /* труп несут в руках → мышцы ВЫКЛЮЧЕНЫ: тело обмякает, как у настоящего мертвеца,
     и не воюет с поводком (именно эта война была главным источником дёрганья) */
  if (held && held.kind === 'rag' && held.npc === n) return;
  const specs = n.ragdollMuscles;
  if (!specs) return;
  for (let i = 0; i < specs.length; i++){
    const s = specs[i];
    const a = s.a, b = s.b;
    if (!a || !b) continue;
    try {
      const ra = a.rotation(), rb = b.rotation();
      _rmQa.set(ra.x, ra.y, ra.z, ra.w);
      _rmQb.set(rb.x, rb.y, rb.z, rb.w);
      let ang, w = 1;
      if (s.tilt) {
        /* АНАТОМИЧЕСКАЯ ШЕЯ (tilt): мерим НАКЛОН оси UP части B относительно оси UP
           части A. Поворот головы влево/вправо (yaw) не считается отклонением —
           так и у человека: шея держит голову ВЕРТИКАЛЬНО на плечах, а не намертво.
           Раньше конус считал полный угол кватерниона и позволял голове крениться
           на 74°, медленно «утопая» в торс (контактов-то не было). */
        _rmU.set(0, 1, 0).applyQuaternion(_rmQa);   /* UP торса в мире */
        _rmU2.set(0, 1, 0).applyQuaternion(_rmQb);  /* UP головы в мире */
        ang = Math.acos(Math.max(-1, Math.min(1, _rmU.dot(_rmU2))));
      } else {
        _rmQr.copy(_rmQa).invert().multiply(_rmQb);   /* относительный поворот B в осях A */
        w = _rmQr.w >= 0 ? _rmQr.w : -_rmQr.w;  /* кратчайшая дуга */
        ang = 2 * Math.acos(Math.min(1, w));
      }
      /* СОН — святое: спящие части не трогаем ВООБЩЕ. Раньше момент с wake=true
         будил труп КАЖДЫЙ КАДР — он вечно просыпался и «дёргался на земле».
         Позу спящего принимаем какой есть (труп и должен лежать неподвижно). */
      if (a.isSleeping() || b.isSleeping()) continue;
      if (ang > .015) {
        if (s.tilt) {
          /* ось согласована с моментом ниже: cross(upA, upB) — момент -ось на B
             доворачивает UP головы к UP торса */
          _rmU.crossVectors(_rmU, _rmU2);
          const L = _rmU.length();
          if (L > 1e-5) _rmU.multiplyScalar(1/L); else _rmU.set(1, 0, 0);
        } else {
          const sgn = _rmQr.w >= 0 ? 1 : -1;
          const inv = 1 / Math.sqrt(Math.max(1e-12, 1 - w*w));
          _rmU.set(_rmQr.x*sgn*inv, _rmQr.y*sgn*inv, _rmQr.z*sgn*inv).applyQuaternion(_rmQa);  /* ось отклонения в мире */
        }
        const wa = a.angvel(), wb = b.angvel();
        const wRel = (wb.x - wa.x)*_rmU.x + (wb.y - wa.y)*_rmU.y + (wb.z - wa.z)*_rmU.z;
        /* МЁРТВАЯ ЗОНА (+.04 рад) + ПРАВИЛО ПОКОЯ: связка натянута, но тело почти
           неподвижно и нарушение небольшое — ПРИНИМАЕМ позу (труп осел с чуть
           растянутой связкой — так и у настоящего). Микропинки у предела
           раньше давали вечную дрожь и не давали уснуть. */
        const over = ang - s.max - .04;
        let drive, capW;
        if (over > 0) {
          /* ПРАВИЛО ПОКОЯ: сустав неподвижен — ПРИНИМАЕМ позу любой глубины.
             Заклиненная поза (голова прижата контактами) + вечная война мышцы
             с контактами = микроскорости внутри шага = тело НИКОГДА не засыпает.
             Связка сопротивляется только ДВИЖЕНИЮ за предел — как настоящая. */
          if (Math.abs(wRel) < .3) continue;
          drive = s.kp*over + s.kd*wRel;          /* связка натянулась — мягко держим */
          /* пружине — 1.2 рад/с за кадр, демпферу — ≤85% скорости: без разворота */
          capW = 1.2 + .85*Math.abs(wRel);
        } else {
          drive = s.km*ang + s.kd2*wRel;          /* трение сустава (km=0 у трупа) */
          /* трение гасит ≤60% относительной скорости и НИКОГДА не разворачивает её:
             без этого клампа трение с крошечной инерцией руки переколебалось
             (хаттер в 60×) — вечная высокочастотная дрожь конечностей */
          capW = .6*Math.abs(wRel);
        }
        if (drive > s.tmax) drive = s.tmax; else if (drive < -s.tmax) drive = -s.tmax;
        /* ограничение по ИНЕРЦИИ части (Δω за кадр ≤ capW) — момент раньше
           разгонял лёгкую голову до СОТЕН рад/с за кадр (сильная дрожь шеи!) */
        if (s.minI === undefined) {
          try {
            const mn = v => (v && Number.isFinite(v.x)) ? Math.min(v.x, v.y, v.z) : 1e-3;
            const ia = a.principalInertia ? a.principalInertia() : null;
            const ib = b.principalInertia ? b.principalInertia() : null;
            s.minI = Math.max(5e-5, Math.min(mn(ia), mn(ib)));
          } catch(e){ s.minI = 1e-3; }
        }
        const maxImp = capW * s.minI;   /* Н·м·с: импульс за кадр */
        let imp = drive * dt;
        if (imp > maxImp) imp = maxImp; else if (imp < -maxImp) imp = -maxImp;
        if (imp !== 0) {
          /* момент, возвращающий B к покою: на B — против оси, на A — по оси.
             wake=FALSE: мышцы НИКОГДА не будят тело — сон важнее идеального угла */
          const tx = -_rmU.x*imp, ty = -_rmU.y*imp, tz = -_rmU.z*imp;
          b.applyTorqueImpulse({ x: tx, y: ty, z: tz }, false);
          a.applyTorqueImpulse({ x: -tx, y: -ty, z: -tz }, false);
        }
      }
    } catch(e){}
  }
}

/* ---------- переключение NPC в режим ragdoll (когда его ударило) ---------- */
function npcRagdollize(n, impactVel, impactPoint){
  /* ВАЖНО: проверяем только n.ragdoll (флаг уже созданного рэгдолла).
     n.alive на момент вызова может быть уже false (его ставит damageNPC
     перед вызовом) — но рэгдолл ещё не создан, так что продолжаем. */
  if (n.ragdoll) return;
  if (!n.body) return;     /* нет kinematic body — ничего создать не сможем */
  const oldPos = n.body.translation();
  /* удалить kinematic body и контроллер */
  try { world.removeCollider(n.col, false); } catch(e){}
  try { world.removeRigidBody(n.body); } catch(e){}
  n.body = null;
  /* скрыть оригинальную модель */
  n.root.visible = false;
  /* создать ragdoll — с yaw: труп падает лицом туда, куда смотрел NPC */
  const r = makeRagdoll({ x: oldPos.x, y: oldPos.y - .925*(n.bodyScale || 1), z: oldPos.z }, impactVel, n.root, n.yaw);
  n.ragdoll = true;
  n.ragdollBodies = r.parts;
  n.ragdollJoints = r.joints;
  n.ragdollVisuals = r.visuals;
  n.ragdollMuscles = r.muscles;
  n.dieT = 0;
  /* помечаем ragdoll-тела: какой NPC им владеет (чтобы можно было подобрать) */
  for (const k in r.parts) {
    const b = r.parts[k];
    if (b) { b.userData = b.userData || {}; b.userData.npcId = n.id; b.userData.ragdollPart = k; }
    ragdollByHandle.set(b.handle, { npc: n, part: k });
  }
  /* эффект: кровь-куски */
  dust(new THREE.Vector3(impactPoint.x, impactPoint.y, impactPoint.z), 0xc0392b, 8);
  sparks(new THREE.Vector3(impactPoint.x, impactPoint.y, impactPoint.z), 4);
  sfx.hurt();
  addShake(.12);
}
function npcRemoveRagdoll(n){
  if (!n.ragdoll) return;
  for (const k in n.ragdollBodies) {
    const b = n.ragdollBodies[k];
    if (b) { try { ragdollByHandle.delete(b.handle); } catch(e){} }
    if (b._mesh) { scene.remove(b._mesh); b._mesh.traverse(o => { if (o.isMesh && o.geometry) { try { o.geometry.dispose(); } catch(e){} } }); }
    if (b._mesh2) { scene.remove(b._mesh2); }
    try { world.removeRigidBody(b); } catch(e){}
  }
  n.ragdollBodies = null; n.ragdollJoints = null; n.ragdollVisuals = null; n.ragdollMuscles = null;
}

/* ---------- обновление одного NPC ---------- */
function npcUpdate(n, dt){
  /* ВАЖНО: труп тоже должен обновляться — иначе ragdoll-меши не копируют позиции из физики и остаются невидимыми */
  if (!n.alive && !n.ragdoll) return;
  /* ragdoll: только копируем позиции частей из физики */
  if (n.ragdoll) {
    n.dieT += dt;
    n._ragdollAwake = false;
    n.animMoving = false;
    /* «мышцы и связки»: конусные лимиты + тонус — тело не складывается в коробку */
    ragdollMuscles(n, dt);
    /* Anti-NaN защита для рэгдолла: клампим скорости каждой части.
       Лимиты высокие (42 м/с / 26 рад/с) — труп реально летит от взрыва и кувыркается. */
    for (const k in n.ragdollBodies) {
      const b = n.ragdollBodies[k];
      if (!b) continue;
      /* ОПТИМИЗАЦИЯ «СОН»: спящая часть не движется — клампы и копирование
         меша не нужны (меш уже на месте, NaN у спящего возникнуть не может).
         ПринуЖительный сон трупов делает большую часть кадров пустой. */
      if (b.isSleeping()) continue;
      n._ragdollAwake = true;
      try {
        const lv = b.linvel();
        const lsp = Math.hypot(lv.x, lv.y, lv.z);
        if (!Number.isFinite(lsp) || lsp > 42) {
          const k2 = (lsp > 0 && Number.isFinite(lsp)) ? 42/lsp : 0;
          b.setLinvel({ x:(lv.x||0)*k2, y:(lv.y||0)*k2, z:(lv.z||0)*k2 }, true);
        }
        const av = b.angvel();
        const asp = Math.hypot(av.x, av.y, av.z);
        if (!Number.isFinite(asp) || asp > 26) {
          const k2 = (asp > 0 && Number.isFinite(asp)) ? 26/asp : 0;
          b.setAngvel({ x:(av.x||0)*k2, y:(av.y||0)*k2, z:(av.z||0)*k2 }, true);
        }
      } catch(e){}
      const t = b.translation(), r = b.rotation();
      /* если позиция NaN — удаляем рэгдолл целиком (повреждённое состояние) */
      if (!Number.isFinite(t.x) || !Number.isFinite(t.y) || !Number.isFinite(t.z)) {
        npcRemoveRagdoll(n);
        n.alive = false; n.ragdoll = false;
        return;
      }
      if (b._mesh) { b._mesh.position.set(t.x, t.y, t.z); b._mesh.quaternion.set(r.x, r.y, r.z, r.w); }
    }
    /* ПРИНУДИТЕЛЬНЫЙ СОН: у лимитов суставов есть невидимая микровибрация (±0.001
       рад на упоре), а в КУЧЕ трупов зажатая конечность может вечно хлестать
       (клин: контакты и суставы давят врозь — равновесия физически не существует,
       проверено: даже 120 Гц и 20 итераций не собирают кучу). Решение как в больших
       играх: тело спокойно 2.5с → замораживаем намертво. Будит автоматически:
       взрыв, захват, толчок бодрого тела. */
    if (!(held && held.npc === n)) {
      let calm = true, awake = false;
      for (const k in n.ragdollBodies) {
        const b = n.ragdollBodies[k];
        if (!b || b.isSleeping()) continue;
        awake = true;
        const lv = b.linvel(), av = b.angvel();
        /* лин. порог низкий (реального полёта/скольжения нет), угловой высокий —
           хлещущая в куче конечность замерзает в правдоподобной фазе */
        if (Math.hypot(lv.x,lv.y,lv.z) > 1.2 || Math.hypot(av.x,av.y,av.z) > 8) { calm = false; break; }
      }
      if (awake && calm) {
        /* СОГЛАСОВАННАЯ ЗАМОРОЗКА: соседние трупы (2.5м) должны тоже быть спокойны
           или уже спать — иначе замороженное тело разбудят их толчки и начнётся
           цикл сон-пробуждение-сон (вечная возня в куче) */
        let neighborsCalm = true;
        const _tp = n.ragdollBodies.torso.translation();
        for (const m of npcs) {
          if (m === n || !m.ragdoll || !m.ragdollBodies || !m.ragdollBodies.torso) continue;
          const _q = m.ragdollBodies.torso.translation();
          if (Math.hypot(_q.x-_tp.x, _q.y-_tp.y, _q.z-_tp.z) > 2.5) continue;
          const mAsleep = Object.values(m.ragdollBodies).every(b => !b || b.isSleeping());
          if (!mAsleep && !(m.calmT > 0)) { neighborsCalm = false; break; }
        }
        if (neighborsCalm) {
          n.calmT = (n.calmT || 0) + dt;
          if (n.calmT >= 2.5) {
            n.calmT = 0;
            for (const k in n.ragdollBodies) { try { n.ragdollBodies[k].sleep(); } catch(e){} }
          }
        } else n.calmT = 0;
      } else n.calmT = 0;
      /* защита от «замёрз в воздухе»: спящий труп раз в секунду проверяет опору
         под торсом лучом (луч игнорирует собственные части рэгдолла группами);
         опора исчезла (обломок удалён / дом снесён) — будим всё тело */
      if (!awake) {
        n.supT = (n.supT || 0) + dt;
        if (n.supT >= 1) {
          n.supT = 0;
          try {
            const tp = n.ragdollBodies.torso.translation();
            if (tp.y > .6) {
              const ray = new RAPIER.Ray({ x: tp.x, y: tp.y, z: tp.z }, { x: 0, y: -1, z: 0 });
              /* группы луча: membership 0x0004, filter всё кроме рэгдолла (0x0002) */
              const hit = world.castRay(ray, tp.y + .3, true, undefined, 0x0004FFFD, undefined, undefined);
              if (!hit) { for (const k in n.ragdollBodies) { try { n.ragdollBodies[k].wakeUp(); } catch(e){} } }
            }
          } catch(e){}
        }
      }
    }
    /* авто-возрождение отключено — трупы остаются навсегда (до перегенерации мира/перезагрузки страницы).
       Очистка происходит в newVillageCleanup() через npcRemoveRagdoll(n). */
    return;
  }
  /* ПАНИКА ТИКАЕТ ВСЕГДА — ДО LOD-ветки (v6b): раньше fleeT тикал только
     при alertT>0 и только на LOD0/1 — две «заморозки»: 1) после взрыва
     alertT (4.5-6.5с) кончался раньше fleeT (5-8.6с) — паника замерзала
     навсегда, NPC бесконечно генерил цели и бежал 5 м/с; 2) убежавший за
     50 м NPC уходил в LOD2 — там таймеры вообще не тикали, и при подходе
     игрока «ожившая» паника продолжалась. Теперь оба тикают безусловно. */
  if (n.fleeT > 0) n.fleeT = Math.max(0, n.fleeT - dt);
  if (n.alertT > 0) n.alertT -= dt;
  /* LOD: далёкие NPC реже думают и не двигают ногами */
  const distToPlayer = n.pos.distanceTo(player.pos);
  n.lod = distToPlayer < 20 ? 0 : (distToPlayer < 50 ? 1 : 2);
  if (n.lod === 2) {
    /* упрощённое обновление: только если игрок подошёл близко — полноценное */
    n.visY = n.pos.y; n.airT = 0;   /* чтобы при возврате на LOD0/1 не было рывка */
    n.root.position.copy(n.pos);
    n.root.rotation.y = n.yaw;
    /* для умных теней: далёкий NPC всё равно ДВИЖЕТСЯ телом (root), даже без анимации ног */
    const ddx2 = n.pos.x - (n._lpx ?? n.pos.x), ddz2 = n.pos.z - (n._lpz ?? n.pos.z);
    n.animMoving = !n.onGround || (ddx2*ddx2 + ddz2*ddz2) > 4e-4;
    n._lpx = n.pos.x; n._lpz = n.pos.z;
    return;
  }

  /* flee AI: если alertT > 0 — NPC знает про игрока. Если fleeT > 0 — убегает.
     когда alertT спадает, возвращается к wander. */
  /* БАГ «после гранаты убегают БЕСКОНЕЧНО»: fleeT тикал ТОЛЬКО внутри
     alertT>0. После взрыва alertT (4.5-6.5с) кончался РАНЬШЕ fleeT (5-8.6с)
     — таймер паники «замерзал» навсегда, NPC бесконечно генерил новые цели
     и бежал 5 м/с (после выстрелов паника была короче и успевала дотикать).
     Теперь паника тикает ВСЕГДА и гарантированно заканчивается. */
  if (n.alertT > 0) {
    /* обновим lastPlayerPos если видим игрока и не в панике */
    const dpl = n.pos.distanceTo(player.pos);
    if (dpl < 14) {
      n.lastPlayerPos = player.pos.clone();
      if (n.alertT < 1.5) n.alertT = 1.5;   /* не забываем, пока видим */
    }
  }

  n.thinkT -= dt;
  if (n.idleT > 0) n.idleT -= dt;   /* ПРОСТОЙ: досчитываем время «постоять» */
  if (n.jumpCd > 0) n.jumpCd = Math.max(0, n.jumpCd - dt);   /* БАГ: кулдаун
     прыжка никогда не тикал — после ПЕРВОГО прыжка NPC навсегда терял
     способность прыгать (jumpProbe всегда false), застревания лечились
     только телепортом. Теперь прыжки через препятствия работают */
  if (n.thinkT <= 0) {
    n.thinkT = n.lod === 0 ? .25 : .5;
    let goal = null;
    if (n.fleeT > 0 && n.lastPlayerPos) {
      n.idleT = 0;   /* паника отменяет простой */
      /* FLEE: направление — от последней позиции игрока + ЛИЧНЫЙ угол fleeJit:
         толпа разбегается ВЕЕРОМ, а не одной колонной. Застряв у стены —
         fleeJit меняется (в обработке wallBlocked ниже). */
      const away = n.pos.clone().sub(n.lastPlayerPos);
      away.y = 0;
      if (away.lengthSq() < .01) away.set(Math.random()-.5, 0, Math.random()-.5);
      const ang = Math.atan2(away.z, away.x) + (n.fleeJit ?? 0);
      away.set(Math.cos(ang), 0, Math.sin(ang));
      const GDIST = 17 + Math.random()*9;      /* убегаем на 17–26 м */
      goal = n.pos.clone().addScaledVector(away, GDIST);
      /* не пятимся в угол карты: цель прижалась к краю — доворачиваем к центру */
      const mg = 12;
      if (goal.x < mg || goal.x > Wm - mg || goal.z < mg || goal.z > Dm - mg) {
        _d2.set(Wm*.5 - n.pos.x, 0, Dm*.5 - n.pos.z);
        if (_d2.lengthSq() > .01) { _d2.normalize(); goal.copy(n.pos).addScaledVector(_d2, GDIST); }
      }
      goal.x = THREE.MathUtils.clamp(goal.x, 1, Wm - 1);
      goal.z = THREE.MathUtils.clamp(goal.z, 1, Dm - 1);
      n.lastGoal = goal.clone();
      /* чаще репас за паники */
      n.repathT = Math.min(n.repathT, .3);
    } else if (n.idleT > 0) {
      /* ПРОСТОЙ: стоит на месте, осматривается (дыхание/перенос веса —
         в анимации ниже); путь сброшен → wantSpeed останется нулевым */
      n.path = null; n.pathI = 0; n.lastGoal = null;
      n.thinkT = .35;
    } else if (n.lastGoal && n.pos.distanceTo(n.lastGoal) > 1.5) {
      goal = n.lastGoal;
    } else {
      /* дошёл до цели: 45% — ПОСТОЯТЬ 2.5–9.5с (разнообразие толпы),
         иначе сразу новая цель */
      if (n.alertT <= 0 && Math.random() < .45) {
        n.idleT = 2.5 + Math.random() * 7;
        n.path = null; n.pathI = 0; n.lastGoal = null;
        n.thinkT = .3;
      } else {
        const poi = pickPoi(n.pos);
        goal = new THREE.Vector3(poi.x, n.pos.y, poi.z);
        n.lastGoal = goal.clone();
      }
    }
    n.repathT -= n.thinkT;
    if (goal && (n.repathT <= 0 || !n.path || n.pathI >= n.path.length)) {
      /* БЮДЖЕТ A*: не более 2 пересчётов путей на кадр — стая жителей, решивших
         «подумать» одновременно, больше не даёт всплеск в один кадр */
      if (astarBudget <= 0) { n.repathT = .04; }
      else {
        astarBudget--;
        n.repathT = 1.2 + Math.random() * 1.5;
        n.path = navFindPath({ x: n.pos.x, y: n.pos.y + .1, z: n.pos.z }, goal);
        n.pathI = 0;
        if (!n.path) n.path = [goal];
      }
    }
  }

  let moveX = 0, moveZ = 0, wantSpeed = 0;
  if (n.path && n.pathI < n.path.length) {
    const wp = n.path[n.pathI];
    _d2.set(wp.x - n.pos.x, 0, wp.z - n.pos.z);
    const d = _d2.length();
    if (d < .5) n.pathI++;
    else { _d2.divideScalar(d); moveX = _d2.x; moveZ = _d2.z; wantSpeed = n.fleeT > 0 ? 5 : 1.6; }   /* бег 5 м/с (18 км/ч — спринт), шаг как у человека */
  }
  /* Forward-probe: проверяем, нет ли динамического тела (обломка/кластера) прямо по курсу NPC.
     Если есть — немедленно сбрасываем путь, чтобы A* обошёл препятствие.
     Раньше NPC шли на обломки напролом потому что path мог быть расчитан 1.5 сек назад
     и устарел — обломок упал уже после расчёта пути. */
  if (wantSpeed > 0 && (moveX !== 0 || moveZ !== 0)) {
    const ml = Math.hypot(moveX, moveZ);
    if (ml > .01) {
      const dirX = moveX/ml, dirZ = moveZ/ml;
      const probeOrigin = { x: n.pos.x, y: n.pos.y + .3, z: n.pos.z };
      const probeDir = { x: dirX, y: 0, z: dirZ };
      const probeLen = 1.6;   /* смотрим на 1.6 м вперед */
      try {
        const ray = new RAPIER.Ray(probeOrigin, probeDir);
        const hit = world.castRay(ray, probeLen, true);
        if (hit && hit.collider) {
          const b = bodyOf(hit.collider);
          if (b) {
            /* только динамические тела — обломки, кластеры, рэгдолл-части */
            let isDyn = false;
            try {
              const bt = b.bodyType !== undefined ? (typeof b.bodyType === 'function' ? b.bodyType() : b.bodyType) : null;
              isDyn = (bt === RAPIER.RigidBodyType.Dynamic);
            } catch(e){}
            if (isDyn) {
              /* точно впереди препятствие-обломок — форсируем репас */
              n.repathT = Math.min(n.repathT, 0);
              n.path = null;
              /* и слегка замедляемся чтобы не врезаться пока путь пересчитывается */
              wantSpeed *= .3;
            }
          }
        }
      } catch(e){}
    }
  }
  const accel = n.onGround ? 10 : 3.5;
  const fric = n.onGround ? 8 : 1;
  const tvx = moveX * wantSpeed, tvz = moveZ * wantSpeed;
  const hasInput = Math.abs(tvx) > .1 || Math.abs(tvz) > .1;
  if (hasInput) {
    n.moveVel.x += (tvx - n.moveVel.x) * Math.min(1, accel*dt);
    n.moveVel.z += (tvz - n.moveVel.z) * Math.min(1, accel*dt);
  } else {
    n.moveVel.x *= Math.max(0, 1 - fric*dt);
    n.moveVel.z *= Math.max(0, 1 - fric*dt);
  }
  const mspd = Math.hypot(n.moveVel.x, n.moveVel.z);
  const ms = 5.2;   /* потолок чуть выше бега (5.0), чтобы разбег набирался полностью */
  if (mspd > ms) { n.moveVel.x *= ms/mspd; n.moveVel.z *= ms/mspd; }
  let tYaw;
  if (mspd > .5) tYaw = Math.atan2(-n.moveVel.x, -n.moveVel.z);
  else {
    /* ПРОСТОЙ: тело стоит и НЕ вращается. Осматривание ГОЛОВОЙ — заметное и
       живое: взгляд в сторону 20–37° (иногда чуть вверх/вниз) на 1–2.6с →
       плавный возврат вперёд → пауза 1.5–4.5с → снова взгляд (72%) или
       «иногда нет» — просто стоит (28%). Плюс дыхание, перенос веса, моргание */
    n.idleLookT = (n.idleLookT ?? 0) - dt;
    if (n.idleLookT <= 0) {
      if ((n.idleYawOff ?? 0) !== 0 || (n.idlePitchOff ?? 0) !== 0) {
        n.idleYawOff = 0; n.idlePitchOff = 0;              /* возврат взгляда вперёд */
        n.idleLookT = 1.5 + Math.random()*3;
      } else if (Math.random() < .72) {
        n.idleYawOff = (Math.random() < .5 ? -1 : 1) * (.35 + Math.random()*.3);
        n.idlePitchOff = Math.random() < .5 ? (Math.random()-.5)*.22 : 0;
        n.idleLookT = 1.1 + Math.random()*1.5;
      } else {
        n.idleLookT = 2 + Math.random()*3.5;               /* «иногда нет» */
      }
    }
    tYaw = n.yaw;
  }
  let dyw = tYaw - n.yaw;
  while (dyw > Math.PI) dyw -= Math.PI*2;
  while (dyw < -Math.PI) dyw += Math.PI*2;
  /* ПЛАВНЫЙ ПОВОРОТ: раньше 7 рад/с (400°/с) — тело почти мгновенно
     «щёлкалось» к новому курсу. Человек поворачивается дугой: шаг
     ~3.0 рад/с (172°/с), бег ~4.2 рад/с (240°/с) + плавное дотягивание
     у цели (ease-out) — разворот на беге читается как живой вираж */
  const turnRate = 3.0 + 1.2*(n.runF ?? 0);
  n.yaw += THREE.MathUtils.clamp(dyw * Math.min(1, 6*dt), -turnRate*dt, turnRate*dt);
  if (n.onGround) n.vel.y = -.5;   /* было -1.2: жёсткий прижим вдавливал капсулу в землю → микропровалы KCC */
  else { n.vel.y -= 24*dt; if (n.vel.y < -30) n.vel.y = -30; }
  const vx = n.moveVel.x, vz = n.moveVel.z;
  const wantMove = Math.hypot(vx, vz);
  if (wantMove > 1 && jumpProbe(n, vx/wantMove, vz/wantMove)) { n.vel.y = 8.4; n.jumpCd = .6; }
  const ctlSafe = f => { try { f(); } catch(e){} };
  if (n.onGround && n.vel.y <= .01) {
    ctlSafe(() => n.ctl.enableAutostep(S*1.35, false, false));
    ctlSafe(() => n.ctl.enableSnapToGround(.18));
  } else {
    ctlSafe(() => n.ctl.disableAutostep());
    ctlSafe(() => n.ctl.disableSnapToGround());
  }
  const des = { x: vx*dt, y: n.vel.y*dt, z: vz*dt };
  let mv = { x: des.x, y: 0, z: des.z }, gr = false;
  let kccOk = false;
  /* обнуляем флаг "заблокирован стеной" для этой frame */
  let wallBlocked = 0;   /* 0..1 — насколько сильно KCC урезал движение по XZ */
  try {
    n.ctl.computeColliderMovement(n.col, des);
    const cm = n.ctl.computedMovement();
    if (cm) { mv = cm; gr = !!n.ctl.computedGrounded(); kccOk = true;
      /* если хотим двигаться, а KCC урезал горизонталь > 60% — мы упёрлись в стену */
      const wantXZ = Math.hypot(des.x, des.z);
      const gotXZ = Math.hypot(cm.x, cm.z);
      if (wantXZ > .05 && gotXZ < wantXZ * .4) wallBlocked = 1 - gotXZ/wantXZ;
    }
  } catch(e){}
  if (!kccOk) {
    /* Fallback: ray-cast down from NPC feet to find ground. */
    const o = { x: n.pos.x, y: n.pos.y + .05, z: n.pos.z };
    const d = { x: 0, y: -1, z: 0 };
    try {
      const ray = new RAPIER.Ray(o, d);
      const hit = world.castRay(ray, 1.5, true);
      if (hit && hit.toi !== undefined && hit.toi < 1.5) {
        gr = true;
        n.vel.y = Math.max(n.vel.y, 0);
      }
    } catch(e){}
  }
  n.onGround = gr;
  /* Hard safety net for NPCs too: don't let them sink below ground top. */
  if (n.pos.y < S + .02 && n.vel.y <= 0) {
    n.pos.y = S + .02;
    if (n.vel.y < 0) n.vel.y = 0;
    gr = true; n.onGround = true;
  }
  if (gr) { n.vel.y = Math.max(n.vel.y, -1.2); n.fellT = 0; }
  n.pos.x += mv.x; n.pos.y += mv.y; n.pos.z += mv.z;
  n.pos.x = THREE.MathUtils.clamp(n.pos.x, .4, Wm-.4);
  n.pos.z = THREE.MathUtils.clamp(n.pos.z, .4, Dm-.4);
  if (n.pos.y < .05) {
    n.fellT += dt;
    if (n.fellT > .6) {
      const sp = pickVillagerSpawn();
      n.pos.set(sp.x, sp.y, sp.z);
      n.visY = sp.y; n.dipHold = 0; n.airT = 0;   /* телепорт: визуальный Y без догоняния */
      n.moveVel.set(0,0,0); n.path = null; n.repathT = 0; n.fellT = 0;
      try { n.body.setTranslation({ x: sp.x, y: sp.y+.1+.925*(n.bodyScale || 1), z: sp.z }, true); } catch(e){}
    }
  }
  /* WALL AVOIDANCE: если упёрлись в стену — пробуем скользить вдоль (перпендикуляр).
     Это не меняет физику (KCC уже двинул), а корректирует скорость на следующий фрейм,
     чтобы NPC начал двигаться вдоль стены, а не в неё. */
  if (wallBlocked > .5 && wantMove > .5) {
    /* вычисляем перпендикуляр к направлению движения */
    const pdirx = -n.moveVel.z, pdirz = n.moveVel.x;
    const pl = Math.hypot(pdirx, pdirz);
    if (pl > .01) {
      const sign = (n.wallSlideDir ?? 0) || (Math.random() < .5 ? 1 : -1);
      n.wallSlideDir = sign;
      /* подмешиваем перпендикулярное скольжение ПЛАВНО (~0.2с), а не рывком
         на 70% за один кадр — курс дугой обходит препятствие */
      n.wallBlend = (n.wallBlend ?? 0) + (.7*wallBlocked - (n.wallBlend ?? 0)) * Math.min(1, 5.5*dt);
      const blend = n.wallBlend;
      n.moveVel.x = n.moveVel.x*(1-blend) + (pdirx/pl)*wantMove*sign*blend;
      n.moveVel.z = n.moveVel.z*(1-blend) + (pdirz/pl)*wantMove*sign*blend;
    }
    /* быстро репасчим путь — возможно стена изменилась (обломок упал) */
    n.repathT = Math.min(n.repathT, .2);
    /* паника: бежим от игрока и упёрлись в стену надолго — МЕНЯЕМ угол бегства
       (обход препятствия с другой стороны), а не долбимся в одно место */
    if (n.fleeT > 0) {
      n.fleeWallT = (n.fleeWallT ?? 0) + dt;
      if (n.fleeWallT > .55) {
        n.fleeWallT = 0;
        n.fleeJit = (n.fleeJit ?? 0) + (Math.random() < .5 ? -1 : 1) * (.5 + Math.random()*.5);
        n.thinkT = 0; n.repathT = 0;
      }
    }
  } else {
    /* плавно забываем направление скольжения */
    n.wallSlideDir = 0;
    n.wallBlend = 0;
    n.fleeWallT = 0;
  }
  /* проверка stuck */
  const hist = n.posHistory;
  hist.push({ x: n.pos.x, z: n.pos.z, t: timeNow });
  if (hist.length > 60) hist.shift();
  if (wantMove > .5) {
    let recentMove = 0;
    for (let i = hist.length-1; i >= 1; i--) {
      if (timeNow - hist[i].t > .8) break;
      recentMove += Math.hypot(hist[i].x - hist[i-1].x, hist[i].z - hist[i-1].z);
    }
    if (recentMove < wantMove*.15) {
      n.stuckT += dt;
      /* прыжок раньше — после 0.5с стопа (было 0.8) */
      if (n.stuckT > .5 && n.onGround && n.jumpCd <= 0) {
        n.vel.y = 8.4; n.jumpCd = .6; n.stuckT = 0; n.path = null; n.repathT = 0; n.thinkT = 0;
      }
      /* полный сброс цели раньше — после 1.4с (было 2.5) + выбираем новый wander goal */
      if (n.stuckT > 1.4) {
        n.path = null; n.repathT = 0; n.stuckT = 0; n.thinkT = 0;
        n.moveVel.set(0,0,0); n.lastGoal = null;
        /* телепортируем чуть назад от текущего yaw, чтобы отлепиться от стены */
        const bx = n.pos.x + Math.sin(n.yaw)*.3;   /* НАЗАД от лица: раньше знак уводил ВПЕРЁД, в стену */
        const bz = n.pos.z + Math.cos(n.yaw)*.3;
        n.pos.x = THREE.MathUtils.clamp(bx, .4, Wm-.4);
        n.pos.z = THREE.MathUtils.clamp(bz, .4, Dm-.4);
      }
    } else n.stuckT = Math.max(0, n.stuckT - dt*2);
  } else n.stuckT = Math.max(0, n.stuckT - dt);
  try { n.body.setNextKinematicTranslation({ x: n.pos.x, y: n.pos.y + .925*(n.bodyScale || 1), z: n.pos.z }); } catch(e){}
  const speed = Math.hypot(mv.x, mv.z) / Math.max(dt, .001);
  /* ---- СГЛАЖЕННЫЙ ВИЗУАЛЬНЫЙ Y (анти-провалы ВНИЗ + анти-дёрганье ВВЕРХ) ----
     Корень ОСТАВШИХСЯ рывков вверх: у кромок вокселей computedGrounded()
     «мигает» false на 1–2 кадра, а старый фильтр при !onGround мгновенно
     отключался и копировал autostep-выталкивание (до 27 см) → «дёрг на
     миллисекунду» именно НА ХОДЬБЕ (в простое KCC неподвижен — миганий
     нет, поэтому в стоянии всё было чисто). Теперь точная копия —
     только в НАСТОЯЩЕМ полёте: в воздухе дольше 80 мс (n.airT), при
     прыжке или быстром падении (|vel.y| велик) или телепорте (|dy|>0.3).
     Однокадровые мигания и ступеньки гасятся: вверх — удержание до
     3 кадров + плавный подъём с КАПОМ 3.4 м/с (ступенька 20–27 см =
     естественный «шаг» за ~0.1–0.15 с, без «замри-скок»), вниз —
     удержание + быстрое догоняние. */
  {
    if (n.visY === undefined) n.visY = n.pos.y;
    if (n.upHold === undefined) n.upHold = 0;
    n.airT = (n.airT || 0) + dt;
    if (n.onGround) n.airT = 0;
    const dy = n.pos.y - n.visY;
    const hardSync = n.airT > .08 || n.vel.y > 2.5 || n.vel.y < -4 || dy > .3 || dy < -.3;
    if (hardSync) { n.visY = n.pos.y; n.dipHold = 0; n.upHold = 0; }
    else if (dy < -.02 && (n.visY - n.pos.y) < .13 && n.dipHold < 4) {
      n.dipHold++; n.upHold = 0;        /* похоже на однокадровый провал — держим */
    } else if (dy > .015 && (n.pos.y - n.visY) < .3 && n.upHold < 3) {
      n.upHold++; n.dipHold = 0;        /* однокадровый выброс ВВЕРХ — держим (до 3 кадров) */
    } else {
      /* мягкое догоняние; вверх — с КАПОМ 3.4 м/с (ступенька поднимается
         как настоящий шаг), вниз — быстрее */
      if (dy > 0) n.visY += Math.min(dy, Math.min(dy * Math.min(1, 18*dt), 3.4*dt));
      else n.visY += dy * Math.min(1, 26*dt);
      if (dy < .005) n.upHold = 0;
      if (dy > -.005) n.dipHold = 0;
    }
  }
  /* ---- фазы и амплитуды; БЕГ — отдельный слой runF (0=шаг, 1=бег) ---- */
  const runTgt = (n.fleeT > 0 && speed > 1.2) ? 1 : 0;
  n.runF = (n.runF ?? 0) + (runTgt - (n.runF ?? 0)) * Math.min(1, 6*dt);
  const runF = n.runF;
  /* каденция: шаг ~136 шаг/мин при 1.6 м/с, бег ~195 шаг/мин при 5 м/с —
     длина шага ~1.55 м как у реального спринтера-любителя (стопы не
     «проскальзывают» — раньше скорость маха была больше скорости земли,
     это и выглядело мультяшно). Два ритма блендятся, переход плавный */
  const cadW = 2.0 + speed*3.2, cadR = 2.0 + speed*1.64;
  /* v29: женская походка — чуть мельче шаг (амплитуды ×.88) и чуть чаще
     каденция (×1.07): читается лёгкой, без отдельного рига */
  const femK = (n.female ?? n.root.userData.female) ? .88 : 1, femC = (n.female ?? n.root.userData.female) ? 1.07 : 1;
  n.walkPh += dt * (cadW*(1-runF) + cadR*runF) * femC;
  const ampT = speed > .35 ? Math.min(1, speed/1.7) : 0;
  n.animAmp += (ampT - n.animAmp) * Math.min(1, 8*dt);   /* плавный старт/остановка шага */
  const amp = n.animAmp;
  n.airPose += ((n.onGround ? 0 : 1) - n.airPose) * Math.min(1, 9*dt);
  const air = n.airPose;
  const ph = n.walkPh, seed = n.animSeed;
  /* для умных теней: тело реально двигается (смещение > 2см/кадр или в прыжке) */
  {
    const ddx2 = n.pos.x - (n._lpx ?? n.pos.x), ddz2 = n.pos.z - (n._lpz ?? n.pos.z);
    n.animMoving = !n.onGround || (ddx2*ddx2 + ddz2*ddz2) > 4e-4;
    n._lpx = n.pos.x; n._lpz = n.pos.z;
  }
  const ud = n.root.userData;
  /* ---- НОГИ: бедро + СГИБАЮЩЕЕСЯ КОЛЕНО. Сгиб в фазе переноса (косинус
     со сдвигом), выпрямление к постановке ноги — как у человека.
     В полёте — поджатие (разноимённое, как в реальном прыжке). ---- */
  /* БЕГ — БОГАТЫЙ риг, но реалистичный: размах бедра ±0.74 рад (42°),
     колено в переносе до ~80° — читается как настоящий «шаг спринтера»
     (не картонная кукла, но и не мультяшное 92°), у постановки нога
     почти прямая. Каденция привязана к скорости — стопы не
     проскальзывают. Плюс персональная асимметрия шага — без «строя» */
  const asym = .93 + .14 * ((seed*7.13) % 1);
  const hipAmp = (.44 + .30*runF) * amp * asym * femK;
  const hipL = Math.sin(ph) * hipAmp;
  const hipR = Math.sin(ph + Math.PI) * hipAmp;
  const kneeAmp = (.85 + .55*runF) * amp * femK;
  const kneePh = .35 - .28*runF;
  const kneeL = -Math.max(0, Math.cos(ph - kneePh)) * kneeAmp;
  const kneeR = -Math.max(0, Math.cos(ph - kneePh + Math.PI)) * kneeAmp;
  ud.legL.rotation.x = hipL*(1-air) + (.42 + .25*runF)*air;
  ud.legR.rotation.x = hipR*(1-air) - (.18 - .10*runF)*air;
  ud.shinL.rotation.x = kneeL*(1-air) - (.55 - .20*runF)*air;
  ud.shinR.rotation.x = kneeR*(1-air) - (.30 - .10*runF)*air;
  /* ---- ТОРС: бёдра и плечи вращаются в противофазе, лёгкий крен,
     наклон вперёд с ростом скорости; на месте — ДЫХАНИЕ и перенос веса ---- */
  const breathe = Math.sin(timeNow*1.7 + seed) * .5 + .5;
  ud.torso.position.y = .92 + Math.abs(Math.cos(ph))*(.012 + .01*runF)*amp + breathe*.010*(1-amp*.6);
  ud.torso.rotation.y = -Math.sin(ph) * (.07 + .055*runF) * amp;   /* бег: противовращение плеч ~7° */
  ud.torso.rotation.z = Math.sin(ph) * (.032 + .02*runF) * amp + Math.sin(timeNow*.5 + seed) * .022 * (1-amp);
  /* НАКЛОН ВПЕРЁД: при «лице в −Z» минус по X = наклон вперёд. Шаг — лёгкий
     ~4°, спринт — уверенный ~9.5° (как реальный бегун в рывке), с плавным
     ростом от скорости: не картонный «столб», но и не мультяшные 13° */
  ud.torso.rotation.x = -.012 - .055*amp*(1-runF)*Math.min(1, speed/1.6)
                      - (.07 + .095*Math.min(1, speed/5))*runF*amp
                      + breathe*.006*(1-amp);
  /* ---- РУКИ: противофаза к ногам + СГИБАЮЩИЙСЯ ЛОКОТЬ (сгиб при махе
     вперёд, выпрямление впереди); v10: на месте руки чуть разведены-
     «приподняты» (.095 рад — заявка игрока), локотки чуть согнуты ---- */
  /* РУКИ В БЕГУ — живой спринт: мах плеча ±0.64 рад, локти согнуты ~78°
     и ДОКАЧИВАЮТ мах (угол «дышит» ~70–90°, не замороженный робот),
     кисти чуть скрещиваются к корпусу на махе вперёд; на шаге — прежний
     свободный мах, ничего не поменялось */
  const shAmp = (.42 + .22*runF) * amp * femK;
  const shL = -Math.sin(ph) * shAmp, shR = Math.sin(ph) * shAmp;
  const elbSwL = Math.max(0, -Math.cos(ph)) * (.55 - .3*runF) * amp * femK;
  const elbSwR = Math.max(0,  Math.cos(ph)) * (.55 - .3*runF) * amp * femK;
  const elbPose = (.12 + 1.25*runF) * amp;   /* в беге локти согнуты ~78° */
  const idleSway = Math.sin(timeNow*1.7 + seed) * .02 * (1-amp);
  ud.armL.rotation.x = shL*(1-air) - .55*air + idleSway;
  ud.armR.rotation.x = shR*(1-air) - .35*air - idleSway;
  ud.armL.rotation.z = -.095*(1 - .3*runF*amp) - Math.max(0, -Math.sin(ph))*.05*runF*amp - .45*air;
  ud.armR.rotation.z = .095*(1 - .3*runF*amp) + Math.max(0,  Math.sin(ph))*.05*runF*amp + .45*air;
  ud.forearmL.rotation.x = (elbSwL + elbPose)*(1-air) + .05*(1-amp) + .25*air;
  ud.forearmR.rotation.x = (elbSwR + elbPose)*(1-air) + .05*(1-amp) + .15*air;
  /* ---- ГОЛОВА: в простое — ОСМОТРЕНИЕ (заметные повороты 20–37°, иногда
     с наклоном вверх/вниз, иногда пауза «просто стоит»); трогается с
     места — взгляд ПЛАВНО возвращается вперёд (~0.6с, голова
     «выпрямляется» прямо на первых шагах) и дальше стабилен: голова
     компенсирует наклон корпуса, глаза смотрят вперёд, не в землю/небо ---- */
  if (n.headPitch === undefined) n.headPitch = 0;
  if (n.headYawV === undefined) { n.headYawV = 0; n.headPitchV = 0; }
  const idleNow = amp < .25 && mspd < .5;
  if (!idleNow) { n.idleYawOff = 0; n.idlePitchOff = 0; n.gazing = false; }
  let lookTgt = 0, pitchTgt = 0;
  if (idleNow) {
    /* ВЗГЛЯД НА ИГРОКА «В ЛИЦО»: если игрок рядом (замечаем на 6.5 м,
       отпускаем за 8.5 м — гистерезис, чтобы взгляд не мигал на границе)
       и NPC не в панике — голова тянется к КАМЕРЕ игрока: yaw + pitch на
       его глаза, с крошечным «живым» дрожанием взгляда. Игрок почти за спиной
       (|dyw|>2.1, ~120°) — шея не сворачивается: не тянемся; в бок
       поворачиваемся «через плечо» до 57°. При старте ходьбы
       gazing сбрасывается выше — голова по инерции пружины докрутится вперёд */
    const dpx = player.pos.x - n.pos.x, dpz = player.pos.z - n.pos.z;
    const dplH = Math.hypot(dpx, dpz);
    const canGaze = !playerDead && (n.fleeT ?? 0) <= 0 &&
                    dplH < ((n.gazing ?? false) ? 8.5 : 6.5);
    if (canGaze) {
      if (!n.gazing) { n.gazing = true; n.gazeDelay = .1 + Math.random()*.35; }  /* «заметил» — не мгновенно */
      if ((n.gazeDelay ?? 0) > 0) n.gazeDelay -= dt;
      else {
        const yawTo = Math.atan2(-dpx, -dpz);
        let dyw = yawTo - n.yaw;
        while (dyw > Math.PI) dyw -= Math.PI*2;
        while (dyw < -Math.PI) dyw += Math.PI*2;
        if (Math.abs(dyw) <= 2.1) {
          /* v10.1: цель взгляда — РОВНО КАМЕРА игрока (player.currEye,
             учитывает присед/прыжок), а не точка на 7 см выше — раньше
             NPC смотрели «над игроком» (баг). Глаза NPC — на 1.70×рост/188
             (v12: у каждого свой рост 160–200 см).
             Наклон вверх/вниз — АНАТОМИЧНО: вниз до ~35°, вверх до ~33°
             (живая шея, не 90°); рядом дистанцию не сглаживаем — игрок
             присел у самых ног → NPC честно наклоняет голову вниз */
          const dyE = (player.pos.y + player.currEye) - (n.pos.y + 1.70*(n.bodyScale || 1));
          lookTgt = THREE.MathUtils.clamp(dyw, -1.0, 1.0) + Math.sin(timeNow*1.31 + seed)*.013;
          pitchTgt = THREE.MathUtils.clamp(Math.atan2(dyE, Math.max(.3, dplH)), -.62, .58) + Math.sin(timeNow*.87 + seed*1.7)*.011;
        }
      }
    } else {
      n.gazing = false;
      lookTgt = n.idleYawOff ?? 0;
      pitchTgt = n.idlePitchOff ?? 0;
    }
  }
  /* ПЛАВНЫЙ ПОВОРОТ «ПО-ЧЕЛОВЕЧЕСКИ»: вместо экспоненты (резкий старт +
     долгий хвост) — пружина с демпфером: голова НАБИРАЕТ скорость плавно,
     плавно докручивается, с лёгким естественным «перелётом» и возвратом,
     как шея живого человека (взгляд ~30° за 0.5-0.7 с). На ходьбе пружина
     чуть жёстче — голова быстрее стабилизируется вперёд, но по инерции,
     без рывка при переходе стояние→ходьба */
  const hk = idleNow ? 30 : 46, hd = idleNow ? 8.4 : 11.5;
  n.headYawV += ((lookTgt - n.headYaw)*hk - n.headYawV*hd) * dt;
  n.headYaw += n.headYawV * dt;
  n.headPitchV += ((pitchTgt - n.headPitch)*hk - n.headPitchV*hd) * dt;
  n.headPitch += n.headPitchV * dt;
  ud.headG.rotation.y = n.headYaw + Math.sin(ph) * .05 * amp * (1 - .4*runF);
  /* v12: шея гнётся (45% наклона) — воротник/шея/голова наклоняются ВМЕСТЕ,
     голова добавляет остальные 55%. Суммарный наклон = headPitch —
     прицел взгляда/клампы ±35°/33° НЕ ИЗМЕНИЛИСЬ ни на градус */
  ud.neckBend.rotation.x = n.headPitch * .45;
  ud.headG.rotation.x = n.headPitch * .55 - ud.torso.rotation.x * .55 - breathe*.008*(1-amp);
  ud.headG.rotation.z = -ud.torso.rotation.z * .45;
  /* ---- МОРГАНИЕ: интервал 2.2–6.7с (в среднем человек моргает ~15–20
     раз/мин), плавное закрытие/открытие (полный цикл 0.24с), иногда
     двойное. Полностью закрытый глаз = тонкая тёмная щёлочка. ---- */
  if (n.blinkA < 0) {
    n.blinkT -= dt;
    if (n.blinkT <= 0) { n.blinkA = 0; n.blinkNext = Math.random() < .14 ? 1 : 0; }
  }
  if (n.blinkA >= 0) {
    n.blinkA += dt / .24;
    let open;
    if (n.blinkA < .33) open = 1 - THREE.MathUtils.smoothstep(n.blinkA/.33, 0, 1);
    else if (n.blinkA < .5) open = 0;
    else open = THREE.MathUtils.smoothstep((n.blinkA - .5)/.5, 0, 1);
    if (n.blinkA >= 1) {
      n.blinkA = -1; open = 1;
      if (n.blinkNext > 0) { n.blinkT = .12 + Math.random()*.2; n.blinkNext = 0; }
      else n.blinkT = 2.2 + Math.random()*4.5;
    }
    ud.eyes.scale.y = .12 + .88 * open;
  }
  /* ---- итоговое положение модели ---- */
  const bobY = (Math.abs(Math.cos(ph)) - .55) * (.05 + .06*runF) * amp;   /* в беге вертикальный ход ~5–6 см — живой, не «кенгуру» */
  n.root.position.set(n.pos.x, n.visY + bobY, n.pos.z);
  n.root.rotation.y = n.yaw;
}

/* ---------- проверка ударов по NPC (для ragdoll) ---------- */
function npcCheckImpacts(){
  for (const n of npcs) {
    if (!n.alive || n.ragdoll) continue;
    /* проверяем динамические тела рядом.
       ОПТИМИЗАЦИЯ: позиции из КЭША (d.tx/c.tx обновляются в updateDebris/updateClusters),
       спящие тела скипаются (asleep-флаг) — раньше было NPC×(мусор+кластеры)
       wasm-вызовов translation() каждый кадр (тысячи при куче обломков). */
    const npcPos = n.pos;
    for (const d of debris) {
      if (d.grabbed || d.removed || d.asleep) continue;
      const dx = d.tx - npcPos.x, dy = d.ty - (npcPos.y + .9*(n.bodyScale || 1)), dz = d.tz - npcPos.z;
      const dist2 = dx*dx + dy*dy + dz*dz;
      if (dist2 < .8) {
        const lv = d.body.linvel();
        const sp = Math.hypot(lv.x, lv.y, lv.z);
        if (sp > 6) {
          /* удар — переходим в ragdoll */
          npcRagdollize(n, { x: lv.x*.5, y: Math.max(2, lv.y*.4), z: lv.z*.5 }, new THREE.Vector3(d.tx, d.ty, d.tz));
          break;
        }
      }
    }
    if (n.ragdoll) continue;
    for (const c of clusters) {
      if (c.dead || c.held || c.asleep) continue;
      const dx = c.tx - npcPos.x, dy = c.ty - (npcPos.y + .9*(n.bodyScale || 1)), dz = c.tz - npcPos.z;
      const dist2 = dx*dx + dy*dy + dz*dz;
      if (dist2 < 1.5) {
        const lv = c.body.linvel();
        const sp = Math.hypot(lv.x, lv.y, lv.z);
        if (sp > 5) {
          npcRagdollize(n, { x: lv.x*.3, y: Math.max(2, lv.y*.3), z: lv.z*.3 }, new THREE.Vector3(c.tx, c.ty, c.tz));
          break;
        }
      }
    }
  }
}

/* ---------- спавн всех жителей ---------- */
function spawnAllNpcs(count){
  /* удалить старых */
  for (const n of npcs) {
    if (n.body) { try { world.removeRigidBody(n.body); } catch(e){} }
    if (n.ragdoll) npcRemoveRagdoll(n);
    scene.remove(n.root);
    /* слитые геометрии частей — уникальны на NPC, освобождаем */
    n.root.traverse(o => { if (o.isMesh && o.geometry) { try { o.geometry.dispose(); } catch(e){} } });
  }
  npcs.length = 0;
  for (let i = 0; i < count; i++) {
    const sp = pickVillagerSpawn();
    npcCreate(sp);
  }
  $('villagers').textContent = npcs.length;
}

