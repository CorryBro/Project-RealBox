function showFatalError(err, tag){
  const msg = (err && err.message) || String(err);
  /* Pointer Lock / autoplay ошибки — НЕ фатальные (просто продолжаем играть) */
  if (msg.includes('Pointer Lock') || msg.includes('NotAllowedError') ||
      msg.includes('user gesture') || msg.includes('autoplay') ||
      msg.includes('AudioContext') || msg.includes('play()')) {
    console.warn('[ignored]', tag, msg);
    return;
  }
  console.error('[' + (tag||'fatal') + ']', err);
  const errBox = $('errBox');
  if (!errBox) return;
  errBox.classList.add('show');
  const stack = (err && err.stack) || '';
  $('errMsg').textContent = 'Ошибка' + (tag ? ' [' + tag + ']' : '') + ': ' + msg;
  $('errStack').textContent = stack ? stack.slice(0, 2000) : '(нет стека)';
}
window.addEventListener('error', e => showFatalError(e.error || e.message, 'window-error'));
window.addEventListener('unhandledrejection', e => showFatalError(e.reason, 'promise'));
try {
  $('errReload').addEventListener('click', () => location.reload());
} catch(e){}

