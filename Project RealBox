      const t = b.translation(), lv = b.linvel();
      out.parts[k] = {
        dx: +(t.x-tp.x).toFixed(3), dy: +(t.y-tp.y).toFixed(3), dz: +(t.z-tp.z).toFixed(3),
        dist: +Math.hypot(t.x-tp.x, t.y-tp.y, t.z-tp.z).toFixed(3),
        spd: +Math.hypot(lv.x, lv.y, lv.z).toFixed(2), y: +t.y.toFixed(3)
      };
    }
    /* углы суставов относительно анатомического покоя — для автотестов позы */
    try {
      const Q = (b) => { const r = b.rotation(); return new THREE.Quaternion(r.x, r.y, r.z, r.w); };
      const cone = (a, b) => {
        const qr = Q(a).invert().multiply(Q(b));
        const w = qr.w >= 0 ? qr.w : -qr.w;
        return +(2 * Math.acos(Math.min(1, w))).toFixed(3);
      };
      const hinge = (a, b) => {
        const qr = Q(a).invert().multiply(Q(b));
        let ang = 2 * Math.atan2(qr.x, qr.w);
        if (ang > Math.PI) ang -= 2*Math.PI; if (ang < -Math.PI) ang += 2*Math.PI;
        return +ang.toFixed(3);
      };
      const B = n.ragdollBodies;
      if (B.head)   out.angles.neck       = cone(B.torso, B.head);
      /* АНАТОМИЯ ШЕИ для автотестов:
         neckTilt  — наклон UP-оси головы относительно UP-оси торса (поворот не в счёт),
         neckAxial — проекция (голова−торс) на UP торса; в анатомической позе ≈ .49
         (полвысоты торса .29 + зазор шеи .07 + полвысоты головы .13); сильно меньше — голова
         «утонула» в торсе; headDist — |голова−торс| (провал внутрь < .30). */
      if (B.head) {
        const up = (bd) => { const q = Q(bd); return new THREE.Vector3(0, 1, 0).applyQuaternion(q); };
        const uT = up(B.torso), uH = up(B.head);
        out.angles.neckTilt = +uT.angleTo(uH).toFixed(3);
        const tp2 = B.torso.translation(), hp2 = B.head.translation();
        const dd = { x: hp2.x - tp2.x, y: hp2.y - tp2.y, z: hp2.z - tp2.z };
        out.neckAxial = +(dd.x*uT.x + dd.y*uT.y + dd.z*uT.z).toFixed(3);
        out.headDist  = +Math.hypot(dd.x, dd.y, dd.z).toFixed(3);
      }
      if (B.armU_L) out.angles.shoulderL  = cone(B.torso, B.armU_L);
      if (B.armU_R) out.angles.shoulderR  = cone(B.torso, B.armU_R);
      if (B.armL_L) out.angles.elbowL     = hinge(B.armU_L, B.armL_L);
      if (B.armL_R) out.angles.elbowR     = hinge(B.armU_R, B.armL_R);
      if (B.legU_L) out.angles.hipL       = cone(B.torso, B.legU_L);
      if (B.legU_R) out.angles.hipR       = cone(B.torso, B.legU_R);
      if (B.legL_L) out.angles.kneeL      = hinge(B.legU_L, B.legL_L);
      if (B.legL_R) out.angles.kneeR      = hinge(B.legU_R, B.legL_R);
      /* направление взгляда трупа (куда «смотрит» голова) */
      if (B.head) {
        const q = Q(B.head);
        const f = new THREE.Vector3(0, 0, -1).applyQuaternion(q);
        out.faceDir = { x: +f.x.toFixed(3), y: +f.y.toFixed(3), z: +f.z.toFixed(3) };
      }
    } catch(e){ out.anglesErr = String(e); }
    return out;
  }
};

