const vibSupported = ('vibrate' in navigator) && typeof navigator.vibrate === 'function';
if (!vibSupported) $('vibRow').style.display = 'none';
function vib(ms){ if (vibSupported && settings.vib && isTouch) { try { navigator.vibrate(ms); } catch(e){} } }

/* ---------- звук (процедурный) ---------- */
const AUD = { ctx: null, master: null, noise: null };
function audioInit(){
  if (AUD.ctx) { if (AUD.ctx.state === 'suspended') AUD.ctx.resume(); return; }
  const C = window.AudioContext || window.webkitAudioContext; if (!C) return;
  AUD.ctx = new C(); AUD.master = AUD.ctx.createGain();
  AUD.master.gain.value = settings.sound ? .5 : 0; AUD.master.connect(AUD.ctx.destination);
  const len = AUD.ctx.sampleRate * 1.2, buf = AUD.ctx.createBuffer(1, len, AUD.ctx.sampleRate), d = buf.getChannelData(0);
  for (let i = 0; i < len; i++) d[i] = Math.random()*2-1; AUD.noise = buf;
}
function setSound(v){ if (AUD.master) AUD.master.gain.value = v ? .5 : 0; }
function noiseHit({dur=.2,f0=800,f1=200,type='lowpass',g=.5,q=1,delay=0}){
  if (!AUD.ctx) return; const t = AUD.ctx.currentTime + delay;
  const src = AUD.ctx.createBufferSource(); src.buffer = AUD.noise;
  const f = AUD.ctx.createBiquadFilter(); f.type = type; f.Q.value = q;
  f.frequency.setValueAtTime(f0, t); f.frequency.exponentialRampToValueAtTime(Math.max(f1, 20), t+dur);
  const gn = AUD.ctx.createGain(); gn.gain.setValueAtTime(g, t); gn.gain.exponentialRampToValueAtTime(.001, t+dur);
  src.connect(f); f.connect(gn); gn.connect(AUD.master); src.start(t); src.stop(t+dur+.05);
}
function toneHit({f0=300,f1=100,type='sine',dur=.3,g=.4,delay=0}){
  if (!AUD.ctx) return; const t = AUD.ctx.currentTime + delay;
  const o = AUD.ctx.createOscillator(); o.type = type;
  o.frequency.setValueAtTime(f0, t); o.frequency.exponentialRampToValueAtTime(Math.max(f1, 20), t+dur);
  const gn = AUD.ctx.createGain(); gn.gain.setValueAtTime(g, t); gn.gain.exponentialRampToValueAtTime(.001, t+dur);
  o.connect(gn); gn.connect(AUD.master); o.start(t); o.stop(t+dur+.05);
}
const sfx = {
  step(){ noiseHit({dur:.05,f0:420,f1:180,g:.06}); },
  land(){ noiseHit({dur:.13,f0:320,f1:70,g:.3}); },
  vox(){ noiseHit({dur:.06,f0:3000,f1:800,type:'bandpass',g:.09,q:1.5}); },
  rumble(){ noiseHit({dur:.5,f0:180,f1:50,g:.4}); },
  bounce(){ toneHit({f0:430,f1:200,type:'triangle',dur:.05,g:.1}); },
  grab(){ toneHit({f0:600,f1:800,type:'triangle',dur:.06,g:.15}); },
  throw(){ noiseHit({dur:.22,f0:500,f1:1600,type:'bandpass',g:.25,q:2}); },
  crash(){ noiseHit({dur:.3,f0:400,f1:80,g:.35}); },
  clusterBreak(){ noiseHit({dur:.35,f0:1200,f1:150,type:'bandpass',g:.4,q:.8}); noiseHit({dur:.4,f0:300,f1:60,g:.35,delay:.05}); },
  clusterHit(){ noiseHit({dur:.07,f0:900,f1:280,type:'bandpass',g:.16,q:1.3}); toneHit({f0:160,f1:80,type:'sine',dur:.05,g:.12}); },
  hurt(){ toneHit({f0:300,f1:120,type:'sawtooth',dur:.12,g:.2}); },
  npcHurt(){ noiseHit({dur:.08,f0:800,f1:300,type:'bandpass',g:.2,q:1.4}); },
  bird(){ toneHit({f0:2400,f1:3200,type:'sine',dur:.08,g:.07}); toneHit({f0:2600,f1:3400,type:'sine',dur:.08,g:.06,delay:.12}); },
  chime(){ toneHit({f0:880,f1:660,type:'sine',dur:.4,g:.2}); toneHit({f0:1100,f1:880,type:'sine',dur:.5,g:.15,delay:.18}); },
  wind(){ noiseHit({dur:1.5,f0:200,f1:120,type:'lowpass',g:.05,q:1.5}); },
  /* оружие — перенесено из шутер-версии */
  shoot(){ noiseHit({dur:.1,f0:3200,f1:400,type:'highpass',g:.5}); toneHit({f0:230,f1:60,type:'square',dur:.08,g:.3}); toneHit({f0:95,f1:34,type:'sine',dur:.12,g:.45}); },
  m4(){ noiseHit({dur:.07,f0:3800,f1:700,type:'highpass',g:.34}); toneHit({f0:200,f1:68,type:'square',dur:.05,g:.22}); toneHit({f0:120,f1:55,type:'sine',dur:.06,g:.25}); },
  boom(s=1){ if (!Number.isFinite(s)) s = 1;
    /* реальный подрыв: резкий «крак» детонации (2–5кГц, 45мс) → низкий удар
       корпуса (120→24Гц) → раскат → в конце тихий отзвук-эхо от домов */
    noiseHit({dur:.045,f0:5600,f1:2200,type:'highpass',g:.55*Math.min(1,s)});
    noiseHit({dur:.9,f0:520,f1:40,g:Math.min(1,.85*s)});
    toneHit({f0:120,f1:24,dur:.75,g:.65*Math.min(1,s)});
    noiseHit({dur:.5,f0:200,f1:60,g:.25,delay:.08});
    noiseHit({dur:.7,f0:140,f1:36,g:.16,delay:.3}); },
  reload(){ toneHit({f0:850,f1:600,type:'square',dur:.04,g:.2}); toneHit({f0:1100,f1:800,type:'square',dur:.04,g:.2,delay:.14}); },
  sw(){ toneHit({f0:520,f1:380,type:'triangle',dur:.06,g:.2}); },
  whoosh(){ noiseHit({dur:.13, f0:260, f1:1500, type:'bandpass', g:.11, q:1.1}); },   /* v30: свист кулака */
  punch(){ noiseHit({dur:.06, f0:300, f1:90, g:.34}); toneHit({f0:150, f1:62, type:'sine', dur:.07, g:.3}); },   /* v30: глухой удар */
  hit(){ toneHit({f0:1400,f1:900,type:'square',dur:.03,g:.12}); },
  empty(){ toneHit({f0:1800,f1:1200,type:'square',dur:.02,g:.08}); },
  death(){ toneHit({f0:200,f1:30,type:'sawtooth',dur:1.2,g:.4}); noiseHit({dur:.8,f0:400,f1:40,g:.3}); }
};
window.addEventListener('pointerdown', audioInit);

/* ---------- рендер, сцена, свет ---------- */
let renderer;
try { renderer = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: 'high-performance' }); }
catch(e){ $('loadText').textContent = 'WebGL недоступен'; throw e; }
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.18;
renderer.shadowMap.enabled = settings.shadows; renderer.shadowMap.type = THREE.PCFSoftShadowMap;
/* ОПТИМИЗАЦИЯ ТЕНЕЙ: карта теней перерисовывается ТОЛЬКО когда что-то
   реально движется (живые NPC, бодрые обломки/трупы, гранаты, переноска)
   или солнце/луна уползли (≥0.25с) — И не чаще 30 раз/сек (половина кадров
   не платит за весь второй рендер сцены; лаг тени ≤33мс глазом не виден).
   Управление — shadowTick() в игровом цикле. */
renderer.shadowMap.autoUpdate = false;
let gAwakeClusters = 0, gAwakeDebris = 0;   /* счётчики бодрых тел для shadowTick */
const scene = new THREE.Scene();
const skyColor = new THREE.Color(0x9bc7e8);
