    o.material.clippingPlanes = [headClipPlane];         /* основной рендер: голова отсекается плоскостью */
    /* clipShadows = false (дефолт) → тень головы НЕ отсекается */
  });
  /* v17: ГОЛОВА и ШЕЯ теперь ВИДИМЫ (заявка игрока — «поворачиваюсь головой,
     тело поворачивается только за анатомическим пределом»). Изнутри головы
     все её поверхности — backface (FrontSide-материалы) и не рендерятся:
     из «собственных глаз» лицо/волосы не видны и обзор не перекрывают, но
     снаружи голова живёт: следит за камерой, гнётся шея, моргает, тень
     полная. Голова вращается вокруг своей оси (центр головы = якорь камеры),
     поэтому позиция камеры не дёргается. */
  turnReset();   /* v17: тело встаёт по текущему взгляду */
  adsW = 0; setAim(false);   /* v22: прицел сбрасывается при пересборке тела */
  /* v16→v27: кисть правой руки — якорь ПОЗИЦИИ для гранаты/тюнера; само
     оружие (Глок/граната/M4) живёт НЕПОСРЕДСТВЕННО В СЦЕНЕ — вне
     масштабированного тела: weaponLockUpdate ставит ему МИР-трансформу
     ТОЧНО по камере (без shear от масштаба роста), граната — от кисти. */
  if (!handAnchor) handAnchor = new THREE.Group();
  handAnchor.position.set(0, -.27, 0);
  bodyRoot.userData.forearmR.add(handAnchor);
  /* v30: КУЛАКИ — накладки на кисти (в цвет кожи игрока из ud.skinC) */
  if (bodyRoot.userData.skinC) FIST_MAT.color.copy(bodyRoot.userData.skinC);
  bodyRoot.userData.forearmR.add(fistR);
  bodyRoot.userData.forearmL.add(fistL);
  scene.add(tpPistol, tpGren, tpM4);
  tpSyncVis();
  scene.add(bodyRoot);
  bodyAnim.ph = Math.random() * Math.PI * 2;
  bodyAnim.amp = 0; bodyAnim.runF = 0; bodyAnim.air = 0;
  wpBlend = 0;
  setRun(false);
  playerBodyAnim(0);
}
function playerBodyRemove(){
  if (!bodyRoot) return;
  wpDetach();   /* v16: оружие — общий ресурс, не отдавать его в dispose тела */
  scene.remove(bodyRoot); disposeModel(bodyRoot); bodyRoot = null;
  turnReset();   /* v17: сброс поворота тела (для следующей игры) */
}

/* --- анимация тела: формулы жителей (npcUpdate), без осматривания головы --- */
function playerBodyAnim(dt){
  if (!bodyRoot) return;
  const ud = bodyRoot.userData;
  const speed = player.speed;
  /* фазы/амплитуды — как у NPC: два ритма (шаг/бег) блендятся через runF */
  const runTgt = player.sprinting ? 1 : 0;
  bodyAnim.runF += (runTgt - bodyAnim.runF) * Math.min(1, 6*dt);
  const runF = bodyAnim.runF;
  const cr = player.crouchT;   /* v21: присед — СТАГГЕР-СТОЙКА делают НОГИ (левая вперёд/правая
     назад, обе ступни на земле — опускание корня по фактическим углам),
     а не симметричный «сквот на воздухе»; торс почти прямой с лёгким
     наклоном — тактический присед выше и атлетичнее, оружие на цели */
  const cadW = 2.0 + speed*3.2, cadR = 2.0 + speed*1.64;
  bodyAnim.ph += dt * (cadW*(1-runF) + cadR*runF) * (1 + .12*cr);   /* v20: в приседе шаги короче — каденция чуть выше */
  const ampT = speed > .35 ? Math.min(1, speed/1.7) : 0;
  bodyAnim.amp += (ampT - bodyAnim.amp) * Math.min(1, 8*dt);
  const amp = bodyAnim.amp;
  bodyAnim.air += ((player.onGround ? 0 : 1) - bodyAnim.air) * Math.min(1, ((player.vel.y||0) > 0 ? 15 : 8)*dt);   /* v21: в взлёт — снап в прыжковую позу быстрее (15/с), в падении мягче */
  const air = bodyAnim.air;
  const ph = bodyAnim.ph, seed = BODY_SEED;
  const dyw = turnUpdate(dt);  /* v17: голова-отдельно-от-тела (см. turnUpdate) */
  grenLungeW = 0;   /* v21.1: сброс веса выпада (установится в машине гранаты ниже) */
  /* ---- v21: НОГИ — КУДА ИДЁМ, ПЛЕЧИ — КУДА ЦЕЛИМСЯ (как в больших играх):
     при стрейфе/движении не по взгляду бедра доворачиваются к направлению
     движения (до ±33°, плавно), торс/голова/оружие остаются на прицеле.
     При ходе строго назад — плавно гасим (ноги остаются вперёд, шаг спиной). ---- */
  let legYawT = 0;
  if (player.onGround && speed > .9) {
    const la = wrapAng(Math.atan2(-player.vel.x, -player.vel.z) - ((bodyYaw === null) ? player.yaw : bodyYaw));
    const back = Math.max(0, Math.abs(la) - Math.PI/2) / (Math.PI/2);
    legYawT = THREE.MathUtils.clamp(la, -.58, .58) * (1 - back) * Math.min(1, (speed - .9)/1.1);
  }
  legYawSm += (legYawT - legYawSm) * Math.min(1, 9*dt);
  ud.legL.rotation.y = ud.legR.rotation.y = legYawSm;
  /* ---- v20: ПРЫЖОК/ПАДЕНИЕ — поза зависит от ВЕРТИКАЛЬНОЙ СКОРОСТИ.
     Взлёт (rf→1): переднее колено ДРАЙВом вверх (поджато), задняя согнута,
     корпус заметно вперёд — читается толчок; Падение (rf→0): передняя нога
     ТЯНЕТСЯ вниз-вперёд (почти прямая — готова встретить землю), задняя
     волочится сзади СИЛЬНО согнутая, корпус лёгкий прогиб назад, —
     силуэт «полёта», а не нейтральной стойки (vision-ревью v20-1).
     Приземление — squash по силе удара (land). ---- */
  const vv = THREE.MathUtils.clamp((player.vel.y || 0)/8, -1, 1);
  const rf = (vv + 1) * .5;
  if (player.onGround && !bodyAnim.wasG && air > .35)
    bodyAnim.land = Math.min(1, .25 + Math.abs(bodyAnim.vy)/11);
  bodyAnim.wasG = player.onGround; bodyAnim.vy = player.vel.y || 0;
  bodyAnim.land *= Math.exp(-7.5*dt);
  const land = bodyAnim.land * (1 - .5*cr);
  /* ---- НОГИ: мах бедра + сгиб колена в переносе (как у жителей) ---- */
  const asym = .93 + .14 * ((seed*7.13) % 1);
  const hipAmp = (.44 + .30*runF) * amp * asym * (1 - .46*cr + .24*cr*runF);   /* v21.4: присед-ШАГ ещё короче (стаггер держим), присед-БЕГ (runF) — шире, «скэмпер» */
  const hipL = Math.sin(ph) * hipAmp;
  const hipR = Math.sin(ph + Math.PI) * hipAmp;
  const kneeAmp = (.85 + .55*runF) * amp * (1 - .22*cr + .08*cr*runF);   /* v21.4: присед-ходьба — колено маховой ЗДЕСЬ гнётся почти как в шаге (.78): нога не «палка»; присед-БЕГ — сдержаннее, пятка не бьёт по ягодице */
  const kneePh = .35 - .28*runF;
  const kneeL = -Math.max(0, Math.cos(ph - kneePh)) * kneeAmp;
  const kneeR = -Math.max(0, Math.cos(ph - kneePh + Math.PI)) * kneeAmp;
  /* ---- v21.4: НОГИ В ПРИСЕДЕ — «ТАКТИЧЕСКИЙ ПРИСЕД СО СТАГГЕРОМ»
     (заявка «нормальный присед как в хороших играх, одна нога вперёд-
     другая назад; можно чуть выше»): передняя (левая) — бедро вперёд .92
     (53°), колено 82° — колено над носками, СТОПА ПЛОСКО (голеностоп
     компенсирует наклон голени); задняя — бедро назад .34 (19°), колено 68°
     («пружина», не костыль — vision-ревью), голень назад 58°, пятка ЯВНО
     поднята (компенсация 55% — носок в упоре). Таз ниже на .24м, торс
     вперёд на 19° — вес в стойке, силуэт боевого оператора. ---- */
  const apexF = air * (1 - Math.abs(2*rf - 1));   /* v21: пик дуги — поджатый «флоат» (v21.1: усилено по vision-ревью) */
  const rfq = Math.pow(Math.max(0, rf), 1.5);   /* v21.1: кривая rf^1.5 — взлётная фаза резче: колено-драйв ударно, падение мягко (vision: «бег в воздухе» → настоящий толчок) */
  ud.legL.rotation.x = hipL*(1-air) + (.34 + .61*rfq)*air + .92*cr + .45*land + .16*apexF;
  ud.legR.rotation.x = hipR*(1-air) + (-.62 + .24*rfq)*air - .34*cr + .18*land - .10*apexF;
  ud.shinL.rotation.x = kneeL*(1-air) + (-.14 - 1.16*rfq)*air - 1.44*cr - .75*land - .22*apexF;
  ud.shinR.rotation.x = kneeR*(1-air) + (-.95 + .70*rfq)*air - .68*cr - .30*land - .18*apexF;
  /* ---- ТОРС: противовращение плеч, крен, наклон вперёд, дыхание ---- */
  const breathe = Math.sin(timeNow*1.7 + seed) * .5 + .5;
  ud.torso.position.y = .92 + Math.abs(Math.cos(ph))*(.012 + .01*runF)*amp + breathe*.010*(1-amp*.6) - .04*cr - .085*land;
  ud.torso.rotation.y = -Math.sin(ph) * (.07 + .055*runF) * amp;
  ud.torso.rotation.z = Math.sin(ph) * (.032 + .02*runF) * amp + Math.sin(timeNow*.5 + seed) * .022 * (1-amp)
                      + Math.sin(ph) * .05 * cr * amp;   /* v20: присед-ходьба «утиный шаг» — таз качается со шагом */
  ud.torso.rotation.x = -.012 - .055*amp*(1-runF)*Math.min(1, speed/1.6)
                      - (.07 + .095*Math.min(1, speed/5))*runF*amp
                      + breathe*.006*(1-amp) - .34*cr + .20*land
                      - .12*cr*runF*amp
                      + .16*air*rf - .12*air*(1-rf) + .12*apexF;   /* v21.4: присед -.34 (19° вперёд) — вес над передней стопой; прыжок как в v20 (одобрено) +.12apexF — прогиб «парения» на пике */
  /* ---- РУКИ: противофаза к ногам, локти дышат в беге, в простое лёгкое покачивание ---- */
  const shAmp = (.42 + .22*runF) * amp;
  const shL = -Math.sin(ph) * shAmp, shR = Math.sin(ph) * shAmp;
  const elbSwL = Math.max(0, -Math.cos(ph)) * (.55 - .3*runF) * amp;
  const elbSwR = Math.max(0,  Math.cos(ph)) * (.55 - .3*runF) * amp;
  const elbPose = (.12 + 1.25*runF) * amp;
  const idleSway = Math.sin(timeNow*1.7 + seed) * .02 * (1-amp);
  ud.armL.rotation.x = shL*(1-air) + (-.45*rf + .15*(1-rf))*air + idleSway + .30*cr;
  ud.armR.rotation.x = shR*(1-air) + (-.35*rf + .10*(1-rf))*air - idleSway + .30*cr;
  ud.armL.rotation.z = -.095*(1 - .3*runF*amp) - Math.max(0, -Math.sin(ph))*.05*runF*amp - (.30 + .30*(1-rf))*air + .20*cr;
  ud.armR.rotation.z = .095*(1 - .3*runF*amp) + Math.max(0,  Math.sin(ph))*.05*runF*amp + (.30 + .30*(1-rf))*air - .20*cr;
  ud.forearmL.rotation.x = (elbSwL + elbPose)*(1-air) + .05*(1-amp) + .30*air + .45*cr;
  ud.forearmR.rotation.x = (elbSwR + elbPose)*(1-air) + .05*(1-amp) + .20*air + .45*cr;
  /* ---- v16→v17: ОРУЖИЕ В РУКЕ — двуручные живые хваты + машина гранаты ---- */
  const wpTgt = (state === 'playing' && !playerDead) ? 1 : 0;   /* v30: в свободной камере игрок ПРОДОЛЖАЕТ ДЕРЖАТЬ оружие (поза не падает) */
  wpBlend += (wpTgt - wpBlend) * Math.min(1, 7*dt);
  if (wpBlend > .004) {
    const P = WP_POSE[cur] || WP_POSE[0];
    const b = wpBlend;
    /* v22: ПРИЦЕЛИВАНИЕ — поза плавно уходит к ADS_POSE: оружие подтянуто
       к лицу, камера зумит (composeCamera), ствол/прицел жёстко стоят на луче
       камеры (v27: weaponLockUpdate — и от бедра, и в прицеле).
       Граната не прицеливается. adsW сходится ~0.25с. */
    const adsOn = (cur === 0 || cur === 2) && aimHeld && !playerDead && switchT <= 0;
    adsW += ((adsOn ? 1 : 0) - adsW) * Math.min(1, 11*dt);
    if (cur === 1) adsW = Math.min(adsW, .001);   /* граната — без прицела */
    const AP = ADS_POSE[cur];
    const pm = k => (AP && (cur === 0 || cur === 2)) ? P[k] + (AP[k] - P[k])*adsW : P[k];
    /* v28: НАКЛОН РУК СИНХРОНЕН ОРУЖИЮ — базовая поза рук следует за
       СГЛАЖЕННЫМ наклоном ствола (wpPitchSm считает weaponLockUpdate из
       фактической позы оружия): руки и оружие поворачиваются как единое
       целое — без рывков и «отрыва» кистей на крутом взгляде вверх/вниз.
       Граната — по-прежнему за взглядом с малым фактором (камерой не лочится). */
    const pf = (cur === 1 || cur === 3)
      ? THREE.MathUtils.clamp(player.pitch, -1.05, 1.05) * (P.pf || .15)   /* v30: кулаки — тоже за взглядом напрямую (лока оружия нет) */
      : THREE.MathUtils.clamp(wpPitchSm, -1.25, 1.25) * pm('pf');
    /* v18 (заявка «руки трясутся на ходу»): прежний sway бил в руки с ЧАСТОТОЙ
       2 ШАГА (ph*2, ~1.7Гц) — читалось как дрожь, и целиком транслировался в
       ствол (компенсация бралась от табличной позы). Теперь: темп = один шаг
       (вдвое медленнее), амплитуда меньше, и ствол компенсирует его сам (ниже) —
       «дышат» только руки, оружие стоит на цели.
       v22: в прицеле sway гасим на 75% — прицел стабилен. */
    const sway = Math.sin(ph) * (.008 + .005*runF) * amp * (1 - .75*adsW);   /* v19: ещё на треть тише — руки «дышат» едва заметно, оружие стоит как влитое */
    let Rx = pm('aRx') + pf + sway - .12*air + (.34 + .12*runF*amp)*cr + recoil*.11*(1 - .35*adsW);   /* v21.4: торс в приседе подан вперёд на .34 (+.12 в присед-БЕГЕ) — руки компенсируют ровно, хват как в стойке */
    let Fx = pm('fRx') - .10*cr + recoil*.08*(1 - .35*adsW);
    let Rz = pm('aRz');
    let Lx = pm('aLx') + pf + sway - .08*air + (.34 + .12*runF*amp)*cr;   /* v18: pf без .85 — левая следует за взглядом как правая */
    let Lz = pm('aLz');
    let Lf = pm('fLx') - .10*cr;
    let ay = P.aRy || 0, ayl = P.aLy || 0;   /* v30: скрутка плеч (граната держит кисть у центра, кулаки — гард к лицу) */
    /* v27: доводка рысканья удалена (замена — weaponLockUpdate после
       composeCamera): ствол и прицел жёстко стоят по камере */
    grenTwistW = 0;   /* v23: сброс каждый кадр — гасим стабилизацию плеч только в СИЛЬНОМ броске */
    grenActW = 0;     /* v30.1: сброс активности броска (ИК держания включится в покое) */
    /* v18 (заявка юзера): при взгляде вниз/вверх с Глоком/M4 руки НЕ разводятся —
       стоят на оружии ровно как в стойке (ствол следует за взглядом через pf).
       Блок «spread» из v17 удалён по прямому запросу: «стояли также на оружии
       как и в стойке ровно и вверх также — это не меняй». */
    /* ---- ГРАНАТА v21 (заявка «не сверху-вниз — а со всей дури ВПЕРЁД,
       анатомически правильно»): ПОЯС (.22с) → ВЗВОД НАЗАД-ВВЕРХ (глубина =
       заряд — живой индикатор силы без UI: чем дольше жмёшь, тем дальше рука
       уходит к уху) → ХЛЫСТ ПРЯМО ВПЕРЁД (разгон ease-in t^1.6 — «со всей
       дури»: плечо сзади→нейтраль→вперёд-вверх, локоть взрывается в прямую)
       → фиксация → возврат. Отрыв tt=.40 — рука вытянута, кисть на высоте
       плеча ВПЕРЕДИ. Отмена — рука возвращается по размотке grenWindT. ---- */
    if (cur === 1) {
      const sm = t => t*t*(3-2*t);
      /* v18-фикс: clamp 0..1 перед sm() — полином t²(3-2t) БЕЗ клампа при
         t>1 даёт отрицательный мусор (t до 3.5 при tt→1): руку ВЗРЫВАЛО
         на ~0.1с после каждого броска (баг v17, aR доходил до 34 рад!). */
      const smc = t => sm(Math.min(1, Math.max(0, t)));
      let ws = 0, cv = 0, ck = 0, ex = 0, st = 0, ov = 0;
      if (grenHold || grenThrowT <= 0) {
        /* удержание/размотка: пояс .22с, дальше — плавная ЗАРЯДКА к взводу
           (рука поднимается назад тем глубже, чем дольше зажато — индикатор) */
        ws = sm(Math.min(grenWindT, .22)/.22);
        cv = smc((grenWindT - .22)/(GREN_CHARGE_T - .22));
      }
      /* v22: МИКС СИЛЫ БРОСКА — слабый ходит по СТАРЫМ одобренным целям
         (COCK_G/EXT_G — «взвод у уха → хлыст вперёд»), сильный — по НОВЫМ
         «ударным» (COCK_G2/EXT_G2 — кисть высоко ЗА ГОЛОВОЙ → пронзающий
         удар ПРЯМО ВПЕРЁД чуть выше плеча, «как удар кулаком, только
         размах больше»). Пока ДЕРЖИШЬ — микс = глубине зарядки cv (рука
         живьём уходит всё выше — живой индикатор силы без UI); в БРОСКЕ —
         микс замораживается от фактической силы grenWsRel. Середина
         диапазона блендится — скачков нет. */
      const pwMix = grenHold ? cv : smc((grenWsRel - .25)/.45);
      const g2 = pwMix;   /* вес «вложился всем телом» — амплитуда корпуса/выпада */
      grenTwistW = g2;   /* v23: сильный бросок — плечи стрелка «расстёгнуты», скрутка корпуса работает в полную силу (см. стабилизацию ниже) */
      const COCK = pwMix > 0 ? {
        aRx: COCK_G.aRx + (COCK_G2.aRx - COCK_G.aRx)*pwMix,
        aRz: COCK_G.aRz + (COCK_G2.aRz - COCK_G.aRz)*pwMix,
        fRx: COCK_G.fRx + (COCK_G2.fRx - COCK_G.fRx)*pwMix } : COCK_G;
      const EXT = pwMix > 0 ? {
        aRx: EXT_G.aRx + (EXT_G2.aRx - EXT_G.aRx)*pwMix,
        aRz: EXT_G.aRz + (EXT_G2.aRz - EXT_G.aRz)*pwMix,
        fRx: EXT_G.fRx + (EXT_G2.fRx - EXT_G.fRx)*pwMix } : EXT_G;
      if (grenThrowT > 0 || grenDbgTt >= 0) {
        const tt = (grenDbgTt >= 0) ? grenDbgTt : 1 - grenThrowT/GREN_SWING;
        /* v21 фазы: 0…0.17 досвод до ПОЛНОГО взвода (даже с тапа — короткий
           бросок всё равно начинается с полного замаха, просто он короче по
           времени), 0.17…0.42 ХЛЫСТ ВПЕРЁД (разгон), 0.42…0.60 фиксация,
           далее возврат к ношению. Отрыв — tt=.40 (конец разгона).
           v22: у сильного броска разгон ЕЩЁ резче (показатель 1.6→2.15) —
           хлыст читается как УДАР: разгон медленный, финал взрывной. */
        if (tt < .17)      { ck = smc(tt/.17); ws = Math.max(ws, 1-ck); cv = Math.max(cv, 1-ck); }
        else if (tt < .42) { ck = 1; ex = Math.pow(smc((tt-.17)/.25), 1.6 + .55*pwMix); }
        else if (tt < .60) { ck = 1; ex = 1; ov = smc((tt-.42)/.15); }   /* v23: ПРОВОДКА — рука после отрыва не висит мёртво, а ОСЕДАЕТ вниз-вперёд по инерции (торможение после удара), к tt=.57 уже на месте */
